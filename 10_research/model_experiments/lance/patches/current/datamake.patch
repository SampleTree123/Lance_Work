+# Copyright (c) 2025 ByteDance Ltd. and/or its affiliates.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# coding: utf-8
+
+"""Drive a multi-turn multimodal conversation end to end.
+
+The engine loads the Lance stack once (via :func:`inference_lance.build_lance_model`),
+then for every user turn that carries an action it:
+
+1. builds the packed inputs for the whole conversation so far,
+2. calls the matching ``Lance`` validation method (visual or text),
+3. decodes + saves the output, and
+4. appends the produced output back into the conversation so it becomes context
+   for subsequent turns.
+"""
+
+from __future__ import annotations
+
+import os
+import os.path as osp
+from typing import Any, Dict, Optional
+
+import torch
+
+from common.utils.misc import tuple_mul
+from common.val.utils import decode_video_tensor, make_padded_latent
+from config.config_factory import DataArguments, InferenceArguments, ModelArguments
+from data.dataset_base import DataConfig, simple_custom_collate
+from inference_lance import build_lance_model, clean_memory, normalize_understanding_answer
+
+from .conversation import Conversation, ROLE_USER, TurnAction
+from .sequence_builder import MultiTurnSequenceBuilder
+
+# Max number of generated text tokens per understanding/chat turn.
+_MAX_TEXT_TOKENS = 256
+
+
+class MultiTurnChatEngine:
+    def __init__(
+        self,
+        model_args: ModelArguments,
+        data_args: DataArguments,
+        inference_args: InferenceArguments,
+        device: int = 0,
+        log=print,
+    ):
+        self.model_args = model_args
+        self.data_args = data_args
+        self.inference_args = inference_args
+        self.device = device
+        self.log = log
+
+        # Validation noise seed mirrors the single-turn inference entry point.
+        inference_args.validation_noise_seed = inference_args.validation_data_seed
+
+        (
+            self.model,
+            self.tokenizer,
+            self.vae_model,
+            self.vae_config,
+            self.new_token_ids,
+            self.image_token_id,
+        ) = build_lance_model(model_args, data_args, inference_args, device, log=log)
+
+        self.dataset_config = self._build_dataset_config()
+        self.builder = MultiTurnSequenceBuilder(
+            tokenizer=self.tokenizer,
+            data_args=data_args,
+            model_args=model_args,
+            training_args=inference_args,
+            new_token_ids=self.new_token_ids,
+            dataset_config=self.dataset_config,
+        )
+
+    # ------------------------------------------------------------------
+    # Setup
+    # ------------------------------------------------------------------
+    def _build_dataset_config(self) -> DataConfig:
+        """Replicate the in-place dataset config from ``inference_lance.main``."""
+        model_args, inference_args = self.model_args, self.inference_args
+        dataset_config = DataConfig()
+
+        if inference_args.visual_und:
+            dataset_config.vit_patch_size = model_args.vit_patch_size
+            dataset_config.vit_patch_size_temporal = model_args.vit_patch_size_temporal
+            dataset_config.vit_max_num_patch_per_side = model_args.vit_max_num_patch_per_side
+        if inference_args.visual_gen:
+            if len(model_args.latent_patch_size) != 3:
+                raise ValueError(
+                    f"latent_patch_size must have length 3, got {model_args.latent_patch_size!r}"
+                )
+            vae_downsample = tuple_mul(
+                model_args.latent_patch_size,
+                (
+                    self.vae_config.downsample_temporal,
+                    self.vae_config.downsample_spatial,
+                    self.vae_config.downsample_spatial,
+                ),
+            )
+            dataset_config.latent_patch_size = model_args.latent_patch_size
+            dataset_config.vae_downsample = vae_downsample
+            dataset_config.max_latent_size = model_args.max_latent_size
+            dataset_config.max_num_frames = model_args.max_num_frames
+
+        dataset_config.text_cond_dropout_prob = model_args.text_cond_dropout_prob
+        dataset_config.vae_cond_dropout_prob = model_args.vae_cond_dropout_prob
+        dataset_config.vit_cond_dropout_prob = model_args.vit_cond_dropout_prob
+
+        dataset_config.num_frames = inference_args.num_frames
+        dataset_config.H = inference_args.video_height
+        dataset_config.W = inference_args.video_width
+        dataset_config.task = inference_args.task
+        dataset_config.resolution = inference_args.resolution
+        # Multi-turn conversation always uses the Qwen-VL chat template.
+        dataset_config.text_template = True
+        dataset_config.enhance_prompt = False
+        return dataset_config
+
+    # ------------------------------------------------------------------
+    # Conversation loop
+    # ------------------------------------------------------------------
+    def run_conversation(self, conversation: Conversation, save_dir: str) -> Conversation:
+        """Replay the conversation in order, interleaving generated responses.
+
+        Input turns are consumed one at a time into a running conversation. When a
+        user turn declares an action, the assistant response is generated using the
+        running conversation (so it sees all prior turns and prior responses in
+        their correct positions) and appended immediately, keeping a well-formed
+        user/assistant ordering for subsequent turns.
+        """
+        os.makedirs(save_dir, exist_ok=True)
+        input_turns = list(conversation.turns)
+        built = Conversation(turns=[], system_prompt=conversation.system_prompt)
+
+        turn_no = 0
+        for turn in input_turns:
+            built.append(turn)
+            if turn.role == ROLE_USER and turn.action is not None:
+                self.log(f"[turn {turn_no}] action={turn.action.value}")
+                self.generate_turn(built, len(built.turns) - 1, save_dir, turn_no)
+                turn_no += 1
+
+        # Reflect the fully built (interleaved) conversation back to the caller.
+        conversation.turns = built.turns
+        return conversation
+
+    def generate_turn(
+        self, conversation: Conversation, target_user_idx: int, save_dir: str, turn_no: int
+    ) -> str:
+        action = conversation.turns[target_user_idx].action
+        sample = self.builder.build(conversation, target_user_idx)
+        batch = simple_custom_collate([sample])
+        val_data = batch.cuda(self.device).to_dict()
+
+        if action.is_text_output:
+            text = self._run_text(val_data)
+            self.log(f"[turn {turn_no}] -> text: {text}")
+            conversation.add_assistant_text(text, meta={"turn_no": turn_no})
+            clean_memory(val_data)
+            return text
+
+        path = self._run_visual(val_data, action, save_dir, turn_no)
+        self.log(f"[turn {turn_no}] -> {action.target_modality}: {path}")
+        conversation.add_assistant_visual(path, action.target_modality, meta={"turn_no": turn_no})
+        clean_memory(val_data)
+        return path
+
+    # ------------------------------------------------------------------
+    # Model calls (mirror inference_lance.validate_on_fixed_batch)
+    # ------------------------------------------------------------------
+    def _run_visual(
+        self, val_data: Dict[str, Any], action: TurnAction, save_dir: str, turn_no: int
+    ) -> str:
+        model = self.model.to(device=self.device, dtype=torch.bfloat16)
+        inference_args = self.inference_args
+        model_args = self.model_args
+
+        with torch.no_grad(), torch.amp.autocast("cuda", enabled=True, dtype=torch.bfloat16):
+            val_data["padded_latent"] = make_padded_latent(
+                val_data["padded_videos"], val_data["vae_data_mode"], self.vae_model
+            )
+            save_fps = int(val_data.get("save_fps", 12))
+            params = {
+                "val_packed_text_ids": val_data["packed_text_ids"],
+                "val_packed_text_indexes": val_data["packed_text_indexes"],
+                "val_sample_lens": val_data["sample_lens"],
+                "val_packed_position_ids": val_data["packed_position_ids"],
+                "val_split_lens": val_data["split_lens"],
+                "val_attn_modes": val_data["attn_modes"],
+                "val_sample_N_target": val_data["sample_N_target"],
+                "val_packed_vae_token_indexes": val_data["packed_vae_token_indexes"],
+                "timestep_shift": inference_args.validation_timestep_shift,
+                "num_timesteps": inference_args.validation_num_timesteps,
+                "val_mse_loss_indexes": val_data.get("mse_loss_indexes", None),
+                "val_padded_latent": val_data["padded_latent"],
+                "video_sizes": val_data["video_sizes"],
+                "cfg_text_scale": model_args.cfg_text_scale,
+                "cfg_vit_scale": model_args.cfg_vit_scale,
+                "cfg_interval": inference_args.cfg_interval,
+                "cfg_renorm_min": inference_args.cfg_renorm_min,
+                "cfg_renorm_type": inference_args.cfg_renorm_type,
+                "device": self.device,
+                "dtype": torch.bfloat16,
+                "new_token_ids": self.new_token_ids,
+                "max_samples": inference_args.validation_max_samples,
+                "validation_noise_seed": inference_args.validation_noise_seed,
+                "apply_chat_template": inference_args.apply_chat_template,
+                "apply_qwen_2_5_vl_pos_emb": inference_args.apply_qwen_2_5_vl_pos_emb,
+                "image_token_id": self.image_token_id,
+                "val_packed_vit_token_indexes": val_data.get("packed_vit_token_indexes", None),
+                "val_packed_vit_tokens": val_data.get("packed_vit_tokens", None),
+                "vit_video_grid_thw": val_data.get("vit_video_grid_thw", None),
+                "vae_video_grid_thw": val_data["vae_video_grid_thw"],
+                "video_grid_thw": val_data.get("video_grid_thw", None),
+                "caption": val_data.get("caption", None),
+                "sample_task": val_data["sample_task"],
+                "sample_modality": val_data["sample_modality"],
+                "cfg_type": inference_args.cfg_type,
+                "cfg_uncond_token_id": inference_args.cfg_uncond_token_id,
+                "index": val_data["index"],
+                "val_padded_videos": None,
+            }
+            if inference_args.use_KVcache:
+                denoise_latent, _captions, _padded_videos, _index = model.validation_gen_KVcache(**params)
+            else:
+                denoise_latent, _captions, _padded_videos, _index = model.validation_gen(**params)
+
+            if len(denoise_latent) == 0:
+                raise RuntimeError("validation_gen returned no latents for the visual turn")
+
+            # One sample, one target: the final patch entry is the generated target
+            # (earlier entries, if any, are clean condition reconstructions).
+            latent = denoise_latent[0]
+            target_latents = [latent[-1]]
+            v_list = [self.vae_model.vae_decode([latent_])[0] for latent_ in target_latents]
+
+            save_item_name = f"turn{turn_no:02d}"
+            v_thwc = decode_video_tensor(
+                v_list,
+                save_path=save_dir,
+                save_half=False,
+                save_item_name=save_item_name,
+                save_fps=save_fps,
+            )
+            ext = "mp4" if v_thwc.shape[0] > 1 else "png"
+            out_path = osp.join(save_dir, f"{save_item_name}.{ext}")
+
+        clean_memory()
+        return out_path
+
+    def _run_text(self, val_data: Dict[str, Any]) -> str:
+        model = self.model.to(device=self.device, dtype=torch.bfloat16)
+        inference_args = self.inference_args
+
+        with torch.no_grad(), torch.amp.autocast("cuda", enabled=True, dtype=torch.bfloat16):
+            params = {
+                "val_packed_text_ids": val_data["packed_text_ids"],
+                "val_packed_text_indexes": val_data["packed_text_indexes"],
+                "val_packed_position_ids": val_data["packed_position_ids"],
+                "val_sample_N_target": val_data["sample_N_target"],
+                "val_split_lens": val_data["split_lens"],
+                "val_attn_modes": val_data["attn_modes"],
+                "val_sample_lens": val_data["sample_lens"],
+                "val_sample_type": val_data["sample_type"],
+                "val_packed_vit_tokens": val_data["packed_vit_tokens"],
+                "val_vit_video_grid_thw": val_data["vit_video_grid_thw"],
+                "val_ce_loss_indexes": val_data["ce_loss_indexes"],
+                "max_samples": inference_args.validation_max_samples,
+                "max_length": _MAX_TEXT_TOKENS,
+                "device": self.device,
+                "dtype": torch.bfloat16,
+                "new_token_ids": self.new_token_ids,
+                "pad_token_id": self.tokenizer.pad_token_id,
+                "vocab_size": len(self.tokenizer),
+                "caption": val_data.get("caption_cn", None),
+                "tokenizer": self.tokenizer,
+                "apply_chat_template": inference_args.apply_chat_template,
+                "apply_qwen_2_5_vl_pos_emb": inference_args.apply_qwen_2_5_vl_pos_emb,
+                "do_sample": False,
+                "image_token_id": self.image_token_id,
+                "index": val_data["index"],
+            }
+            if inference_args.use_KVcache:
+                generated_sequence_all, _captions, _index = model.validation_und_KVcache(**params)
+            else:
+                generated_sequence_all, _captions, _index = model.validation_video_to_text(**params)
+
+            if len(generated_sequence_all) == 0:
+                raise RuntimeError("validation_video_to_text returned no sequences for the text turn")
+            generated_sequence = generated_sequence_all[0]
+            text = self.tokenizer.decode(generated_sequence[:, 0])
+
+        clean_memory()
+        return normalize_understanding_answer(text)
