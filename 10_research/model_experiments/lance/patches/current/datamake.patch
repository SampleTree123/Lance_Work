@@ -0,0 +1,124 @@
+"""CPU preparation and detached in-memory history for whole-chain DDP windows."""
+from contextlib import contextmanager
+
+import torch
+from torch.utils.data import Dataset
+
+from data.dataset_base_train import simple_custom_collate
+from data.datasets_factory import datamake_online_rollout_turn as online
+from train.datamake_prefix_data import preprocessing_rng
+from train.datamake_chain_window_schedule import turn_seed
+
+
+def pack_sample(packer, sample):
+    if sample is None:
+        raise RuntimeError("Chain sample could not be decoded")
+    if sample["num_tokens"] + 2 * len(sample["sequence_plan"]) > packer.max_num_tokens_per_sample:
+        raise ValueError("Chain turn exceeds sample token budget")
+    status = packer.pack_sequence(sample, packer.set_sequence_status())
+    if status["curr"] > packer.max_num_tokens:
+        raise ValueError("Chain turn exceeds packed token budget")
+    packed = packer.to_tensor(status)
+    packed["batch_data_indexes"] = [sample["data_indexes"]]
+    return packed
+
+
+class ChainWindowDataset(Dataset):
+    def __init__(self, packer, chains, windows, seed, rank):
+        self.packer, self.source = packer, packer.grouped_datasets[0]
+        self.chains, self.windows, self.seed, self.rank = chains, windows, seed, rank
+
+    def __len__(self):
+        return len(self.windows)
+
+    def __getitem__(self, step):
+        units, total_tokens, targets = [], 0, 0
+        for epoch, index in self.windows[step][self.rank]:
+            chain = self.chains[index]
+            longest = chain["records"][-1]["row"]
+            if longest["dataset_origin"] == "coinve":
+                record = chain["records"][0]
+                seed = turn_seed(self.seed, epoch, chain["chain_id"], 1, 0)
+                with preprocessing_rng(seed):
+                    sample = self.source._process_row(record["row"], 0, 0, record["row_index"], 0, record["path"])
+                    packed = pack_sample(self.packer, sample)
+                counts = [len(packed["mse_loss_indexes"])]
+                units.append(dict(epoch=epoch, chain_index=index, packed=packed, counts=counts))
+            else:
+                # Decode each original video once. Keep exact FP32 GT preprocessing;
+                # these CPU tensors are shared by worker IPC, never sent to a GPU here.
+                cache, media, counts = {}, {}, []
+                paths = longest["video_paths"]
+                with preprocessing_rng(turn_seed(self.seed, epoch, chain["chain_id"], 0, 0)):
+                    for path in paths:
+                        cache[(path, "vae_video")] = online.get_online_video_tensor(self.source, path, "vae_video", 0, media)
+                    cache[(paths[0], "vit_video")] = online.get_online_video_tensor(self.source, paths[0], "vit_video", 0, media)
+                for record in chain["records"]:
+                    path = record["row"]["video_paths"][-1]
+                    counts.append(int(cache[(path, "vae_video")][1]))
+                units.append(dict(epoch=epoch, chain_index=index, cache=cache, counts=counts))
+            total_tokens += sum(counts)
+            targets += chain["targets"]
+        return dict(step=step, units=units, target_tokens=total_tokens, targets=targets)
+
+    def make_runtime(self, unit):
+        return ChainRuntime(self.packer, self.source, self.chains[unit["chain_index"]], unit, self.seed)
+
+
+def collate_window(batch):
+    if len(batch) != 1:
+        raise ValueError("One optimizer window per loader item")
+    return batch[0]
+
+
+class ChainRuntime:
+    def __init__(self, packer, source, chain, unit, seed):
+        self.packer, self.source, self.chain, self.unit, self.seed = packer, source, chain, unit, seed
+        self.histories, self.generated_cache = [], {}
+
+    @contextmanager
+    def cached_video_reader(self):
+        original = online.get_online_video_tensor
+
+        def get(dataset, value, stream, worker, media):
+            if isinstance(value, str):
+                result = self.unit["cache"][(value, stream)]
+            else:
+                key = (id(value), stream)
+                if key not in self.generated_cache:
+                    self.generated_cache[key] = original(dataset, value, stream, worker, media)
+                result = self.generated_cache[key]
+            dataset.vision_stream = stream
+            return result
+
+        online.get_online_video_tensor = get
+        try:
+            yield
+        finally:
+            online.get_online_video_tensor = original
+
+    def append_history(self, video):
+        if video.requires_grad or video.grad_fn is not None or video.device.type != "cpu":
+            raise ValueError("History must be a detached CPU video")
+        self.histories.append(video)
+
+    def pack(self, ordinal):
+        record = self.chain["records"][ordinal]
+        row = record["row"]
+        k, repeat = int(row["target_round"]), int(row["sampling_repeat_index"])
+        if len(self.histories) != k - 1:
+            raise ValueError("Whole-chain history does not match the current round")
+        seed = turn_seed(self.seed, self.unit["epoch"], self.chain["chain_id"], k, repeat)
+        if "packed" in self.unit:
+            packed = self.unit["packed"]
+        else:
+            row = {**row, "video_inputs": [row["video_paths"][0], *self.histories, row["video_paths"][-1]]}
+            with preprocessing_rng(seed), self.cached_video_reader():
+                sample = online.process_online_rollout_row(self.source, row, 0, 0, record["row_index"], 0, record["path"])
+                packed = pack_sample(self.packer, sample)
+        if len(packed["mse_loss_indexes"]) != self.unit["counts"][ordinal]:
+            raise ValueError("Precomputed target token denominator differs from actual packing")
+        identity = {**packed["batch_data_indexes"][0], "epoch": self.unit["epoch"],
+                    "sampling_instance_id": record["row"]["sampling_instance_id"], "repeat": repeat}
+        packed = {**packed, "batch_data_indexes": [identity]}
+        return simple_custom_collate([packed])
