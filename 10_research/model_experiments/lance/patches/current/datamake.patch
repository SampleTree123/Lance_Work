diff --git a/data/datasets_factory/datamake_online_rollout_turn.py b/data/datasets_factory/datamake_online_rollout_turn.py
new file mode 100644
index 0000000..5a23b7b
--- /dev/null
+++ b/data/datasets_factory/datamake_online_rollout_turn.py
@@ -0,0 +1,274 @@
+# coding: utf-8
+
+"""Stage-4 in-memory turn encoding without mutating the frozen Stage-2 dataset.
+
+The regular DataMake dataset remains path-only and hash-compatible with the
+completed full-parameter runs.  This module is an explicit adapter used only
+by the online-rollout trainer: generated CTHW frames can replace historical
+paths while the row keeps its original ``video_paths`` as provenance.
+"""
+
+from __future__ import annotations
+
+import random
+from typing import Any, Dict, List, Optional
+
+from PIL import Image
+import torch
+
+from data.common import generate_system_prompt
+from data.datamake_reference_image import normalize_reference_images, append_reference_condition
+from data.system_prompt_render import render_qwenvl_prompt
+from data.datasets_factory.dataset_datamake_multiturn_v2v_local import (
+    expand_and_index_multiturn,
+)
+
+
+def _validate_online_row(dataset, row: Dict[str, Any]) -> List[Any]:
+    dataset._validate_local_row(row)
+    video_paths = row["video_paths"]
+    video_inputs = list(row.get("video_inputs", video_paths))
+    if len(video_inputs) != len(video_paths):
+        raise ValueError("video_inputs and video_paths must have equal length")
+    if not all(
+        (isinstance(value, str) and value.strip())
+        or (
+            isinstance(value, torch.Tensor)
+            and value.ndim == 4
+            and value.shape[0] == 3
+        )
+        for value in video_inputs
+    ):
+        raise ValueError("video_inputs must contain paths or in-memory CTHW tensors")
+    return video_inputs
+
+
+def get_online_video_tensor(
+    dataset,
+    value: Any,
+    vision_stream: str,
+    worker_id: int,
+    cache: Dict[str, bytes],
+):
+    """Encode a path or detached decoded tensor without an MP4 roundtrip."""
+
+    if isinstance(value, str):
+        media_bytes = dataset._read_media_bytes(value, cache)
+        return dataset.get_video_tensor(
+            media_bytes,
+            vision_stream=vision_stream,
+            worker_id=worker_id,
+            element_dtype="video",
+            raw_bytes_input=True,
+        )
+
+    if not isinstance(value, torch.Tensor):
+        raise TypeError(f"unsupported DataMake video input: {type(value)!r}")
+    video = value.detach().to(device="cpu")
+    if video.ndim != 4 or video.shape[0] != 3:
+        raise ValueError(f"in-memory video must be CTHW, got {tuple(video.shape)}")
+    if vision_stream == "vae_video":
+        if video.dtype == torch.uint8:
+            tensor = video.float().div_(127.5).sub_(1.0)
+        else:
+            tensor = video.float().clamp_(-1.0, 1.0)
+    elif vision_stream == "vit_video":
+        if video.dtype == torch.uint8:
+            frames_uint8 = video
+        else:
+            frames_uint8 = (
+                video.float()
+                .clamp_(-1.0, 1.0)
+                .add_(1.0)
+                .mul_(127.5)
+                .round_()
+                .clamp_(0, 255)
+                .to(torch.uint8)
+            )
+        frames = [
+            Image.fromarray(frame.permute(1, 2, 0).numpy(), mode="RGB")
+            for frame in frames_uint8.unbind(dim=1)
+        ]
+        tensor = dataset.vit_transform(frames)
+        if tensor.shape[1] % 2 == 1:
+            tensor = torch.cat([tensor, tensor[:, -1:]], dim=1)
+        del frames, frames_uint8
+    else:
+        raise ValueError(f"unsupported vision stream: {vision_stream}")
+    dataset.vision_stream = vision_stream
+    return tensor, dataset.vision_token_count(tensor), None
+
+
+def process_online_rollout_row(
+    dataset,
+    row: Dict[str, Any],
+    parquet_idx: int,
+    row_group_id: int,
+    row_idx: int,
+    worker_id: int,
+    parquet_file_path: str,
+) -> Optional[Dict[str, Any]]:
+    """Build one role-aware training turn using path or in-memory video inputs."""
+
+    references = normalize_reference_images(row)
+    try:
+        video_inputs = _validate_online_row(dataset, row)
+        prompts = list(row["prompts"])
+        video_paths = list(row["video_paths"])
+        latest_source_index = len(video_paths) - 2
+        drop_all_text = (
+            random.random() < dataset.data_config["text_cond_dropout_prob"]
+        )
+
+        video_tensor_list = []
+        sequence_plan = []
+        visual_token_counts: List[int] = []
+        media_cache: Dict[str, bytes] = {}
+
+        def add_condition(
+            media_value: Any,
+            message_content: List[Dict[str, str]],
+            include_vae: bool,
+        ) -> None:
+            include_vit = (
+                random.random() >= dataset.data_config["vit_cond_dropout_prob"]
+            )
+            if include_vit and "vit" in dataset.vision_cond_type:
+                tensor, num_tokens, thw = get_online_video_tensor(
+                    dataset, media_value, "vit_video", worker_id, media_cache
+                )
+                video_tensor_list.append(tensor)
+                sequence_plan.append(
+                    {
+                        "type": "vit_video",
+                        "enable_cfg": 1,
+                        "loss": 0,
+                        "special_token_loss": 0,
+                        "special_token_label": None,
+                        "thw": thw,
+                        "apply_text_template": True,
+                    }
+                )
+                visual_token_counts.append(num_tokens)
+                message_content.append({"type": "video"})
+
+            if include_vae and "vae_Nsplit" in dataset.vision_cond_type:
+                tensor, num_tokens, thw = get_online_video_tensor(
+                    dataset, media_value, "vae_video", worker_id, media_cache
+                )
+                video_tensor_list.append(tensor)
+                sequence_plan.append(
+                    {
+                        "type": "vae_video",
+                        "enable_cfg": 1,
+                        "loss": 0,
+                        "special_token_loss": 0,
+                        "special_token_label": None,
+                        "datamake_edit_role": "source",
+                        "thw": thw,
+                        "apply_text_template": True,
+                    }
+                )
+                visual_token_counts.append(num_tokens)
+                message_content.append({"type": "video"})
+
+        messages: List[Dict[str, Any]] = []
+        for prompt_index, prompt in enumerate(prompts):
+            user_content: List[Dict[str, str]] = []
+            if prompt_index == 0:
+                add_condition(
+                    video_inputs[0],
+                    user_content,
+                    include_vae=latest_source_index == 0,
+                )
+            append_reference_condition(
+                dataset, references[prompt_index], user_content, video_tensor_list,
+                sequence_plan, visual_token_counts, drop_text=drop_all_text,
+            )
+            if not drop_all_text:
+                user_content.append({"type": "text", "text": prompt})
+            messages.append({"role": "user", "content": user_content})
+
+            if prompt_index < len(prompts) - 1:
+                assistant_content: List[Dict[str, str]] = []
+                source_index = prompt_index + 1
+                add_condition(
+                    video_inputs[source_index],
+                    assistant_content,
+                    include_vae=source_index == latest_source_index,
+                )
+                messages.append({"role": "assistant", "content": assistant_content})
+
+        target_tensor, target_tokens, target_thw = get_online_video_tensor(
+            dataset, video_inputs[-1], "vae_video", worker_id, media_cache
+        )
+        video_tensor_list.append(target_tensor)
+        sequence_plan.append(
+            {
+                "type": "vae_video",
+                "enable_cfg": 0,
+                "loss": 1,
+                "special_token_loss": 0,
+                "special_token_label": None,
+                "datamake_edit_role": "target",
+                "frame_condition_idx": [],
+                "L_video_group": dataset.L_video_group,
+                "random_choose_group": dataset.random_choose_group,
+                "thw": target_thw,
+                "apply_text_template": True,
+            }
+        )
+        visual_token_counts.append(target_tokens)
+        messages.append({"role": "assistant", "content": [{"type": "video"}]})
+
+        current_prompt = "" if drop_all_text else prompts[-1]
+        rendered = render_qwenvl_prompt(
+            messages,
+            default_system=generate_system_prompt("edit", vision_type="video"),
+            include_assistant_content=True,
+        ).strip()
+        all_token_ids, spans_index, target_index, search_index = (
+            expand_and_index_multiturn(
+                rendered,
+                visual_token_counts,
+                tokenizer=dataset.tokenizer,
+                target_text="assistant\n",
+                search_text=current_prompt,
+            )
+        )
+        sequence_plan.append(
+            {
+                "type": "text_template",
+                "enable_cfg": 0,
+                "loss": 0,
+                "special_token_loss": 0,
+                "special_token_label": None,
+                "packed_label_index": target_index,
+                "spans_index": spans_index,
+                "cap_index": search_index,
+            }
+        )
+        return {
+            "video_tensor_list": video_tensor_list,
+            "text_ids_list": [all_token_ids],
+            "num_tokens": len(all_token_ids),
+            "sequence_plan": sequence_plan,
+            "sample_task": "edit",
+            "N_target": 1,
+            "data_indexes": {
+                "data_indexes": [parquet_idx, row_group_id, row_idx],
+                "worker_id": worker_id,
+                "dataset_name": dataset.dataset_name,
+                "sample_id": row["sample_id"],
+                "chain_id": row["chain_id"],
+                "target_round": int(row["target_round"]),
+            },
+        }
+    except Exception as error:
+        if any(ref is not None for ref in references):
+            raise RuntimeError(f"Failed reference-conditioned row {row.get('sample_id')}") from error
+        dataset.logger.warning(
+            f"Error processing DataMake online-rollout row: {error} in "
+            f"rg#{row_group_id}, {parquet_file_path}"
+        )
+        return None
