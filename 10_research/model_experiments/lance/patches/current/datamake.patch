+def build_edit_region_mse_weights(
+    padded_latent: Sequence[torch.Tensor],
+    patchified_vae_latent_shapes: Sequence[Tuple[int, int, int]],
+    vae_edit_roles: Sequence[str],
+    latent_patch_size: Sequence[int],
+    boost: float = 1.0,
+    low_quantile: float = 0.5,
+    high_quantile: float = 0.9,
+    epsilon: float = 1e-6,
+) -> torch.Tensor:
+    """Build target-token weights from paired DataMake source/target latents.
+
+    Raw weights are ``1 + boost * importance``. The loss reducer divides by
+    the global weight sum, so unchanged tokens remain supervised while the
+    overall loss scale stays stable.
+    """
+
+    if boost < 0:
+        raise ValueError(f"edit-region boost must be non-negative, got {boost}")
+    if not 0 <= low_quantile < high_quantile <= 1:
+        raise ValueError(
+            "edit-region quantiles must satisfy "
+            f"0 <= low < high <= 1, got {low_quantile}, {high_quantile}"
+        )
+    if len(latent_patch_size) != 3 or any(
+        int(value) < 1 for value in latent_patch_size
+    ):
+        raise ValueError(f"invalid latent patch size: {latent_patch_size}")
+    if not (
+        len(padded_latent)
+        == len(patchified_vae_latent_shapes)
+        == len(vae_edit_roles)
+    ):
+        raise ValueError(
+            "latent, shape and edit-role counts must match: "
+            f"{len(padded_latent)}, {len(patchified_vae_latent_shapes)}, "
+            f"{len(vae_edit_roles)}"
+        )
+
+    pt, ph, pw = (int(value) for value in latent_patch_size)
+    latest_source = None
+    target_weights: List[torch.Tensor] = []
+
+    for latent, shape, role in zip(
+        padded_latent, patchified_vae_latent_shapes, vae_edit_roles
+    ):
+        t, h, w = (int(value) for value in shape)
+        cropped = latent[: t * pt, : h * ph, : w * pw]
+        if tuple(cropped.shape[:3]) != (t * pt, h * ph, w * pw):
+            raise ValueError(
+                f"latent is smaller than declared patchified shape: "
+                f"latent={tuple(latent.shape)}, shape={(t, h, w)}"
