@@ -0,0 +1,298 @@
+# Copyright (c) 2025 ByteDance Ltd. and/or its affiliates.
+# Licensed under the Apache License, Version 2.0.
+# coding: utf-8
+
+"""Generate deterministic model-output histories for DataMake training.
+
+One Lance model is loaded per process and reused for every assigned chain.  The
+input train parquet is deduplicated to the longest prefix of each chain, then
+all edit turns are generated autoregressively.  Each process owns a stable
+``chain_index % shard_count`` partition and writes an independent manifest, so
+several one-GPU jobs can run without a shared-manifest race.
+
+This program generates conditioning media only. It never starts optimization.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Dict, List, Tuple, cast
+
+import pyarrow.parquet as pq
+import torch
+from transformers import HfArgumentParser, set_seed
+import yaml
+
+from config.config_factory import (
+    DataArguments,
+    InferenceArguments,
+    ModelArguments,
+    get_model_path,
+)
+from multiturn.conversation import ContentItem, Conversation, Turn, TurnAction
+from multiturn.engine import MultiTurnChatEngine
+from train.datamake_generation_lora import install_lora_inference_loader_if_present
+
+
+SCHEMA_VERSION = "datamake_lance_rollout_media_v1"
+
+
+@dataclass
+class RolloutArguments:
+    source_config: str = field(metadata={"help": "DataMake Lance train YAML."})
+    output_root: str = field(metadata={"help": "Root for generated chain media."})
+    manifest_path: str = field(
+        default="",
+        metadata={"help": "Defaults to output_root/manifest-shard-NNNNN.json."},
+    )
+    shard_count: int = 1
+    shard_index: int = 0
+    max_chains: int = 0
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def atomic_json(path: Path, payload: Dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(
+        json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    os.replace(temporary, path)
+
+
+def resolve_media(media_root: Path, value: str) -> Path:
+    path = Path(value)
+    resolved = path.resolve() if path.is_absolute() else (media_root / path).resolve()
+    if not resolved.is_file():
+        raise FileNotFoundError(resolved)
+    return resolved
+
+
+def load_longest_chain_rows(source_config: Path) -> Tuple[List[Dict[str, Any]], Path]:
+    payload = yaml.safe_load(source_config.read_text(encoding="utf-8"))
+    dataset = payload["D1"]["datamake_multiturn_v2v_local"]
+    media_root = Path(dataset["media_root"]).resolve()
+    parquet_paths = dataset["dataset_names"]["datamake_multiturn"]["data_dir"]
+    longest: Dict[str, Dict[str, Any]] = {}
+    for parquet_path in parquet_paths:
+        rows = pq.read_table(
+            parquet_path,
+            columns=[
+                "sample_id",
+                "chain_id",
+                "target_round",
+                "prompts",
+                "video_paths",
+            ],
+        ).to_pylist()
+        for row in rows:
+            chain_id = str(row["chain_id"])
+            previous = longest.get(chain_id)
+            if previous is None or int(row["target_round"]) > int(
+                previous["target_round"]
+            ):
+                longest[chain_id] = row
+    return [longest[key] for key in sorted(longest)], media_root
+
+
+def make_user_turn(prompt: str, initial_video: Path | None) -> Turn:
+    content = []
+    if initial_video is not None:
+        content.append(ContentItem(type="video", value=str(initial_video)))
+    content.append(ContentItem(type="text", value=prompt))
+    return Turn(role="user", content=content, action=TurnAction.EDIT_VIDEO)
+
+
+def stable_turn_seed(base_seed: int, chain_id: str, round_number: int) -> int:
+    payload = f"{base_seed}\0{chain_id}\0{round_number}".encode("utf-8")
+    return int.from_bytes(hashlib.sha256(payload).digest()[:4], "big")
+
+
+def checkpoint_identity(model_path: Path) -> Dict[str, Any]:
+    model_file = model_path / "model.safetensors"
+    if not model_file.is_file():
+        raise FileNotFoundError(model_file)
+    identity = {
+        "path": str(model_path),
+        "model_sha256": sha256_file(model_file),
+    }
+    lora_config = model_path / "datamake_lora_config.json"
+    if lora_config.is_file():
+        identity["lora_config_sha256"] = sha256_file(lora_config)
+    return identity
+
+
+def validate_existing_chain(record: Dict[str, Any]) -> None:
+    for item in record["round_outputs"]:
+        path = Path(item["output_video"])
+        if not path.is_file() or sha256_file(path) != item["sha256"]:
+            raise ValueError(f"existing rollout chain is incomplete: {path}")
+
+
+def main() -> None:
+    if not torch.cuda.is_available():
+        raise RuntimeError("CUDA is required for rollout generation")
+    parser = HfArgumentParser(
+        (ModelArguments, DataArguments, InferenceArguments, RolloutArguments)
+    )
+    model_args, data_args, inference_args, rollout_args = cast(
+        Tuple[ModelArguments, DataArguments, InferenceArguments, RolloutArguments],
+        parser.parse_args_into_dataclasses(),
+    )
+    if rollout_args.shard_count < 1:
+        raise ValueError("shard_count must be positive")
+    if not 0 <= rollout_args.shard_index < rollout_args.shard_count:
+        raise ValueError("shard_index must be in [0, shard_count)")
+    if not model_args.model_path:
+        raise ValueError("--model_path is required")
+    if not model_args.llm_path:
+        model_args.llm_path = model_args.model_path
+    if not model_args.vit_path:
+        model_args.vit_path = get_model_path("vit.qwen2_5_vl")
+
+    source_config = Path(rollout_args.source_config).resolve()
+    output_root = Path(rollout_args.output_root).resolve()
+    manifest_path = (
+        Path(rollout_args.manifest_path).resolve()
+        if rollout_args.manifest_path
+        else output_root
+        / f"manifest-shard-{rollout_args.shard_index:05d}-of-{rollout_args.shard_count:05d}.json"
+    )
+    rows, media_root = load_longest_chain_rows(source_config)
+    assigned = [
+        row
+        for index, row in enumerate(rows)
+        if index % rollout_args.shard_count == rollout_args.shard_index
+    ]
+    if rollout_args.max_chains > 0:
+        assigned = assigned[: rollout_args.max_chains]
+
+    model_path = Path(model_args.model_path).resolve()
+    uses_lora = install_lora_inference_loader_if_present(str(model_path))
+    identity = checkpoint_identity(model_path)
+    identity["uses_datamake_lora"] = uses_lora
+    settings = {
+        "diffusion_steps": int(inference_args.validation_num_timesteps),
+        "timestep_shift": float(inference_args.validation_timestep_shift),
+        "cfg_text_scale": float(model_args.cfg_text_scale),
+        "base_seed": int(inference_args.validation_data_seed),
+        "num_frames": int(inference_args.num_frames),
+        "resolution": str(inference_args.resolution),
+    }
+    manifest: Dict[str, Any] = {
+        "schema_version": SCHEMA_VERSION,
+        "source_config": str(source_config),
+        "source_config_sha256": sha256_file(source_config),
+        "checkpoint": identity,
+        "inference": settings,
+        "shard_count": rollout_args.shard_count,
+        "shard_index": rollout_args.shard_index,
+        "chains": [],
+    }
+    completed: Dict[str, Dict[str, Any]] = {}
+    if manifest_path.is_file():
+        existing = json.loads(manifest_path.read_text(encoding="utf-8"))
+        for key in (
+            "schema_version",
+            "source_config_sha256",
+            "checkpoint",
+            "inference",
+            "shard_count",
+            "shard_index",
+        ):
+            if existing.get(key) != manifest.get(key):
+                raise ValueError(f"existing rollout manifest differs at {key}")
+        for record in existing.get("chains", []):
+            validate_existing_chain(record)
+            completed[str(record["chain_id"])] = record
+        manifest["chains"] = list(existing.get("chains", []))
+
+    device = 0
+    torch.cuda.set_device(device)
+    set_seed(inference_args.global_seed)
+    engine = MultiTurnChatEngine(
+        model_args=model_args,
+        data_args=data_args,
+        inference_args=inference_args,
+        device=device,
+        log=print,
+    )
+
+    for row in assigned:
+        chain_id = str(row["chain_id"])
+        if chain_id in completed:
+            print(f"[skip] {chain_id}")
+            continue
+        chain_dir = output_root / "chains" / chain_id
+        if chain_dir.exists() and any(chain_dir.iterdir()):
+            raise ValueError(
+                f"partial chain directory exists without manifest record: {chain_dir}"
+            )
+        chain_dir.mkdir(parents=True, exist_ok=True)
+        prompts = list(row["prompts"])
+        gt_paths = [resolve_media(media_root, value) for value in row["video_paths"]]
+        conversation = Conversation(turns=[])
+        outputs = []
+        for index, prompt in enumerate(prompts):
+            round_number = index + 1
+            conversation.append(
+                make_user_turn(prompt, gt_paths[0] if index == 0 else None)
+            )
+            seed = stable_turn_seed(
+                int(inference_args.validation_data_seed), chain_id, round_number
+            )
+            engine.inference_args.validation_noise_seed = seed
+            output = Path(
+                engine.generate_turn(
+                    conversation,
+                    len(conversation.turns) - 1,
+                    str(chain_dir),
+                    index,
+                )
+            ).resolve()
+            outputs.append(
+                {
+                    "round": round_number,
+                    "output_video": str(output),
+                    "sha256": sha256_file(output),
+                    "seed": seed,
+                    "ground_truth_video": str(gt_paths[round_number]),
+                    "ground_truth_sha256": sha256_file(gt_paths[round_number]),
+                }
+            )
+
+        transcript_path = chain_dir / "transcript.json"
+        atomic_json(transcript_path, conversation.to_dict())
+        record = {
+            "chain_id": chain_id,
+            "source_sample_id": str(row["sample_id"]),
+            "rounds": len(prompts),
+            "initial_video": str(gt_paths[0]),
+            "initial_video_sha256": sha256_file(gt_paths[0]),
+            "round_outputs": outputs,
+            "transcript": str(transcript_path),
+            "transcript_sha256": sha256_file(transcript_path),
+        }
+        manifest["chains"].append(record)
+        manifest["chains"].sort(key=lambda item: item["chain_id"])
+        atomic_json(manifest_path, manifest)
+        print(f"[complete] {chain_id} ({len(outputs)} rounds)")
+
+    atomic_json(manifest_path, manifest)
+    print(f"[done] {len(manifest['chains'])} chains -> {manifest_path}")
+
+
+if __name__ == "__main__":
+    main()
