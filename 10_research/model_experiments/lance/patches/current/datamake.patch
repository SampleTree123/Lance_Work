+@dataclass(frozen=True)
+class ChainRecord:
+    chain_id: str
+    prompts: tuple[str, ...]
+    video_paths: tuple[str, ...]
+    turn_ids: tuple[str, ...]
+    edit_axes: tuple[str, ...]
+    source_sample_id: str
+
+    @property
+    def round_count(self) -> int:
+        return len(self.prompts)
