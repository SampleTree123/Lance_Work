+# coding: utf-8
+
+"""Unified multi-turn multimodal chat (inference-only) for Lance.
+
+This package implements a manual (per-turn action) multi-turn conversation
+pipeline on top of the existing single-turn Lance inference machinery:
+
+- ``conversation``    : data model for interleaved text/image/video turns.
+- ``sequence_builder``: turns a ``Conversation`` + target action into the packed
+  tensors that ``modeling.lance.Lance`` validation methods consume.
+- ``engine``          : drives the per-turn build -> generate -> decode -> append loop.
+"""
+
+from .conversation import (
+    ContentItem,
+    Conversation,
+    Turn,
+    TurnAction,
+    MODALITY_TEXT,
+    MODALITY_IMAGE,
+    MODALITY_VIDEO,
+)
+
+__all__ = [
+    "ContentItem",
+    "Conversation",
+    "Turn",
+    "TurnAction",
+    "MODALITY_TEXT",
+    "MODALITY_IMAGE",
+    "MODALITY_VIDEO",
+]
diff --git a/multiturn/conversation.py b/multiturn/conversation.py
new file mode 100644
index 0000000..08c7084
--- /dev/null
+++ b/multiturn/conversation.py
@@ -0,0 +1,285 @@
+# Copyright (c) 2025 ByteDance Ltd. and/or its affiliates.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# coding: utf-8
+
+"""Data model for a unified multi-turn multimodal conversation.
+
+A conversation is an ordered list of :class:`Turn`. Each turn has a role
+(``user`` / ``assistant``) and a list of :class:`ContentItem` (interleaved text,
+image, or video). A user turn additionally carries an ``action`` that the caller
+uses to tell the model *what to produce* in response (Phase 1 is fully manual;
+the model does not self-select the output modality).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Any, Dict, List, Optional
+
+# Content modalities (string tags used in the conversation JSON and templates).
+MODALITY_TEXT = "text"
+MODALITY_IMAGE = "image"
+MODALITY_VIDEO = "video"
+_VISUAL_MODALITIES = (MODALITY_IMAGE, MODALITY_VIDEO)
+
+ROLE_USER = "user"
+ROLE_ASSISTANT = "assistant"
+_VALID_ROLES = (ROLE_USER, ROLE_ASSISTANT)
+
+
+class TurnAction(str, Enum):
+    """How the model should respond to a user turn (manual modality selection).
+
+    Text output -> understanding branch (autoregressive text generation).
+    Visual output -> generation branch (flow-matching denoising + VAE decode).
+    """
+
+    # Text output.
+    CHAT = "chat"
+    UNDERSTAND = "understand"
+
+    # Visual output (no per-turn input visual required; history may still be context).
+    GENERATE_IMAGE = "generate_image"
+    GENERATE_VIDEO = "generate_video"
+
+    # Visual output conditioned on an input visual in the current/most-recent turn.
+    EDIT_IMAGE = "edit_image"
+    EDIT_VIDEO = "edit_video"
+    IMAGE_TO_VIDEO = "image_to_video"
+
+    @property
+    def is_text_output(self) -> bool:
+        return self in (TurnAction.CHAT, TurnAction.UNDERSTAND)
+
+    @property
+    def is_visual_output(self) -> bool:
+        return not self.is_text_output
+
+    @property
+    def target_modality(self) -> str:
+        """Modality of the produced output."""
+        if self.is_text_output:
+            return MODALITY_TEXT
+        if self in (TurnAction.GENERATE_IMAGE, TurnAction.EDIT_IMAGE):
+            return MODALITY_IMAGE
+        return MODALITY_VIDEO
+
+    @property
+    def is_edit(self) -> bool:
+        """Whether the action conditions generation on an input visual."""
+        return self in (TurnAction.EDIT_IMAGE, TurnAction.EDIT_VIDEO)
+
+    @property
+    def is_image_to_video(self) -> bool:
+        return self is TurnAction.IMAGE_TO_VIDEO
+
+
+@dataclass
+class ContentItem:
+    """A single interleaved content element inside a turn."""
+
+    type: str  # one of MODALITY_TEXT / MODALITY_IMAGE / MODALITY_VIDEO
+    value: str  # text payload, or a file path for visual modalities
+
+    def __post_init__(self) -> None:
+        if self.type not in (MODALITY_TEXT, MODALITY_IMAGE, MODALITY_VIDEO):
+            raise ValueError(
+                f"ContentItem.type must be one of "
+                f"{(MODALITY_TEXT, MODALITY_IMAGE, MODALITY_VIDEO)}, got {self.type!r}"
+            )
+        if not isinstance(self.value, str):
+            raise TypeError(
+                f"ContentItem.value must be str, got {type(self.value).__name__}: {self.value!r}"
+            )
+
+    @property
+    def is_visual(self) -> bool:
+        return self.type in _VISUAL_MODALITIES
+
+    @property
+    def is_text(self) -> bool:
+        return self.type == MODALITY_TEXT
+
+    @classmethod
+    def from_dict(cls, raw: Dict[str, Any]) -> "ContentItem":
+        if not isinstance(raw, dict):
+            raise TypeError(f"content item must be a dict, got {type(raw).__name__}: {raw!r}")
+        if "type" not in raw or "value" not in raw:
+            raise ValueError(f"content item requires 'type' and 'value' keys, got {sorted(raw.keys())}")
+        return cls(type=raw["type"], value=raw["value"])
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {"type": self.type, "value": self.value}
+
+
+@dataclass
+class Turn:
+    """One conversation turn: a role plus interleaved content.
+
+    For a ``user`` turn, ``action`` declares how the model should respond. For an
+    ``assistant`` turn (either pre-seeded context or a model-produced response),
+    ``action`` is ``None``.
+    """
+
+    role: str
+    content: List[ContentItem] = field(default_factory=list)
+    action: Optional[TurnAction] = None
+    # Optional visual-target overrides for the produced output (visual actions only).
+    height: Optional[int] = None
+    width: Optional[int] = None
+    num_frames: Optional[int] = None
+    # Free-form metadata (e.g. saved output path) attached after generation.
+    meta: Dict[str, Any] = field(default_factory=dict)
+    # Optional appearance reference for this instruction. Kept separate from
+    # content visuals so it can never become the next direct VAE edit source.
+    reference_image: Optional[str] = None
+
+    def __post_init__(self) -> None:
+        if self.role not in _VALID_ROLES:
+            raise ValueError(f"Turn.role must be one of {_VALID_ROLES}, got {self.role!r}")
+        if self.action is not None and not isinstance(self.action, TurnAction):
+            raise TypeError(
+                f"Turn.action must be a TurnAction or None, got {type(self.action).__name__}: {self.action!r}"
+            )
+        if self.role == ROLE_ASSISTANT and self.action is not None:
+            raise ValueError("assistant turns must not declare an action")
+        if self.reference_image is not None:
+            if not isinstance(self.reference_image, str) or not self.reference_image.strip():
+                raise ValueError("reference_image must be a non-empty image path or null")
+            if self.role != ROLE_USER:
+                raise ValueError("reference_image is only supported on user turns")
+            if self.action not in (None, TurnAction.EDIT_VIDEO):
+                raise ValueError("reference_image is currently supported only for edit_video")
+
+    @property
+    def visual_items(self) -> List[ContentItem]:
+        return [c for c in self.content if c.is_visual]
+
+    @property
+    def text_items(self) -> List[ContentItem]:
+        return [c for c in self.content if c.is_text]
+
+    def joined_text(self) -> str:
+        """Concatenate all text content of this turn."""
+        return " ".join(c.value for c in self.content if c.is_text).strip()
+
+    @classmethod
+    def from_dict(cls, raw: Dict[str, Any]) -> "Turn":
+        if not isinstance(raw, dict):
+            raise TypeError(f"turn must be a dict, got {type(raw).__name__}: {raw!r}")
+        if "reference_images" in raw or "reference_image_paths" in raw:
+            raise ValueError("Inference turns use the singular reference_image field")
+        role = raw.get("role")
+        if role not in _VALID_ROLES:
+            raise ValueError(f"turn 'role' must be one of {_VALID_ROLES}, got {role!r}")
+
+        raw_content = raw.get("content", [])
+        if isinstance(raw_content, str):
+            raw_content = [{"type": MODALITY_TEXT, "value": raw_content}]
+        if not isinstance(raw_content, list):
+            raise TypeError(
+                f"turn 'content' must be a list (or str), got {type(raw_content).__name__}: {raw_content!r}"
+            )
+        content = [ContentItem.from_dict(item) for item in raw_content]
+
+        action_raw = raw.get("action")
+        action: Optional[TurnAction] = None
+        if action_raw is not None:
+            try:
+                action = TurnAction(action_raw)
+            except ValueError as exc:
+                valid = [a.value for a in TurnAction]
+                raise ValueError(
+                    f"unknown turn action {action_raw!r}; valid actions are {valid}"
+                ) from exc
+
+        return cls(
+            role=role,
+            content=content,
+            action=action,
+            height=raw.get("height"),
+            width=raw.get("width"),
+            num_frames=raw.get("num_frames"),
+            meta=dict(raw.get("meta", {})),
+            reference_image=raw.get("reference_image"),
+        )
+
+    def to_dict(self) -> Dict[str, Any]:
+        out: Dict[str, Any] = {
+            "role": self.role,
+            "content": [c.to_dict() for c in self.content],
+        }
+        if self.action is not None:
+            out["action"] = self.action.value
+        for key in ("height", "width", "num_frames"):
+            value = getattr(self, key)
+            if value is not None:
+                out[key] = value
+        if self.meta:
+            out["meta"] = dict(self.meta)
+        if self.reference_image is not None:
+            out["reference_image"] = self.reference_image
+        return out
+
+
+@dataclass
+class Conversation:
+    """An ordered multi-turn multimodal conversation."""
+
+    turns: List[Turn] = field(default_factory=list)
+    system_prompt: Optional[str] = None
+
+    def append(self, turn: Turn) -> None:
+        if not isinstance(turn, Turn):
+            raise TypeError(f"can only append Turn, got {type(turn).__name__}: {turn!r}")
+        self.turns.append(turn)
+
+    def add_assistant_text(self, text: str, meta: Optional[Dict[str, Any]] = None) -> Turn:
+        turn = Turn(
+            role=ROLE_ASSISTANT,
+            content=[ContentItem(type=MODALITY_TEXT, value=text)],
+            meta=dict(meta or {}),
+        )
+        self.append(turn)
+        return turn
+
+    def add_assistant_visual(
+        self, path: str, modality: str, meta: Optional[Dict[str, Any]] = None
+    ) -> Turn:
+        if modality not in _VISUAL_MODALITIES:
+            raise ValueError(f"assistant visual modality must be image/video, got {modality!r}")
+        turn = Turn(
+            role=ROLE_ASSISTANT,
+            content=[ContentItem(type=modality, value=path)],
+            meta=dict(meta or {}),
+        )
+        self.append(turn)
+        return turn
+
+    @classmethod
+    def from_dict(cls, raw: Dict[str, Any]) -> "Conversation":
+        if not isinstance(raw, dict):
+            raise TypeError(f"conversation must be a dict, got {type(raw).__name__}: {raw!r}")
+        raw_turns = raw.get("turns")
+        if not isinstance(raw_turns, list) or len(raw_turns) == 0:
+            raise ValueError("conversation requires a non-empty 'turns' list")
+        turns = [Turn.from_dict(t) for t in raw_turns]
+        return cls(turns=turns, system_prompt=raw.get("system_prompt"))
+
+    def to_dict(self) -> Dict[str, Any]:
+        out: Dict[str, Any] = {"turns": [t.to_dict() for t in self.turns]}
+        if self.system_prompt is not None:
+            out["system_prompt"] = self.system_prompt
+        return out
