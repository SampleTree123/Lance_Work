+                    loss.backward()
+                    e1.record()
+                    backward_events.append((e0, e1))
+                aggregate[0] += numerator.detach().double()
+                aggregate[1] += stats["tokens"]
+                aggregate[2] += 1
+                aggregate[3] += stats["attention_tokens"]
+                aggregate[4] += stats["padding_tokens"]
+                offset = 6 + 3 * (round_number - 1)
+                aggregate[offset] += numerator.detach().double()
+                aggregate[offset + 1] += stats["tokens"]
+                aggregate[offset + 2] += 1
+                sample_ids.extend(item["sample_id"] for item in indexes)
+                instance_ids.extend(f"{item['epoch']}:{item['sampling_instance_id']}" for item in indexes)
+                del loss, numerator, batch
+                # Backward has freed this turn's graph. Only detached patches are
