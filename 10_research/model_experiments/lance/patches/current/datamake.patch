diff --git a/data/datamake_reference_image.py b/data/datamake_reference_image.py
new file mode 100644
index 0000000..3f0362e
--- /dev/null
+++ b/data/datamake_reference_image.py
@@ -0,0 +1,76 @@
+"""Optional one-image-per-turn conditions shared by training and inference.
+
+Static images use the existing ViT video stream with one temporal patch (two
+identical frames), not a new image/video RoPE cursor or a VAE source.  No new
+vocabulary or parameters are introduced.
+"""
+from pathlib import Path
+import math
+import random
+
+from PIL import Image, ImageOps
+import torch
+
+
+REFERENCE_IMAGE_PROMPT = (
+    "Reference image for this instruction: use only the attributes requested "
+    "by the instruction; preserve the other content of the source video.\n"
+)
+
+
+def normalize_reference_images(row):
+    """Return optional paths aligned with prompts; never silently discard input."""
+    if "reference_image" in row or "reference_image_paths" in row:
+        raise ValueError("Training rows use reference_images, aligned with prompts")
+    count = len(row["prompts"])
+    refs = row.get("reference_images")
+    if refs is None:
+        return [None] * count
+    if not isinstance(refs, list) or len(refs) != count:
+        raise ValueError("reference_images must be a list aligned with prompts")
+    for ref in refs:
+        if ref is not None and (not isinstance(ref, str) or not ref.strip()):
+            raise ValueError("Each turn accepts one nonempty reference image path or null")
+        if isinstance(ref, str) and "://" in ref:
+            raise ValueError("Reference images must be local files")
+    return list(refs)
+
+
+def read_reference_tensor(path, vit_transform):
+    """Decode a single still image and apply the existing official transform."""
+    path = Path(path)
+    with Image.open(path) as image:
+        if getattr(image, "n_frames", 1) != 1:
+            raise ValueError("Reference must be a single still image, not an animation")
+        frame = ImageOps.exif_transpose(image).convert("RGB")
+        tensor = vit_transform([frame])
+    if not isinstance(tensor, torch.Tensor) or tensor.ndim != 4 or tensor.shape[:2] != (3, 1):
+        raise ValueError("Reference ViT transform must return one RGB frame in CTHW")
+    # Qwen's temporal patch size is two; this is one static temporal position.
+    return torch.cat([tensor, tensor[:, -1:]], dim=1)
+
+
+def append_reference_condition(dataset, path, message, tensors, plan, counts, drop_text=False):
+    if path is None:
+        return
+    if "vit" not in dataset.vision_cond_type:
+        raise ValueError("Reference image conditioning requires the ViT stream")
+    # Do not call _read_media_bytes: CoinVE overrides it with video crop handles.
+    resolved = dataset._resolve_media_path(path)
+    tensor = read_reference_tensor(resolved, dataset.vit_transform)
+    probability = float(dataset.data_config.get("vit_cond_dropout_prob", 0.0))
+    if not math.isfinite(probability) or not 0 <= probability <= 1:
+        raise ValueError("vit_cond_dropout_prob must be finite and in [0, 1]")
+    if probability > 0 and random.random() < probability:
+        return
+    dataset.vision_stream, dataset.data_mode = "vit_video", "online"
+    count = dataset.vision_token_count(tensor)
+    tensors.append(tensor)
+    plan.append(dict(type="vit_video", enable_cfg=1, loss=0,
+                     special_token_loss=0, special_token_label=None, thw=None,
+                     apply_text_template=True, datamake_edit_role="reference_image"))
+    counts.append(count)
+    if not drop_text:
+        message.append({"type": "text", "text": REFERENCE_IMAGE_PROMPT})
+    # A video placeholder intentionally shares the single video-grid cursor.
+    message.append({"type": "video"})
