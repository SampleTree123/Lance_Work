+"""Multiple indexed GT prefixes through Lance's native sequence packer.
+
+Loss slots preserve the batch1/accumulation recipe: slot j is normalized over
+ranks separately, then slots are averaged before gradient accumulation.
+"""
+import hashlib
+
+import torch
+import torch.distributed as dist
+
+from train.datamake_prefix_data import IndexedPrefixDataset, locate_prefix, preprocessing_rng
+
+
+def trim_attention_padding(data):
+    """Keep only 128-token alignment padding for Lance's native FlexAttention.
+
+    The zero-length trailing pad document must remain: Lance uses it as a
+    sentinel when iterating real samples for multimodal position IDs. Real
+    tensors, sample boundaries, loss indexes and RNG are untouched.
+    """
+    lengths, splits = data['sample_lens'], data['split_lens']
+    real_length = data['sequence_length']
+    if (not lengths or not splits or data['sample_type'][-1] != 'pad'
+            or data['sample_N_target'][-1] != 0 or data['attn_modes'][-1] != 'causal'
+            or lengths[-1] != splits[-1]
+            or sum(lengths[:-1]) != real_length or sum(splits[:-1]) != real_length):
+        raise ValueError("Expected Lance's isolated trailing attention padding document")
+    padding = (-real_length) % 128
+    result = dict(data)
+    result['sample_lens'] = [*lengths[:-1], padding]
+    result['split_lens'] = [*splits[:-1], padding]
+    return result
+
+
+class IndexedPackedPrefixDataset(IndexedPrefixDataset):
+    def __init__(self, packer, total_prefixes, seed, batch_size=2):
+        if batch_size not in (1, 2, 4, 8) or total_prefixes % batch_size:
+            raise ValueError("Packing requires complete batches of 1, 2, 4 or 8 prefixes")
+        super().__init__(packer, total_prefixes // batch_size, seed)
+        self.batch_size = batch_size
+        self.single_token_budget = packer.max_num_tokens
+        packer.max_num_tokens = self.single_token_budget * batch_size
+
+    def __getitem__(self, group_index):
+        status = self.packer.set_sequence_status()
+        indexes, counts = [], []
+        for slot in range(self.batch_size):
+            index = group_index * self.batch_size + slot
+            worker, row_index, cycle = locate_prefix(index, [len(rows) for rows in self.rows])
+            row = self.rows[worker][row_index]
+            seed = int.from_bytes(hashlib.sha256(
+                f"{self.seed}:{self.source.local_rank}:{index}".encode()).digest()[:8], "little")
+            with preprocessing_rng(seed):
+                sample = self.source._process_row(row, 0, 0, row_index, worker, self.paths[worker])
+                if sample is None:
+                    raise RuntimeError(f"Failed to decode prefix {row.get('sample_id')} at {index}")
+                estimate = sample['num_tokens'] + 2 * len(sample['sequence_plan'])
+                if estimate > self.packer.max_num_tokens_per_sample:
+                    raise ValueError(f"Prefix exceeds token budget: {estimate}")
+                before, mse_before = status['curr'], len(status['mse_loss_indexes'])
+                status = self.packer.pack_sequence(sample, status)
+                if status['curr'] - before > self.single_token_budget:
+                    raise ValueError("Individual prefix exceeds original token budget")
+                counts.append(len(status['mse_loss_indexes']) - mse_before)
+                indexes.append({**sample['data_indexes'], 'microstep': index, 'cycle': cycle})
+        if any(count <= 0 for count in counts):
+            raise ValueError("Each packed prefix needs its own supervised target")
+        if status['ce_loss_indexes']:
+            raise ValueError("Packed Stage6 recipe supports target MSE supervision only")
+        packed = self.packer.to_tensor(status)
+        packed['batch_data_indexes'] = indexes
+        packed['mse_slot_counts'] = counts
+        return packed
+
+
+def compute_packed_training_loss(loss_dict, counts, training_args, weights=None):
+    if loss_dict['ce'] is not None or loss_dict['frame_mse'] is not None:
+        raise ValueError("Packed Stage6 loss requires MSE-only supervision")
+    mse = loss_dict['mse']
+    if mse is None or any(n <= 0 for n in counts) or sum(counts) != len(mse):
+        raise ValueError("Packed MSE counts do not cover every target token")
+    per_token = mse.mean(dim=-1)
+    if weights is not None and (weights.ndim != 1 or len(weights) != len(mse)):
+        raise ValueError("Packed region weights do not match MSE tokens")
+    weights = torch.ones_like(per_token) if weights is None else weights.to(per_token)
+    nums, denoms, raw_nums = [], [], []
+    for values, slot_weights in zip(per_token.split(counts), weights.split(counts)):
+        nums.append((values * slot_weights).sum())
+        denoms.append(slot_weights.sum())
+        raw_nums.append(values.sum())
+    global_denoms = torch.stack(denoms).detach()
+    token_counts = torch.tensor(counts, device=mse.device, dtype=torch.long)
+    world = dist.get_world_size() if dist.is_initialized() else 1
+    if dist.is_initialized():
+        dist.all_reduce(global_denoms)
+        dist.all_reduce(token_counts)
+    weighted = (torch.stack(nums) * world / global_denoms).mean()
+    raw = (torch.stack(raw_nums) * world / token_counts).mean()
+    zero = torch.zeros((), device=mse.device)
+    metrics = {'ce': zero, 'frame_mse': zero, 'mse': weighted.detach(),
+               'mse_unweighted': raw.detach(), 'edit_region_weight_mean': weights.mean().detach(),
+               'edit_region_weight_max': weights.max().detach()}
+    return weighted * training_args.mse_weight, metrics, zero.long(), token_counts.sum()
diff --git a/train/datamake_peft.py b/train/datamake_peft.py
new file mode 100644
index 0000000..5be2ba4
--- /dev/null
+++ b/train/datamake_peft.py
@@ -0,0 +1,115 @@
+"""Official PEFT adapter injection with DataMake's exact branch contract."""
+from dataclasses import asdict
+import hashlib
+import json
+from pathlib import Path
+
+import torch
+from torch import nn
+
+from train.datamake_lora_config import (
+    BranchLoRAConfig, is_generation_target, is_understanding_target,
+)
+
+SCHEMA = "datamake_lance_peft_branch_v1"
+PEFT_VERSION = "0.15.2"
+
+
+def require_peft():
+    import peft
+    if peft.__version__ != PEFT_VERSION:
+        raise RuntimeError(f"Expected PEFT {PEFT_VERSION}, found {peft.__version__}")
+    return peft
+
+
+def canonical_name(name):
+    name = name.replace("_checkpoint_wrapped_module.", "")
+    for side in ("A", "B"):
+        name = name.replace(f".lora_{side}.default.weight", f".lora_{side}.weight")
+    return name
+
+
+def legacy_name(name):
+    name = canonical_name(name)
+    for side in ("A", "B"):
+        if name.endswith(f".lora_{side}.weight"):
+            return name[:-7]
+    raise ValueError(f"Not a LoRA parameter: {name}")
+
+
+def inject(model, config: BranchLoRAConfig, seed=2026):
+    """Use PEFT's Linear implementation; only scope and RNG policy are local."""
+    peft = require_peft()
+    config.validate()
+    targets = [name for name, module in model.named_modules()
+               if isinstance(module, nn.Linear) and (is_generation_target(name) or
+                  (config.target_scope == "both_branches" and is_understanding_target(name)))]
+    if len(targets) != config.expected_target_modules:
+        raise ValueError(f"Expected {config.expected_target_modules} targets, found {len(targets)}")
+    model.requires_grad_(False)
+    devices = sorted({p.device.index for p in model.parameters() if p.is_cuda})
+    with torch.random.fork_rng(devices=devices):
+        model = peft.inject_adapter_in_model(peft.LoraConfig(
+            r=config.rank, lora_alpha=config.alpha, lora_dropout=config.dropout,
+            bias="none", target_modules=targets, init_lora_weights=True,
+            use_rslora=False, use_dora=False,
+        ), model)
+        # Explicit per-module initialization aligns both branches with Stage6.
+        for name in targets:
+            module = model.get_submodule(name)
+            module_seed = int.from_bytes(hashlib.sha256(f"{seed}:{name}".encode()).digest()[:8], "little")
+            torch.random.default_generator.manual_seed(module_seed)
+            if devices:
+                torch.cuda.manual_seed_all(module_seed)
+            # Stage6 initialized in the base dtype, then promoted to FP32.
+            base = module.get_base_layer().weight
+            initial = torch.empty(module.lora_A["default"].weight.shape,
+                                  dtype=base.dtype, device=base.device)
+            nn.init.kaiming_uniform_(initial, a=5 ** 0.5)
+            module.lora_A["default"].weight.data = initial.float()
+            module.lora_B["default"].weight.data = torch.zeros_like(module.lora_B["default"].weight, dtype=torch.float32)
+    actual = [name for name, p in model.named_parameters() if p.requires_grad]
+    if len(actual) != 2 * len(targets) or any(".lora_" not in name for name in actual):
+        raise RuntimeError("PEFT trainable scope differs from the branch contract")
+    return targets
+
+
+def adapter_state(model):
+    return {k: v.detach().cpu().contiguous().clone()
+            for k, v in require_peft().get_peft_model_state_dict(model).items()}
+
+
+def load_adapter(model, state):
+    expected = require_peft().get_peft_model_state_dict(model)
+    if set(state) != set(expected):
+        raise ValueError("Adapter keys differ from exact PEFT target topology")
+    for name, value in state.items():
+        if value.shape != expected[name].shape or not torch.isfinite(value).all():
+            raise ValueError(f"Invalid adapter tensor: {name}")
+    result = require_peft().set_peft_model_state_dict(model, state)
+    if result.unexpected_keys or any("lora_" in key for key in result.missing_keys):
+        raise RuntimeError(f"PEFT adapter load failed: {result}")
+
+
+def metadata(config):
+    return {"schema_version": SCHEMA, "peft_version": PEFT_VERSION,
+            "branch_config": asdict(config)}
+
+
+def install_inference_loader(checkpoint):
+    import inference_lance
+    from safetensors.torch import load_file
+    checkpoint = Path(checkpoint)
+    config = BranchLoRAConfig.from_dict(json.loads((checkpoint / "datamake_lora_config.json").read_text())["branch_config"])
+    original = inference_lance.init_from_model_path_if_needed
+
+    def loader(model, model_args):
+        original(model, model_args)
+        inject(model, config)
+        load_adapter(model, load_file(str(checkpoint / "adapter.safetensors")))
+        # Same audit shape as the legacy inference loader.
+        values = adapter_state(model)
+        return {"loaded_adapter_tensors": len(values), "checkpoint": str(checkpoint)}
+
+    inference_lance.init_from_model_path_if_needed = loader
+    return original
diff --git a/train/datamake_pred_x0_ddp_train.py b/train/datamake_pred_x0_ddp_train.py
new file mode 100644
index 0000000..a62bf93
--- /dev/null
+++ b/train/datamake_pred_x0_ddp_train.py
@@ -0,0 +1,81 @@
+"""Frozen mixed DDP loop with detached online pred_x0 history preparation."""
+from pathlib import Path
+import sys
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts"))
+from run_datamake_pred_x0_ddp_training import load_profile, make_contract
+from train import datamake_ddp_train as control
+from train.datamake_pred_x0_prefix import (
+    REQUEST_KEY, PredX0PrefixDataset, generation_rng, history_seed,
+)
+from train.datamake_flow_history import predict_clean_latent_patches
+
+supervised_loss = control.microbatch_loss
+
+
+@torch.no_grad()
+def predict_history(batch, bare_model, vae, device, empty_vae_cache, attention_padding):
+    data = batch.cuda(device).to_dict()
+    if attention_padding == "minimal":
+        data = control.trim_attention_padding(data)
+    for key in ("batch_data_indexes", "ce_loss_weights", "vae_edit_roles", "mse_slot_counts", "padded_videos_vit"):
+        data.pop(key, None)
+    mode, videos = data.pop("vae_data_mode"), data.pop("padded_videos")
+    shape = tuple(int(value) for value in data["patchified_vae_latent_shapes"][-1])
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        data["padded_latent"] = control.make_padded_latent(videos, mode, vae, empty_cache=empty_vae_cache)
+        losses = bare_model(**data, return_flow_intermediates=True)
+        patches = predict_clean_latent_patches(losses)
+        if patches.shape[0] != shape[0] * shape[1] * shape[2]:
+            raise RuntimeError("pred_x0 patch count does not match the target latent")
+        latent = patches.reshape(*shape, -1)
+        if not torch.isfinite(latent).all():
+            raise FloatingPointError("Nonfinite pred_x0 history latent")
+        # Official VAE decoder; no peak-stat reset, so full-step memory includes rollout.
+        decoded = vae.vae_decode([latent])[0]
+    if decoded.ndim != 4 or decoded.shape[0] != 3 or not torch.isfinite(decoded).all():
+        raise FloatingPointError("Invalid decoded pred_x0 history")
+    return decoded.detach().clamp(-1, 1).to(device="cpu", dtype=torch.float16).contiguous()
+
+
+def microbatch_loss(batch, model, vae, model_args, training_args, device, world, phase_events,
+                    empty_vae_cache=True, attention_padding="fixed"):
+    request = getattr(batch, REQUEST_KEY, None)
+    histories = []
+    if request is not None:
+        dataset = PredX0PrefixDataset.active
+        target_round = int(request["row"]["target_round"])
+        # Bypass DDP collectives for unequal history lengths across ranks. The final
+        # supervised forward still uses the original DDP/no_sync/backward path.
+        bare_model = model.module
+        for round_number in range(1, target_round):
+            seed = history_seed(request["seed"], round_number)
+            with torch.no_grad(), generation_rng(seed, device):
+                turn = dataset.pack_turn(request, round_number, histories, seed)
+                history = predict_history(turn, bare_model, vae, device, empty_vae_cache, attention_padding)
+                histories.append(history)
+                del turn
+        batch = dataset.pack_turn(request, target_round, histories, request["seed"])
+    loss, metrics, count, indexes = supervised_loss(
+        batch, model, vae, model_args, training_args, device, world, phase_events,
+        empty_vae_cache=empty_vae_cache, attention_padding=attention_padding)
+    # Same keys on every rank, including R1: preserve collective ordering.
+    metrics["history_generated_rounds"] = loss.new_tensor(len(histories))
+    metrics["history_detached"] = loss.new_tensor(1.0)
+    return loss, metrics, count, indexes
+
+
+def main():
+    # Only these hooks change. Model setup, optimizer, supervised loss/backward,
+    # scheduler, cursor, checkpoints and resume gate remain the control code.
+    control.load_profile = load_profile
+    control.make_contract = make_contract
+    control.IndexedPrefixDataset = PredX0PrefixDataset
+    control.microbatch_loss = microbatch_loss
+    return control.main()
+
+
+if __name__ == "__main__":
+    main()
