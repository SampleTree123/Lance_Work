+++ b/train/datamake_lora_checkpoint.py
@@ -0,0 +1,419 @@
+# coding: utf-8
+
+"""Adapter-only, exact-resume checkpoints for DataMake Lance LoRA training."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import random
+import shutil
+from typing import Any, Dict, Mapping, Optional
+
+import numpy as np
+from safetensors.torch import load_file, save_file
+import torch
+import torch.distributed as dist
+import torch.distributed.checkpoint as dcp
+from torch.distributed.checkpoint.format_utils import dcp_to_torch_save
+from torch.distributed.checkpoint.state_dict import (
+    StateDictOptions,
+    get_optimizer_state_dict,
+    set_optimizer_state_dict,
+)
+
+from train.datamake_generation_lora import (
+    LORA_ADAPTER_FILENAME,
+    LORA_CONFIG_FILENAME,
+    GenerationLoRAConfig,
+    load_adapter_state_dict,
+    read_lora_config,
+    write_lora_config,
+)
+
+
+CHECKPOINT_FORMAT_VERSION = 5
+TRAINING_CONTRACT_FILENAME = "datamake_online_training_contract.json"
+TRAINER_STATE_FILENAME = "trainer_state.json"
+COMPLETE_MARKER_FILENAME = "checkpoint_complete.json"
+OPTIMIZER_DCP_DIRNAME = "optimizer"
+ADAPTER_PARAMETER_STATE_KEY = "_datamake_parameter_value"
+
+
+def _rank() -> int:
+    return dist.get_rank() if dist.is_available() and dist.is_initialized() else 0
+
+
+def _world_size() -> int:
+    return dist.get_world_size() if dist.is_available() and dist.is_initialized() else 1
+
+
+def _barrier() -> None:
+    if dist.is_available() and dist.is_initialized():
+        dist.barrier()
+
+
+def _atomic_json(path: Path, value: Mapping[str, Any]) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(
+        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    os.replace(temporary, path)
+
+
+def _rng_state() -> Dict[str, Any]:
+    value: Dict[str, Any] = {
+        "python": random.getstate(),
+        "numpy": np.random.get_state(),
+        "torch_cpu": torch.get_rng_state(),
+    }
+    if torch.cuda.is_available():
+        value["torch_cuda"] = torch.cuda.get_rng_state()
+    return value
+
+
+def _restore_rng_state(value: Mapping[str, Any]) -> None:
+    random.setstate(value["python"])
+    np.random.set_state(value["numpy"])
+    torch.set_rng_state(value["torch_cpu"])
+    if torch.cuda.is_available() and "torch_cuda" in value:
+        torch.cuda.set_rng_state(value["torch_cuda"])
+
+
+def _validate_adapter_state(
+    state: Mapping[str, torch.Tensor], expected_tensor_count: int
+) -> None:
+    unexpected = sorted(
+        name
+        for name, value in state.items()
+        if not isinstance(value, torch.Tensor)
+        or not (name.endswith("lora_A") or name.endswith("lora_B"))
+    )
+    if len(state) != expected_tensor_count or unexpected:
+        raise RuntimeError(
+            "LoRA checkpoint topology mismatch: "
+            f"expected_tensors={expected_tensor_count}, actual_tensors={len(state)}, "
+            f"unexpected={unexpected[:20]}"
+        )
+
+
+def _materialize_adapter_safetensors(
+    optimizer_dcp_path: Path,
+    output_path: Path,
+    expected_tensor_count: int,
+) -> None:
+    """Consolidate live parameter values carried by the optimizer DCP."""
+
+    temporary = output_path.with_suffix(".torch.tmp")
+    dcp_to_torch_save(optimizer_dcp_path, temporary)
+    value = torch.load(temporary, map_location="cpu", weights_only=False)
+    temporary.unlink()
+    optimizer_state = value.get("optimizer")
+    if not isinstance(optimizer_state, dict):
+        raise RuntimeError("optimizer DCP did not materialize a state")
+    parameter_states = optimizer_state.get("state")
+    if not isinstance(parameter_states, dict):
+        raise RuntimeError("optimizer DCP has no parameter states")
+    adapter_state = {
+        name: state[ADAPTER_PARAMETER_STATE_KEY]
+        for name, state in parameter_states.items()
+        if ADAPTER_PARAMETER_STATE_KEY in state
+    }
+    _validate_adapter_state(adapter_state, expected_tensor_count)
+    save_file(
+        {
+            name: tensor.detach().cpu().contiguous()
+            for name, tensor in adapter_state.items()
+        },
+        str(output_path),
+    )
+
+
+def _inject_parameter_values(optimizer: torch.optim.Optimizer) -> int:
+    count = 0
+    for group in optimizer.param_groups:
+        for parameter in group["params"]:
+            state = optimizer.state[parameter]
+            if ADAPTER_PARAMETER_STATE_KEY in state:
+                raise RuntimeError("temporary adapter state was not cleared")
+            state[ADAPTER_PARAMETER_STATE_KEY] = parameter.detach().clone()
+            count += 1
+    return count
+
+
+def _remove_parameter_values(optimizer: torch.optim.Optimizer) -> None:
+    for group in optimizer.param_groups:
+        for parameter in group["params"]:
+            optimizer.state[parameter].pop(ADAPTER_PARAMETER_STATE_KEY, None)
+
+
+def _restore_parameter_values(optimizer: torch.optim.Optimizer) -> int:
+    count = 0
+    with torch.no_grad():
+        for group in optimizer.param_groups:
+            for parameter in group["params"]:
+                state = optimizer.state[parameter]
+                value = state.pop(ADAPTER_PARAMETER_STATE_KEY, None)
+                # With FSDP ``use_orig_params=True``, parameters outside this
+                # rank's flat-parameter shard are represented by empty local
+                # tensors and intentionally have no optimizer state to load.
+                if parameter.numel() == 0:
+                    count += 1
+                    continue
+                if value is None:
+                    raise RuntimeError("checkpoint optimizer state has no adapter value")
+                if value.shape != parameter.shape:
+                    raise RuntimeError(
+                        "adapter shard shape mismatch: "
+                        f"{tuple(value.shape)} != {tuple(parameter.shape)}"
+                    )
+                parameter.copy_(value.to(device=parameter.device, dtype=parameter.dtype))
+                count += 1
+    return count
+
+
+def _sharded_optimizer_state(
+    model: torch.nn.Module, optimizer: torch.optim.Optimizer
+) -> Dict[str, Any]:
+    options = StateDictOptions(
+        full_state_dict=False,
+        cpu_offload=True,
+        ignore_frozen_params=False,
+        strict=True,
+    )
+    return get_optimizer_state_dict(model, optimizer, options=options)
+
+
+def save_lora_checkpoint(
+    checkpoint_root: Path,
+    completed_steps: int,
+    model: torch.nn.Module,
+    optimizer: torch.optim.Optimizer,
+    scheduler,
+    lora_config: GenerationLoRAConfig,
+    training_contract: Mapping[str, Any],
+    trainer_state: Mapping[str, Any],
+    keep_last: int,
+    logger,
+) -> Path:
+    """Save adapter, optimizer/scheduler/cursor and RNG at an optimizer boundary."""
+
+    if completed_steps <= 0:
+        raise ValueError("completed_steps must be positive")
+    if keep_last < 1:
+        raise ValueError("keep_last must be positive")
+    checkpoint_root = checkpoint_root.resolve()
+    final_path = checkpoint_root / f"{completed_steps:07d}"
+    staging = checkpoint_root / f".{completed_steps:07d}.incomplete"
+    if _rank() == 0:
+        checkpoint_root.mkdir(parents=True, exist_ok=True)
+        if final_path.exists():
+            raise FileExistsError(final_path)
+        if staging.exists():
+            shutil.rmtree(staging)
+        staging.mkdir(parents=True)
+    _barrier()
+
+    # PyTorch's model-state paths returned stale original-parameter views for
+    # nested FSDP units. Optimizer-state mapping is live, so temporarily carry
+    # every local parameter shard through that proven mapping.
+    parameter_count = _inject_parameter_values(optimizer)
+    if parameter_count != 2 * lora_config.expected_target_modules:
+        raise RuntimeError(
+            f"optimizer has {parameter_count} trainable tensors; "
+            f"expected {2 * lora_config.expected_target_modules}"
+        )
+    try:
+        optimizer_state = _sharded_optimizer_state(model, optimizer)
+        dcp.save(
+            {"optimizer": optimizer_state},
+            checkpoint_id=str(staging / OPTIMIZER_DCP_DIRNAME),
+        )
+        del optimizer_state
+    finally:
+        _remove_parameter_values(optimizer)
+    _barrier()
+
+    if _rank() == 0:
+        _materialize_adapter_safetensors(
+            staging / OPTIMIZER_DCP_DIRNAME,
+            staging / LORA_ADAPTER_FILENAME,
+            expected_tensor_count=2 * lora_config.expected_target_modules,
+        )
+        write_lora_config(str(staging / LORA_CONFIG_FILENAME), lora_config)
+        _atomic_json(staging / TRAINING_CONTRACT_FILENAME, training_contract)
+    _barrier()
+
+    rng_path = staging / f"rng.rank-{_rank():05d}-of-{_world_size():05d}.pt"
+    torch.save(_rng_state(), rng_path)
+    if _rank() == 0:
+        torch.save(scheduler.state_dict(), staging / "scheduler.pt")
+        state = {
+            **dict(trainer_state),
+            "checkpoint_format_version": CHECKPOINT_FORMAT_VERSION,
+            "completed_steps": int(completed_steps),
+            "next_step": int(completed_steps),
+            "world_size": _world_size(),
+            "optimizer_boundary": True,
+        }
+        _atomic_json(staging / TRAINER_STATE_FILENAME, state)
+    _barrier()
+
+    if _rank() == 0:
+        required = [
+            LORA_ADAPTER_FILENAME,
+            LORA_CONFIG_FILENAME,
+            TRAINING_CONTRACT_FILENAME,
+            TRAINER_STATE_FILENAME,
+            "scheduler.pt",
+            *[
+                f"rng.rank-{rank:05d}-of-{_world_size():05d}.pt"
+                for rank in range(_world_size())
+            ],
+        ]
+        missing = [
+            value
+            for value in required
+            if not (staging / value).is_file() or (staging / value).stat().st_size <= 0
+        ]
+        optimizer_files = [
+            path
+            for path in (staging / OPTIMIZER_DCP_DIRNAME).rglob("*")
+            if path.is_file() and path.stat().st_size > 0
+        ]
+        if missing or not optimizer_files:
+            raise RuntimeError(
+                f"incomplete LoRA checkpoint: missing={missing}, "
+                f"optimizer_files={len(optimizer_files)}"
+            )
+        marker = {
+            "status": "complete",
+            "checkpoint_format_version": CHECKPOINT_FORMAT_VERSION,
+            "completed_steps": int(completed_steps),
+            "next_step": int(completed_steps),
+            "world_size": _world_size(),
+            "adapter_only": True,
+            "base_weights_stored": False,
+            "required_artifact_sizes": {
+                value: (staging / value).stat().st_size for value in required
+            },
+            "optimizer_dcp_file_count": len(optimizer_files),
+        }
+        _atomic_json(staging / COMPLETE_MARKER_FILENAME, marker)
+        os.replace(staging, final_path)
+
+        complete = sorted(
+            (
+                path
+                for path in checkpoint_root.iterdir()
+                if path.is_dir()
+                and path.name.isdigit()
+                and (path / COMPLETE_MARKER_FILENAME).is_file()
+            ),
+            key=lambda path: int(path.name),
+        )
+        for stale in complete[:-keep_last]:
+            logger.info(f"Removing adapter checkpoint outside retention: {stale}")
+            shutil.rmtree(stale)
+    _barrier()
+    return final_path
+
+
+def validate_lora_checkpoint(
+    checkpoint: Path,
+    expected_world_size: int,
+    expected_contract: Optional[Mapping[str, Any]] = None,
+) -> Dict[str, Any]:
+    checkpoint = checkpoint.resolve()
+    marker_path = checkpoint / COMPLETE_MARKER_FILENAME
+    if not marker_path.is_file():
+        raise ValueError(f"checkpoint has no complete marker: {checkpoint}")
+    marker = json.loads(marker_path.read_text(encoding="utf-8"))
+    if marker.get("status") != "complete" or not marker.get("adapter_only"):
+        raise ValueError("checkpoint is not a complete adapter-only checkpoint")
+    if int(marker.get("checkpoint_format_version", -1)) != CHECKPOINT_FORMAT_VERSION:
+        raise ValueError(
+            f"checkpoint format must be v{CHECKPOINT_FORMAT_VERSION}; "
+            "older nested-FSDP adapter exports are not resumable"
+        )
+    if int(marker.get("world_size", -1)) != int(expected_world_size):
+        raise ValueError("checkpoint world size differs from current FSDP topology")
+    for value, size in marker.get("required_artifact_sizes", {}).items():
+        path = checkpoint / value
+        if not path.is_file() or path.stat().st_size != int(size):
+            raise ValueError(f"checkpoint artifact differs from marker: {path}")
+    if not (checkpoint / OPTIMIZER_DCP_DIRNAME / ".metadata").is_file():
+        raise ValueError("checkpoint optimizer DCP metadata is missing")
+    if expected_contract is not None:
+        actual_contract = json.loads(
+            (checkpoint / TRAINING_CONTRACT_FILENAME).read_text(encoding="utf-8")
+        )
+        if actual_contract != dict(expected_contract):
+            raise ValueError("checkpoint training contract differs from current run")
+    return marker
+
+
+def load_lora_checkpoint(
+    checkpoint: Path,
+    model: torch.nn.Module,
+    optimizer: torch.optim.Optimizer,
+    scheduler,
+    lora_config: GenerationLoRAConfig,
+    training_contract: Mapping[str, Any],
+) -> Dict[str, Any]:
+    """Strictly restore adapter, optimizer, scheduler, cursor and per-rank RNG."""
+
+    checkpoint = checkpoint.resolve()
+    validate_lora_checkpoint(checkpoint, _world_size(), training_contract)
+    if read_lora_config(str(checkpoint / LORA_CONFIG_FILENAME)) != lora_config:
+        raise ValueError("checkpoint LoRA topology differs from current run")
+
+    optimizer_state = _sharded_optimizer_state(model, optimizer)
+    state = {"optimizer": optimizer_state}
+    dcp.load(state, checkpoint_id=str(checkpoint / OPTIMIZER_DCP_DIRNAME))
+    set_optimizer_state_dict(model, optimizer, state["optimizer"])
+
+    # The empty AdamW skeleton loads its standard fields but not the custom
+    # parameter-value field. Build a second skeleton from the restored state so
+    # DCP can map that field back to each live local shard as well.
+    parameter_count = _inject_parameter_values(optimizer)
+    if parameter_count != 2 * lora_config.expected_target_modules:
+        raise RuntimeError("optimizer tensor count differs from LoRA topology")
+    adapter_restore_state = _sharded_optimizer_state(model, optimizer)
+    adapter_holder = {"optimizer": adapter_restore_state}
+    try:
+        # Nested FSDP may return optimizer-state views which share dictionaries
+        # with ``optimizer.state``. Keep the temporary key alive until DCP has
+        # populated and installed the restored shards.
+        dcp.load(
+            adapter_holder,
+            checkpoint_id=str(checkpoint / OPTIMIZER_DCP_DIRNAME),
+        )
+        set_optimizer_state_dict(model, optimizer, adapter_holder["optimizer"])
+        parameter_count = _restore_parameter_values(optimizer)
+    finally:
+        _remove_parameter_values(optimizer)
+    if parameter_count != 2 * lora_config.expected_target_modules:
+        raise RuntimeError("restored adapter tensor count differs from LoRA topology")
+    scheduler.load_state_dict(
+        torch.load(checkpoint / "scheduler.pt", weights_only=True, map_location="cpu")
+    )
+    rng = torch.load(
+        checkpoint / f"rng.rank-{_rank():05d}-of-{_world_size():05d}.pt",
+        weights_only=False,
+        map_location="cpu",
+    )
+    _restore_rng_state(rng)
+    trainer_state = json.loads(
+        (checkpoint / TRAINER_STATE_FILENAME).read_text(encoding="utf-8")
+    )
+    return trainer_state
+
+
+def load_unwrapped_adapter(checkpoint: Path, model: torch.nn.Module) -> None:
+    """Small helper used by CPU tests and non-FSDP adapter export consumers."""
+
+    state = load_file(str(checkpoint / LORA_ADAPTER_FILENAME), device="cpu")
+    load_adapter_state_dict(model, state)
