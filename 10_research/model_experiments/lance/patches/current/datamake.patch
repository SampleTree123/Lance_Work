+            sum(a.elapsed_time(b) for a, b, _ in phase_events) / 1000,
+            sum(b.elapsed_time(c) for _, b, c in phase_events) / 1000,
+            sum(a.elapsed_time(b) for a, b in backward_events) / 1000,
+            sum(a.elapsed_time(b) for a, b in vit_events if b is not None) / 1000,
+            sum(a.elapsed_time(b) for a, b in history_events) / 1000], device=device)
+        dist.all_reduce(timing, op=dist.ReduceOp.MAX)
+        value = aggregate.tolist()
+        mse = value[0] / global_tokens
+        exposures = completed * profile["run"]["global_batch_size"]
+        if args.single_gpu_probe:
+            exposures = sum(chains[index]["targets"] for w in windows[:completed] for _, index in w[rank])
+        report = {
+            "backend": "ddp", "diagnostic_only": args.single_gpu_probe,
+            "actual_world_size": world, "activation_checkpointing": checkpoint_mode,
+            "checkpoint_disabled_layers": sorted(disabled_layers), "per_rank_batch_size": 1,
+            "vae_cache_policy": profile["ddp"].get("vae_cache_policy", "release"),
+            "attention_padding": profile["ddp"].get("attention_padding", "fixed"),
+            "sampling": "whole_chain_fixed_target_window_v1", "optimizer_step": completed,
+            "train/loss": mse * training_args.mse_weight, "train/mse": mse,
+            "train/ce": 0.0, "train/grad_norm": float(grad_norm), "train/lr": lr_used,
+            "train/next_lr": optimizer.param_groups[0]["lr"], "train/target_exposures": exposures,
+            "train/targets_this_update": global_targets, "train/history_generated_rounds": value[5],
+            "train/history_extra_model_forwards": 0, "train/history_detached": 1.0,
+            "train/attention_tokens": value[3] / global_targets,
+            "train/attention_padding_tokens": value[4] / global_targets,
+            "perf/step_time": step_time.item(), "perf/target_videos_per_second": global_targets / step_time.item(),
+            "perf/mse_tokens": global_tokens, "perf/peak_allocated_gib": memory[0].item() / 2**30,
+            "perf/peak_reserved_gib": memory[1].item() / 2**30,
+            **{f"perf/{key}": v for key, v in zip(("data_wait_seconds", "vae_region_seconds", "model_forward_seconds",
+                "backward_sync_seconds", "vit_seconds", "history_decode_seconds"), timing.tolist())},
+        }
+        for k in range(1, 6):
+            offset = 6 + 3 * (k - 1)
+            report[f"train/round_{k}_targets"] = value[offset + 2]
+            if value[offset + 1]:
+                report[f"train/round_{k}_mse"] = value[offset] / value[offset + 1]
+        del window
+        if rank == 0:
+            log(json.dumps(report, sort_keys=True))
+            with (run_dir / "metrics.jsonl").open("a") as stream:
+                stream.write(json.dumps(report) + "\n")
+            if wb:
+                wb.log(report)
+        # Only the short smoke writes per-rank sample IDs/loss for comparison.
+        if args.smoke:
+            with (run_dir / f"trace.rank-{rank}.jsonl").open("a") as stream:
+                stream.write(json.dumps({"step": completed, "sample_ids": sample_ids,
+                                         "loss": mse * training_args.mse_weight, "sampling_instances": instance_ids,
+                                         "peak_allocated_gib": torch.cuda.max_memory_allocated(device) / 2**30,
+                                         "peak_reserved_gib": torch.cuda.max_memory_reserved(device) / 2**30}) + "\n")
+        requested_stop = save_and_stop_requested(run_dir, device)
+        save = requested_stop or completed % profile["checkpoint"]["completed_step_interval"] == 0
+        save |= completed == stop and (args.smoke or profile["checkpoint"]["save_final_checkpoint"])
+        if save and not args.single_gpu_probe and not args.benchmark_only:
+            saved = save_ddp_checkpoint(
+                run_dir / "checkpoints", completed, bare_model, optimizer, scheduler,
+                lora_config, contract, completed,
+                keep_last=profile["checkpoint"]["keep_last_complete"],
+            )
+            log(f"Complete adapter/Adam/scheduler/RNG/cursor checkpoint: {saved}")
+        if profiler is not None and completed >= min(next_step + 2, stop):
+            profiler.stop()
+            profiler.export_chrome_trace(str(run_dir / f"profile.rank-{rank}.json"))
+            profiler = None
+        if requested_stop:
+            if rank == 0:
+                (run_dir / "SAVE_AND_STOP").unlink(missing_ok=True)
+            dist.barrier()
+            log(f"SAVE_AND_STOP completed after optimizer step {completed}")
+            break
+    if profiler is not None:
+        profiler.stop()
+        profiler.export_chrome_trace(str(run_dir / f"profile.rank-{rank}.json"))
+    if wb:
+        wb.finish()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
