+"""Optimizer initialization and coordinated stop, shared by current DDP trainers."""
+from pathlib import Path
+import torch
+
+def save_and_stop_requested(run_dir, device):
+    """Poll only at an optimizer boundary; rank 0 owns the shared decision.
+
+    Keep the request file until the complete checkpoint has been saved. Do not
+    invoke FSDP checkpoint collectives from a signal handler or a worker thread.
+    """
+    request = Path(run_dir) / "SAVE_AND_STOP"
+    requested = request.is_file() if torch.distributed.get_rank() == 0 else False
+    flag = torch.tensor(int(requested), device=device, dtype=torch.int32)
+    torch.distributed.broadcast(flag, src=0)
+    return bool(flag.item())
+
+def initialize_adam_state(optimizer):
+    """Allocate Adam's exact step-0 state, including currently unused adapters.
+
+    Final-layer UND outputs may have no loss path with CE disabled. Explicit
+    zero state makes their DCP schema stable; no fictitious optimizer update or
+    gradient is introduced. Empty local FSDP parameter shards need no state.
+    """
+    for group in optimizer.param_groups:
+        for parameter in group["params"]:
+            if parameter.numel() and not optimizer.state[parameter]:
+                optimizer.state[parameter] = {
+                    "step": torch.tensor(0., dtype=torch.float32),
+                    "exp_avg": torch.zeros_like(parameter),
+                    "exp_avg_sq": torch.zeros_like(parameter),
+                }
