@@ -0,0 +1,382 @@
+"""PEFT/DDP Stage6 recipe, optional activation recomputation and phase timing."""
+import argparse
+from copy import deepcopy
+from dataclasses import asdict
+import functools
+from contextlib import nullcontext
+from torch.nn.parallel import DistributedDataParallel as DDP
+import json
+from pathlib import Path
+import sys
+from time import perf_counter
+
+import torch
+import torch.distributed as dist
+from torch.utils.data import DataLoader
+from torch.distributed.algorithms._checkpoint.checkpoint_wrapper import (
+    CheckpointImpl, apply_activation_checkpointing, checkpoint_wrapper,
+)
+from transformers import HfArgumentParser, set_seed
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts"))
+from run_datamake_ddp_training import load_profile, make_contract
+from datamake_runtime import build_torchrun_command
+from config.config_factory import ModelArguments, DataArguments, TrainingArguments
+from common.utils.logging import get_logger
+from common.val.utils import make_padded_latent
+from data.dataset_base_train import PackedDataset, simple_custom_collate
+from data.data_utils import add_special_tokens
+from modeling.lance import Lance, LanceConfig
+from modeling.qwen2 import Qwen2Tokenizer
+from train.fsdp_utils import grad_checkpoint_check_fn
+from train.train_utils import (
+    prepare_model_paths, setup_model_components, prepare_checkpoint_loader,
+    build_lr_scheduler, build_train_dataset_config,
+    get_image_token_id, build_edit_region_mse_weights, compute_training_loss,
+)
+from train.datamake_lora_config import config_from_profile
+from train.datamake_peft import inject
+from train.datamake_train_state import initialize_adam_state, save_and_stop_requested
+from train.datamake_ddp_checkpoint import save as save_ddp_checkpoint, load as load_ddp_checkpoint
+from train.datamake_prefix_data import IndexedPrefixDataset
+from train.datamake_packed_batch import IndexedPackedPrefixDataset, compute_packed_training_loss, trim_attention_padding
+
+
+def recipe_arguments(profile):
+    # Reuse Stage2's exact mapping of model/data/optimizer settings, without
+    # running its full-parameter-only launcher or modifying its frozen files.
+    argument_profile = deepcopy(profile)
+    argument_profile["run"]["gradient_accumulation_steps"] *= argument_profile["run"]["per_rank_batch_size"]
+    argument_profile["run"]["per_rank_batch_size"] = 1
+    command = build_torchrun_command(argument_profile, None, 29500)
+    argv = command[command.index("train/unified_train.py") + 1:]
+    return HfArgumentParser((ModelArguments, DataArguments, TrainingArguments)).parse_args_into_dataclasses(argv)
+
+
+def microbatch_loss(batch, model, vae, model_args, training_args, device, world, phase_events, empty_vae_cache=True, attention_padding="fixed"):
+    data = batch.cuda(device).to_dict()
+    if attention_padding == "minimal":
+        data = trim_attention_padding(data)
+    indexes = data.pop("batch_data_indexes")
+    ce_weights = data.pop("ce_loss_weights", None)
+    roles = data.pop("vae_edit_roles")
+    slot_counts = data.pop("mse_slot_counts", None)
+    e0, e1, e2 = [torch.cuda.Event(enable_timing=True) for _ in range(3)]
+    e0.record()
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        mode, videos = data.pop("vae_data_mode"), data.pop("padded_videos")
+        with torch.no_grad():
+            data["padded_latent"] = make_padded_latent(videos, mode, vae, empty_cache=empty_vae_cache)
+            weights = build_edit_region_mse_weights(
+                data["padded_latent"], data["patchified_vae_latent_shapes"], roles,
+                model_args.latent_patch_size, training_args.edit_region_weight_boost,
+                training_args.edit_region_low_quantile, training_args.edit_region_high_quantile,
+            ) if training_args.edit_region_weighting else None
+        e1.record()
+        data.pop("padded_videos_vit", None)
+        losses = model(**data)
+        e2.record()
+    phase_events.append((e0, e1, e2))
+    if slot_counts is None:
+        loss, metrics, _, total_tokens = compute_training_loss(
+            losses, data, ce_weights, training_args, device, world, weights,
+        )
+    else:
+        loss, metrics, _, total_tokens = compute_packed_training_loss(
+            losses, slot_counts, training_args, weights,
+        )
+    metrics['attention_tokens'] = loss.new_tensor(sum(data['sample_lens']))
+    metrics['attention_padding_tokens'] = loss.new_tensor(data['sample_lens'][-1])
+    return loss, metrics, total_tokens, indexes
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--run-dir", type=Path, required=True)
+    parser.add_argument("--resume-from", type=Path)
+    parser.add_argument("--stop-after", type=int)
+    parser.add_argument("--smoke", action="store_true")
+    parser.add_argument("--benchmark-only", action="store_true", help="Smoke timing without checkpoint writes")
+    parser.add_argument("--trace", action="store_true", help="Capture first two optimizer updates; benchmark only")
+    parser.add_argument("--single-gpu-probe", action="store_true", help="Diagnostic only: rank0's unchanged four-rank data schedule, no training checkpoints")
+    parser.add_argument("--probe-backend", choices=("ddp",), default="ddp")
+    args = parser.parse_args()
+    if args.benchmark_only and (not args.smoke or args.resume_from):
+        raise ValueError("Benchmark-only requires fresh smoke mode")
+    profile = load_profile(args.profile)
+    if profile["ddp"].get("attention_padding", "fixed") == "minimal":
+        # Configure the official compiler only in this DDP process. Automatic
+        # dynamic generalization changes BF16 results when padding lengths vary;
+        # static shape caching preserves the validated attention numerics.
+        from torch.nn.attention.flex_attention import flex_attention
+        from modeling.lance import qwen2_navit
+        qwen2_navit.flex_attention = torch.compile(flex_attention, dynamic=False)
+    model_args, data_args, training_args = recipe_arguments(profile)
+    torch.set_num_threads(1)
+    torch.set_num_interop_threads(1)
+    device = int(__import__("os").environ["LOCAL_RANK"])
+    torch.cuda.set_device(device)
+    dist.init_process_group("nccl", device_id=torch.device("cuda", device))
+    rank, world = dist.get_rank(), dist.get_world_size()
+    if args.single_gpu_probe and (world != 1 or not args.smoke or args.resume_from):
+        raise ValueError("Single-GPU probe requires world1, smoke mode and fresh initialization")
+    if args.probe_backend != "ddp" and not args.single_gpu_probe:
+        raise ValueError("FSDP comparison is diagnostic only")
+    if not args.single_gpu_probe and world != profile["distributed"]["gpus_per_node"]:
+        raise ValueError(f"Expected {profile['distributed']['gpus_per_node']} GPUs, got {world}")
+    logger = get_logger()
+    log = logger.info if rank == 0 else lambda *_: None
+    run_dir = args.run_dir.resolve()
+    if rank == 0:
+        (run_dir / "configs").mkdir(parents=True, exist_ok=True)
+        (run_dir / "configs" / "profile.json").write_text(json.dumps(profile, indent=2) + "\n")
+    dist.barrier()
+    training_args.config_dir = str(run_dir / "configs")
+    training_args.N_key_frame = data_args.N_key_frame
+    training_args.incre_time_pro = data_args.incre_time_pro
+    set_seed(training_args.global_seed * world + rank)
+    prepare_model_paths(model_args, training_args)
+    llm_config, language, vit_config, vit, vae, vae_config = setup_model_components(model_args, training_args, log)
+    config = LanceConfig(
+        visual_gen=True, visual_und=True, llm_config=llm_config,
+        vit_config=vit_config, vae_config=vae_config,
+        latent_patch_size=model_args.latent_patch_size,
+        max_num_frames=model_args.max_num_frames, max_latent_size=model_args.max_latent_size,
+        vit_max_num_patch_per_side=model_args.vit_max_num_patch_per_side,
+        connector_act=model_args.connector_act, interpolate_pos=model_args.interpolate_pos,
+        timestep_shift=training_args.timestep_shift,
+    )
+    model = Lance(language_model=language, vit_model=vit, vit_type=model_args.vit_type,
+                  config=config, training_args=training_args)
+    tokenizer, token_ids, num_new_tokens = add_special_tokens(Qwen2Tokenizer.from_pretrained(model_args.model_path))
+    load_base = prepare_checkpoint_loader(
+        model_args, training_args, llm_config, language, tokenizer,
+        num_new_tokens, log, report_dir=training_args.config_dir,
+    )
+    load_base(model)  # Mandatory ordering: base -> adapter -> distributed wrapper.
+    lora_config = config_from_profile(profile)
+    targets = inject(model, lora_config, training_args.global_seed)
+    # Match FSDP BF16 compute without FP32 base masters/parameter collectives.
+    for p in model.parameters():
+        if not p.requires_grad and p.is_floating_point():
+            p.data = p.data.to(torch.bfloat16)
+    model.to(device)
+    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
+    log(f"PEFT/DDP targets={len(targets)} trainable_parameters={trainable} FP32 master; freeze_und=False")
+    if rank == 0:
+        (run_dir / "configs" / "lora_targets.json").write_text(json.dumps(targets, indent=2) + "\n")
+    image_token_id = get_image_token_id(language)
+    checkpoint_mode = profile["ddp"]["activation_checkpointing"]
+    disabled_layers = set(profile["ddp"].get("checkpoint_disabled_layers", []))
+    def checkpoint_layer(module):
+        if checkpoint_mode == "none" or not grad_checkpoint_check_fn(module):
+            return False
+        if checkpoint_mode == "all":
+            index = getattr(getattr(module, "self_attn", None), "layer_idx", None)
+            return index not in disabled_layers
+        index = getattr(getattr(module, "self_attn", None), "layer_idx", None)
+        return index is not None and index % 2 == 0
+    apply_activation_checkpointing(
+        model, checkpoint_wrapper_fn=functools.partial(checkpoint_wrapper, checkpoint_impl=CheckpointImpl.NO_REENTRANT),
+        check_fn=checkpoint_layer,
+    )
+    bare_model = model
+    # Final UND adapters can be unused. Keep detection enabled until separately validated.
+    model = DDP(model, device_ids=[device], broadcast_buffers=False,
+                find_unused_parameters=True, gradient_as_bucket_view=True)
+    vit_events = []
+    def vit_pre(*_):
+        start = torch.cuda.Event(enable_timing=True)
+        start.record()
+        vit_events.append([start, None])
+    def vit_post(*_):
+        end = torch.cuda.Event(enable_timing=True)
+        end.record()
+        vit_events[-1][1] = end
+    bare_model.vit_model.register_forward_pre_hook(vit_pre)
+    bare_model.vit_model.register_forward_hook(vit_post)
+    optimizer = torch.optim.AdamW(
+        [p for p in model.parameters() if p.requires_grad], lr=training_args.lr,
+        betas=(training_args.beta1, training_args.beta2), eps=training_args.eps,
+        weight_decay=profile["optimization"]["weight_decay"],
+    )
+    initialize_adam_state(optimizer)
+    scheduler = build_lr_scheduler(optimizer, training_args)
+    accumulation = profile["run"]["gradient_accumulation_steps"]
+    batch_size = profile["run"]["per_rank_batch_size"]
+    prefixes_per_update = accumulation * batch_size
+    total_steps = profile["run"]["total_steps"]
+    stop = args.stop_after or total_steps
+    if not 0 < stop <= total_steps:
+        raise ValueError("stop-after must not change the profile's scheduler horizon")
+    contract = make_contract(profile)
+    if args.single_gpu_probe:
+        contract = {**contract, "diagnostic_only": True, "actual_world_size": 1}
+    # Dataset construction is before RNG restoration. The loader gets its own
+    # generator; prefetch never advances the saved consumed-sample cursor.
+    dataset_config = build_train_dataset_config(data_args, model_args, training_args, vae_config)
+    packer = PackedDataset(
+        dataset_config, tokenizer=tokenizer, special_tokens=token_ids,
+        local_rank=rank, world_size=profile["distributed"]["gpus_per_node"], interpolate_pos=model_args.interpolate_pos,
+        use_flex=True, data_status=None, apply_chat_template=False,
+        image_token_id=image_token_id, cfg_type=training_args.cfg_type,
+        cfg_uncond_token_id=training_args.cfg_uncond_token_id, **asdict(data_args),
+    )
+    packer.set_epoch(data_args.data_seed)
+    dataset = (IndexedPrefixDataset(packer, total_steps * prefixes_per_update, data_args.data_seed)
+               if batch_size == 1 else IndexedPackedPrefixDataset(
+                   packer, total_steps * prefixes_per_update, data_args.data_seed, batch_size))
+    next_step = 0
+    if args.resume_from:
+        state = json.loads((args.resume_from / "trainer_state.json").read_text())
+        next_step = state["next_step"]
+        if state["next_microstep"] != next_step * prefixes_per_update:
+            raise ValueError("Checkpoint is not at the expected accumulation boundary")
+    loader = DataLoader(
+        dataset, batch_size=1, sampler=range(next_step * accumulation, stop * accumulation),
+        num_workers=data_args.num_workers, pin_memory=True, collate_fn=simple_custom_collate,
+        prefetch_factor=data_args.prefetch_factor if data_args.num_workers else None,
+        multiprocessing_context="spawn" if data_args.num_workers else None,
+        generator=torch.Generator().manual_seed(data_args.data_seed),
+    )
+    wb = None
+    if rank == 0 and not args.smoke:
+        import wandb
+        cfg = profile["wandb"]
+        wb = wandb.init(project=cfg["project"], entity=cfg["entity"], id=cfg["run_id"],
+                        name=profile["run"]["run_name"], group=cfg["group"], tags=cfg["tags"],
+                        job_type=cfg["job_type"], mode=cfg["mode"], resume="allow",
+                        config=profile, dir=str(run_dir), save_code=False)
+        wb.define_metric("optimizer_step")
+        wb.define_metric("train/*", step_metric="optimizer_step")
+        wb.define_metric("perf/*", step_metric="optimizer_step")
+    model.train()
+    optimizer.zero_grad(set_to_none=True)
+    iterator = iter(loader)
+    # W&B and worker startup must not perturb restored model/noise RNG.
+    set_seed(training_args.global_seed * world + rank)
+    if args.resume_from:
+        load_ddp_checkpoint(args.resume_from, bare_model, optimizer, scheduler, contract)
+    if args.trace and not args.smoke:
+        raise ValueError("Profiler capture is restricted to smoke/benchmark runs")
+    profiler = None
+    if args.trace:
+        profiler = torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CPU, torch.profiler.ProfilerActivity.CUDA],
+                                          record_shapes=True)
+        profiler.start()
+    for step in range(next_step, stop):
+        torch.cuda.synchronize(device)
+        start = perf_counter()
+        torch.cuda.reset_peak_memory_stats(device)
+        totals, sample_ids, tokens = {}, [], 0
+        phase_events, backward_events, data_wait = [], [], 0.0
+        vit_events.clear()
+        lr_used = optimizer.param_groups[0]["lr"]
+        for micro in range(accumulation):
+            waiting = perf_counter()
+            batch = next(iterator)
+            data_wait += perf_counter() - waiting
+            # DDP requires both forward and backward inside no_sync().
+            context = model.no_sync() if micro + 1 < accumulation else nullcontext()
+            with context:
+                loss, metrics, count, indexes = microbatch_loss(
+                    batch, model, vae, model_args, training_args, device, world, phase_events,
+                    empty_vae_cache=profile["ddp"].get("vae_cache_policy", "release") == "release",
+                    attention_padding=profile["ddp"].get("attention_padding", "fixed"))
+                bad = (~torch.isfinite(loss.detach())).int()
+                dist.all_reduce(bad, op=dist.ReduceOp.MAX)
+                if bad.item():
+                    raise FloatingPointError(f"Nonfinite loss at optimizer step {step + 1}")
+                e0, e1 = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+                e0.record()
+                (loss / accumulation).backward()
+                e1.record()
+                backward_events.append((e0, e1))
+            for key, value in {**metrics, "loss": loss.detach()}.items():
+                totals[key] = totals.get(key, 0) + value.detach().float() / accumulation
+            tokens += int(count)
+            sample_ids.extend(item["sample_id"] for item in indexes)
+            del loss, metrics, batch
+        grad_norm = (torch.nn.utils.clip_grad_norm_([p for p in bare_model.parameters() if p.requires_grad], training_args.max_grad_norm))
+        if not torch.isfinite(grad_norm):
+            raise FloatingPointError("Nonfinite gradient norm")
+        optimizer.step()
+        scheduler.step()
+        optimizer.zero_grad(set_to_none=True)
+        completed = step + 1
+        torch.cuda.synchronize(device)
+        step_time = torch.tensor(perf_counter() - start, device=device)
+        dist.all_reduce(step_time, op=dist.ReduceOp.MAX)
+        for value in totals.values():
+            dist.all_reduce(value)
+            value.div_(world)
+        memory = torch.tensor([torch.cuda.max_memory_allocated(device), torch.cuda.max_memory_reserved(device)], device=device)
+        dist.all_reduce(memory, op=dist.ReduceOp.MAX)
+        timing = torch.tensor([
+            data_wait,
+            sum(a.elapsed_time(b) for a, b, _ in phase_events) / 1000,
+            sum(b.elapsed_time(c) for _, b, c in phase_events) / 1000,
+            sum(a.elapsed_time(b) for a, b in backward_events) / 1000,
+            sum(a.elapsed_time(b) for a, b in vit_events if b is not None) / 1000,
+        ], device=device)
+        dist.all_reduce(timing, op=dist.ReduceOp.MAX)
+        report = {
+            "backend": args.probe_backend, "diagnostic_only": args.single_gpu_probe,
+            "actual_world_size": world, "activation_checkpointing": checkpoint_mode,
+            "checkpoint_disabled_layers": sorted(disabled_layers), "per_rank_batch_size": batch_size,
+            "vae_cache_policy": profile["ddp"].get("vae_cache_policy", "release"),
+            "attention_padding": profile["ddp"].get("attention_padding", "fixed"),
+            **{f"perf/{key}": value for key, value in zip(
+                ("data_wait_seconds", "vae_region_seconds", "model_forward_seconds", "backward_sync_seconds", "vit_seconds"), timing.tolist())},
+            "optimizer_step": completed, **{f"train/{k}": v.item() for k, v in totals.items()},
+            "train/grad_norm": float(grad_norm), "train/lr": lr_used,
+            "train/next_lr": optimizer.param_groups[0]["lr"],
+            "train/target_exposures": completed * world * prefixes_per_update,
+            "perf/step_time": step_time.item(), "perf/target_videos_per_second": world * prefixes_per_update / step_time.item(),
+            "perf/mse_tokens": tokens, "perf/peak_allocated_gib": memory[0].item() / 2**30,
+            "perf/peak_reserved_gib": memory[1].item() / 2**30,
+        }
+        if rank == 0:
+            log(json.dumps(report, sort_keys=True))
+            with (run_dir / "metrics.jsonl").open("a") as stream:
+                stream.write(json.dumps(report) + "\n")
+            if wb:
+                wb.log(report)
+        # Only the short smoke writes per-rank sample IDs/loss for comparison.
+        if args.smoke:
+            with (run_dir / f"trace.rank-{rank}.jsonl").open("a") as stream:
+                stream.write(json.dumps({"step": completed, "sample_ids": sample_ids,
+                                         "loss": totals["loss"].item(),
+                                         "peak_allocated_gib": torch.cuda.max_memory_allocated(device) / 2**30,
+                                         "peak_reserved_gib": torch.cuda.max_memory_reserved(device) / 2**30}) + "\n")
+        requested_stop = save_and_stop_requested(run_dir, device)
+        save = requested_stop or completed % profile["checkpoint"]["completed_step_interval"] == 0
+        save |= completed == stop and (args.smoke or profile["checkpoint"]["save_final_checkpoint"])
+        if save and not args.single_gpu_probe and not args.benchmark_only:
+            saved = save_ddp_checkpoint(
+                run_dir / "checkpoints", completed, bare_model, optimizer, scheduler,
+                lora_config, contract, completed * prefixes_per_update,
+                keep_last=profile["checkpoint"]["keep_last_complete"],
+            )
+            log(f"Complete adapter/Adam/scheduler/RNG/cursor checkpoint: {saved}")
+        if profiler is not None and completed >= min(next_step + 2, stop):
+            profiler.stop()
+            profiler.export_chrome_trace(str(run_dir / f"profile.rank-{rank}.json"))
+            profiler = None
+        if requested_stop:
+            if rank == 0:
+                (run_dir / "SAVE_AND_STOP").unlink(missing_ok=True)
+            dist.barrier()
+            log(f"SAVE_AND_STOP completed after optimizer step {completed}")
+            break
+    if profiler is not None:
+        profiler.stop()
+        profiler.export_chrome_trace(str(run_dir / f"profile.rank-{rank}.json"))
+    if wb:
+        wb.finish()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
