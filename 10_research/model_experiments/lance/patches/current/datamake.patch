+"""Detached one-step flow history; no dependency on historical training loops."""
+from typing import Any, Mapping
+import torch
+
+def predict_clean_latent_patches(loss_dict: Mapping[str, Any]) -> torch.Tensor:
+    """Recover detached clean-latent patches from Lance flow intermediates."""
+
+    noisy = loss_dict.get("flow_noisy_target")
+    velocity = loss_dict.get("flow_pred_velocity")
+    timesteps = loss_dict.get("flow_timesteps")
+    if not all(isinstance(value, torch.Tensor) for value in (noisy, velocity, timesteps)):
+        raise RuntimeError("one-step history requires flow intermediates")
+    if noisy.shape != velocity.shape or timesteps.shape != noisy.shape[:1]:
+        raise RuntimeError("flow intermediate shapes do not align")
+    return (noisy - timesteps[:, None] * velocity).detach()
diff --git a/train/datamake_generation_lora.py b/train/datamake_generation_lora.py
new file mode 100644
index 0000000..1e8738b
--- /dev/null
+++ b/train/datamake_generation_lora.py
@@ -0,0 +1,372 @@
+# coding: utf-8
+
+"""DataMake LoRA support restricted to Lance's visual-generation branch.
+
+The released Lance training tree does not provide a LoRA implementation.  This
+module deliberately targets only generation-side ``nn.Linear`` modules:
+
+* the 36 decoder layers' ``*_moe_gen`` attention and MLP projections; and
+* optionally the VAE/time input-output projections owned by visual generation.
+
+All pre-existing parameters are frozen before adapters are attached.  The
+understanding experts, ViT, connector, embeddings, generation base weights and
+VAE therefore stay immutable; only ``lora_A`` and ``lora_B`` are trainable.
+
+LoRA checkpoints keep the wrapped module topology instead of silently merging
+adapters.  ``datamake_lora_config.json`` is consequently part of the checkpoint
+contract: exact training resume and inference attach the same wrappers to an
+explicit immutable base before loading ``adapter.safetensors``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import hashlib
+import json
+import math
+import os
+from typing import Dict, List, Mapping, Optional, Tuple
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+
+
+
+
+
+from train.datamake_lora_config import (
+    GENERATION_EXPERT_SUFFIXES, GENERATION_IO_NAMES, GenerationLoRAConfig, LORA_ADAPTER_FILENAME, LORA_CONFIG_FILENAME, LORA_SCHEMA_VERSION, OFFICIAL_VIDEO_GENERATION_TARGET_SIGNATURE,
+)
+
+
+class LoRALinear(nn.Module):
+    """A frozen ``nn.Linear`` plus a trainable low-rank residual."""
+
+    def __init__(
+        self,
+        base_layer: nn.Linear,
+        rank: int,
+        alpha: float,
+        dropout: float,
+    ) -> None:
+        super().__init__()
+        if not isinstance(base_layer, nn.Linear):
+            raise TypeError(f"LoRALinear requires nn.Linear, got {type(base_layer)!r}")
+        self.base_layer = base_layer
+        self.rank = int(rank)
+        self.alpha = float(alpha)
+        self.scaling = self.alpha / self.rank
+        self.dropout = nn.Dropout(float(dropout)) if dropout > 0 else nn.Identity()
+
+        factory = {
+            "device": base_layer.weight.device,
+            "dtype": base_layer.weight.dtype,
+        }
+        self.lora_A = nn.Parameter(
+            torch.empty(self.rank, base_layer.in_features, **factory)
+        )
+        self.lora_B = nn.Parameter(
+            torch.zeros(base_layer.out_features, self.rank, **factory)
+        )
+        nn.init.kaiming_uniform_(self.lora_A, a=math.sqrt(5))
+
+        for parameter in self.base_layer.parameters():
+            parameter.requires_grad = False
+
+    @property
+    def in_features(self) -> int:
+        return self.base_layer.in_features
+
+    @property
+    def out_features(self) -> int:
+        return self.base_layer.out_features
+
+    def forward(self, inputs: torch.Tensor) -> torch.Tensor:
+        base = self.base_layer(inputs)
+        residual = F.linear(F.linear(self.dropout(inputs), self.lora_A), self.lora_B)
+        return base + residual * self.scaling
+
+
+def _is_generation_target(name: str, scope: str) -> bool:
+    if any(name.endswith(suffix) for suffix in GENERATION_EXPERT_SUFFIXES):
+        return True
+    return scope == "generation_experts_and_io" and name in GENERATION_IO_NAMES
+
+
+def _resolve_parent(model: nn.Module, qualified_name: str) -> Tuple[nn.Module, str]:
+    parent = model
+    parts = qualified_name.split(".")
+    for part in parts[:-1]:
+        parent = getattr(parent, part)
+    return parent, parts[-1]
+
+
+def generation_lora_targets(model: nn.Module, scope: str) -> List[str]:
+    return [
+        name
+        for name, module in model.named_modules()
+        if isinstance(module, nn.Linear) and _is_generation_target(name, scope)
+    ]
+
+
+def generation_target_signature(model: nn.Module, target_names: List[str]) -> str:
+    """Hash the exact ordered generation target names and Linear shapes."""
+
+    modules = dict(model.named_modules())
+    payload = [
+        {
+            "name": name,
+            "in_features": int(modules[name].in_features),
+            "out_features": int(modules[name].out_features),
+        }
+        for name in sorted(target_names)
+    ]
+    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(canonical).hexdigest()
+
+
+def apply_generation_lora(
+    model: nn.Module,
+    config: GenerationLoRAConfig,
+) -> Dict[str, object]:
+    """Freeze the full model and attach LoRA only to generation-side linears."""
+
+    config.validate()
+    if any(isinstance(module, LoRALinear) for module in model.modules()):
+        raise ValueError("generation LoRA has already been applied to this model")
+
+    target_names = generation_lora_targets(model, config.target_scope)
+    if len(target_names) != config.expected_target_modules:
+        raise ValueError(
+            "generation LoRA target count changed: "
+            f"expected {config.expected_target_modules}, found {len(target_names)}. "
+            "Inspect the Lance architecture before changing the frozen contract."
+        )
+    target_signature = generation_target_signature(model, target_names)
+    if (
+        config.expected_target_signature_sha256
+        and target_signature != config.expected_target_signature_sha256
+    ):
+        raise ValueError(
+            "generation LoRA target names/shapes changed: "
+            f"expected signature {config.expected_target_signature_sha256}, "
+            f"found {target_signature}"
+        )
+
+    for parameter in model.parameters():
+        parameter.requires_grad = False
+
+    for name in target_names:
+        parent, attribute = _resolve_parent(model, name)
+        base_layer = getattr(parent, attribute)
+        setattr(
+            parent,
+            attribute,
+            LoRALinear(
+                base_layer=base_layer,
+                rank=config.rank,
+                alpha=config.alpha,
+                dropout=config.dropout,
+            ),
+        )
+
+    trainable = {
+        name: parameter.numel()
+        for name, parameter in model.named_parameters()
+        if parameter.requires_grad
+    }
+    if not trainable or any(
+        not (name.endswith("lora_A") or name.endswith("lora_B"))
+        for name in trainable
+    ):
+        raise RuntimeError("only LoRA A/B parameters may remain trainable")
+
+    return {
+        "target_modules": target_names,
+        "target_module_count": len(target_names),
+        "target_signature_sha256": target_signature,
+        "trainable_parameter_count": sum(trainable.values()),
+        "trainable_parameter_names": sorted(trainable),
+    }
+
+
+def lora_parameter_names(model: nn.Module) -> List[str]:
+    return sorted(
+        name
+        for name, _ in model.named_parameters()
+        if name.endswith("lora_A") or name.endswith("lora_B")
+    )
+
+
+def validate_adapter_state_dict(
+    model: nn.Module, state: Mapping[str, torch.Tensor]
+) -> None:
+    """Require an adapter file to contain every and only current LoRA tensor."""
+
+    expected_parameters = dict(model.named_parameters())
+    expected_names = set(lora_parameter_names(model))
+    actual_names = set(state)
+    missing = sorted(expected_names - actual_names)
+    unexpected = sorted(actual_names - expected_names)
+    shape_mismatches = []
+    for name in sorted(expected_names & actual_names):
+        expected_shape = tuple(expected_parameters[name].shape)
+        actual_shape = tuple(state[name].shape)
+        if actual_shape != expected_shape:
+            shape_mismatches.append((name, expected_shape, actual_shape))
+    if missing or unexpected or shape_mismatches:
+        raise RuntimeError(
+            "LoRA adapter topology mismatch: "
+            f"missing={missing[:20]}, unexpected={unexpected[:20]}, "
+            f"shape_mismatches={shape_mismatches[:20]}"
+        )
+
+
+def load_adapter_state_dict(
+    model: nn.Module, state: Mapping[str, torch.Tensor]
+):
+    """Strictly load a partial adapter state without accepting base-weight drift."""
+
+    validate_adapter_state_dict(model, state)
+    message = model.load_state_dict(dict(state), strict=False)
+    expected_missing = sorted(
+        name for name in model.state_dict() if name not in set(state)
+    )
+    if sorted(message.missing_keys) != expected_missing or message.unexpected_keys:
+        raise RuntimeError(
+            "partial LoRA load returned an unexpected key contract: "
+            f"missing={message.missing_keys[:20]}, "
+            f"unexpected={message.unexpected_keys[:20]}"
+        )
+    return message
+
+
+def write_lora_config(path: str, config: GenerationLoRAConfig) -> None:
+    config.validate()
+    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as stream:
+        json.dump(config.to_dict(), stream, indent=2, sort_keys=True)
+        stream.write("\n")
+
+
+def read_lora_config(path: str) -> GenerationLoRAConfig:
+    with open(path, "r", encoding="utf-8") as stream:
+        payload = json.load(stream)
+    if not isinstance(payload, dict):
+        raise ValueError(f"LoRA config must be a JSON object: {path}")
+    return GenerationLoRAConfig.from_dict(payload)
+
+
+def maybe_apply_checkpoint_lora(
+    model: nn.Module,
+    checkpoint_dir: str,
+) -> Optional[Dict[str, object]]:
+    """Attach adapters when an inference checkpoint declares the LoRA contract."""
+
+    config_path = os.path.join(checkpoint_dir, LORA_CONFIG_FILENAME)
+    if not os.path.isfile(config_path):
+        return None
+    config = read_lora_config(config_path)
+    report = apply_generation_lora(model, config)
+    return {"config": config.to_dict(), **report}
+
+
+def load_lora_checkpoint_into_model(model: nn.Module, model_args):
+    """Attach LoRA topology and load a DataMake full-state checkpoint.
+
+    The two-argument signature matches Lance's inference checkpoint loader, so
+    an isolated entry point can install it without editing historical code.
+    """
+
+    checkpoint_dir = os.path.abspath(model_args.model_path)
+    report = maybe_apply_checkpoint_lora(model, checkpoint_dir)
+    if report is None:
+        raise FileNotFoundError(
+            f"DataMake LoRA checkpoint lacks {LORA_CONFIG_FILENAME}: "
+            f"{checkpoint_dir}"
+        )
+
+    from safetensors.torch import load_file
+
+    adapter_path = os.path.join(checkpoint_dir, LORA_ADAPTER_FILENAME)
+    if os.path.isfile(adapter_path):
+        state = load_file(adapter_path, device="cpu")
+        message = load_adapter_state_dict(model, state)
+        state.clear()
+        return message
+
+    model_path = os.path.join(checkpoint_dir, "model.safetensors")
+    if not os.path.isfile(model_path):
+        raise FileNotFoundError(model_path)
+    state = load_file(model_path, device="cpu")
+    for key in ("latent_pos_embed.pos_embed", "vit_pos_embed.pos_embed"):
+        state.pop(key, None)
+    message = model.load_state_dict(state, strict=False)
+    unexpected = list(message.unexpected_keys)
+    missing = [
+        key
+        for key in message.missing_keys
+        if key not in {"latent_pos_embed.pos_embed", "vit_pos_embed.pos_embed"}
+    ]
+    state.clear()
+    if missing or unexpected:
+        raise RuntimeError(
+            "DataMake LoRA checkpoint topology mismatch: "
+            f"missing={missing[:20]}, unexpected={unexpected[:20]}"
+        )
+    return message
+
+
+def install_lora_adapter_inference_loader(checkpoint_dir: str) -> bool:
+    """Install a loader for an immutable base plus a separate LoRA adapter."""
+
+    checkpoint_dir = os.path.abspath(checkpoint_dir)
+    config_path = os.path.join(checkpoint_dir, LORA_CONFIG_FILENAME)
+    adapter_path = os.path.join(checkpoint_dir, LORA_ADAPTER_FILENAME)
+    if not os.path.isfile(config_path) or not os.path.isfile(adapter_path):
+        return False
+
+    import inference_lance
+
+    original_loader = inference_lance.init_from_model_path_if_needed
+    if getattr(original_loader, "_datamake_adapter_loader", False):
+        raise RuntimeError("DataMake adapter inference loader is already installed")
+
+    def fixed_checkpoint_loader(model: nn.Module, model_args):
+        # Lance creates a fresh model before invoking this hook.  Loading the
+        # official --model_path base must therefore happen before modules are
+        # wrapped: the base checkpoint contains nn.Linear names, while the
+        # adapter checkpoint contains only LoRA A/B tensors.
+        original_loader(model, model_args)
+        config = read_lora_config(config_path)
+        apply_generation_lora(model, config)
+        from safetensors.torch import load_file
+
+        state = load_file(adapter_path, device="cpu")
+        message = load_adapter_state_dict(model, state)
+        state.clear()
+        return message
+
+    fixed_checkpoint_loader._datamake_adapter_loader = True
+    inference_lance.init_from_model_path_if_needed = fixed_checkpoint_loader
+    return True
+
+
+def install_lora_inference_loader_if_present(checkpoint_dir: str) -> bool:
+    """Patch only this process when the checkpoint declares DataMake LoRA."""
+
+    config_path = os.path.join(checkpoint_dir, LORA_CONFIG_FILENAME)
+    if not os.path.isfile(config_path):
+        return False
+    if os.path.isfile(os.path.join(checkpoint_dir, LORA_ADAPTER_FILENAME)):
+        # Use the same base-first ordering even for a combined directory.  If
+        # it does not also contain a valid model.safetensors, Lance's original
+        # loader fails explicitly instead of silently using random base weights.
+        return install_lora_adapter_inference_loader(checkpoint_dir)
+    import inference_lance
+
+    inference_lance.init_from_model_path_if_needed = load_lora_checkpoint_into_model
+    return True
