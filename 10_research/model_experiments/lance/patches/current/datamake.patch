+# Copyright (c) 2025 ByteDance Ltd. and/or its affiliates.
+# Licensed under the Apache License, Version 2.0.
+# coding: utf-8
+
+"""LoRA-aware DataMake entry for Lance multi-turn inference.
+
+The historical ``multiturn_chat.py`` and ``inference_lance.py`` remain
+unchanged. This entry requires LoRA topology metadata, installs the compatible
+loader in this process, and delegates to the existing multi-turn CLI.
+"""
+
+from __future__ import annotations
+
+import sys
+
+from train.datamake_generation_lora import (
+    LORA_CONFIG_FILENAME,
+    install_lora_adapter_inference_loader,
+    install_lora_inference_loader_if_present,
+)
+
+
+def argument_value(arguments, name):
+    indexes = [index for index, value in enumerate(arguments) if value == name]
+    if not indexes:
+        raise ValueError(f"{name} is required")
+    if len(indexes) != 1:
+        raise ValueError(f"{name} may only be provided once")
+    index = indexes[0]
+    if index + 1 >= len(arguments):
+        raise ValueError(f"{name} requires a value")
+    return arguments[index + 1]
+
+
+def main() -> None:
+    arguments = sys.argv[1:]
+    model_path = argument_value(arguments, "--model_path")
+    adapter_indexes = [
+        index
+        for index, value in enumerate(arguments)
+        if value == "--datamake_lora_checkpoint"
+    ]
+    if len(adapter_indexes) > 1:
+        raise ValueError("--datamake_lora_checkpoint may only be provided once")
+    if adapter_indexes:
+        index = adapter_indexes[0]
+        if index + 1 >= len(arguments):
+            raise ValueError("--datamake_lora_checkpoint requires a value")
+        checkpoint = arguments[index + 1]
+        del arguments[index : index + 2]
+        installed = install_lora_adapter_inference_loader(checkpoint)
+    else:
+        installed = install_lora_inference_loader_if_present(model_path)
+    if not installed:
+        raise FileNotFoundError(
+            f"LoRA-aware inference requires {LORA_CONFIG_FILENAME} and adapter "
+            f"weights: {checkpoint if adapter_indexes else model_path}"
+        )
+    sys.argv = [sys.argv[0], *arguments]
+
+    from multiturn_chat import main as multiturn_main
+
+    multiturn_main()
+
+
+if __name__ == "__main__":
+    main()
