+# limitations under the License.
+# coding: utf-8
+
+"""CLI entry for unified multi-turn multimodal chat (inference-only PoC).
+
+Reads a conversation JSON (a list of turns; each user turn declares an ``action``),
+runs the turns sequentially with a single loaded Lance model, and writes the
+produced images/videos plus an updated transcript to the output directory.
+
+Mirrors ``inference_lance.py`` argument conventions; see ``multiturn_chat.sh`` for
+the recommended model recipe flags.
+"""
+
+import warnings
+warnings.filterwarnings("ignore", message=".*pkg_resources is deprecated.*", category=UserWarning)
+warnings.filterwarnings("ignore", category=FutureWarning, module="diffusers.models.transformers.transformer_2d")
+
+import os
+os.environ["TF_CPP_MIN_LOG_LEVEL"] = "2"
+os.environ["TF_ENABLE_ONEDNN_OPTS"] = "0"
+
+import json
+import os.path as osp
+from dataclasses import dataclass, field
+from typing import Tuple, cast
+
+import torch
+from transformers import HfArgumentParser, set_seed
+
+from config.config_factory import (
+    DataArguments,
+    InferenceArguments,
+    ModelArguments,
+    get_model_path,
+)
+from multiturn.conversation import Conversation
+from multiturn.engine import MultiTurnChatEngine
+
+
+@dataclass
+class MultiTurnArguments:
+    conversation_path: str = field(
+        default="config/examples/multiturn_example.json",
+        metadata={"help": "Path to the conversation JSON describing the multi-turn dialogue."},
+    )
+    save_path: str = field(
+        default="results/multiturn",
+        metadata={"help": "Directory for generated media and the output transcript."},
+    )
+    transcript_name: str = field(
+        default="transcript.json",
+        metadata={"help": "Filename for the produced conversation transcript."},
+    )
+
+
+def _apply_defaults(model_args: ModelArguments, inference_args: InferenceArguments) -> None:
+    if not model_args.model_path:
+        raise ValueError(
+            "--model_path is required (e.g. downloads/Lance_3B or downloads/Lance_3B_Video)"
+        )
+    if not getattr(model_args, "llm_path", ""):
+        model_args.llm_path = model_args.model_path
+    if not model_args.vit_path:
+        model_args.vit_path = get_model_path("vit.qwen2_5_vl")
+
+
+def main() -> None:
+    if not torch.cuda.is_available():
+        raise RuntimeError("CUDA is required to run Lance multi-turn chat")
+
+    parser = HfArgumentParser((ModelArguments, DataArguments, InferenceArguments, MultiTurnArguments))
+    model_args, data_args, inference_args, mt_args = cast(
+        Tuple[ModelArguments, DataArguments, InferenceArguments, MultiTurnArguments],
+        parser.parse_args_into_dataclasses(),
+    )
+
+    _apply_defaults(model_args, inference_args)
+
+    device = 0
+    torch.cuda.set_device(device)
+    set_seed(inference_args.global_seed)
+
+    with open(mt_args.conversation_path, "r", encoding="utf-8") as f:
+        conversation = Conversation.from_dict(json.load(f))
+
+    engine = MultiTurnChatEngine(
+        model_args=model_args,
+        data_args=data_args,
+        inference_args=inference_args,
+        device=device,
+        log=print,
+    )
+
+    os.makedirs(mt_args.save_path, exist_ok=True)
+    engine.run_conversation(conversation, save_dir=mt_args.save_path)
+
+    transcript_path = osp.join(mt_args.save_path, mt_args.transcript_name)
+    with open(transcript_path, "w", encoding="utf-8") as f:
+        json.dump(conversation.to_dict(), f, ensure_ascii=False, indent=2)
+    print(f"[done] transcript saved to {transcript_path}")
+
+
+if __name__ == "__main__":
+    main()
