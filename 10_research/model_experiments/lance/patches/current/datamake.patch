+def validate_dataset_binding(
+    dataset_config_path: Path, chain_manifest_path: Path
+) -> None:
+    """Bind CLI history semantics to the actual YAML and parquet artifact."""
+
+    dataset_config_path = dataset_config_path.resolve()
+    chain_manifest_path = chain_manifest_path.resolve()
+    payload = yaml.safe_load(dataset_config_path.read_text(encoding="utf-8"))
+    if not isinstance(payload, dict) or len(payload) != 1:
+        raise ValueError("dataset YAML must have exactly one outer group")
+    group = next(iter(payload.values()))
+    if not isinstance(group, dict) or len(group) != 1:
+        raise ValueError("dataset YAML must have exactly one dataset implementation")
+    dataset = next(iter(group.values()))
+    if dataset.get("datamake_record_level") != "chain":
+        raise ValueError("dataset YAML is not chain-level")
+    if dataset.get("datamake_history_mode") != "online_rollout_full":
+        raise ValueError("dataset YAML history mode differs from trainer")
+    if Path(dataset.get("datamake_chain_manifest", "")).resolve() != chain_manifest_path:
+        raise ValueError("dataset YAML chain manifest differs from CLI")
+    manifest = json.loads(chain_manifest_path.read_text(encoding="utf-8"))
+    expected_parquet = Path(manifest["parquet_file"]).resolve()
+    names = dataset.get("dataset_names", {})
+    data_paths: List[str] = []
+    for record in names.values():
+        value = record.get("data_dir", [])
+        data_paths.extend([value] if isinstance(value, str) else list(value))
+    actual_paths = {Path(value).resolve() for value in data_paths}
+    if actual_paths != {expected_parquet}:
+        raise ValueError(
+            f"dataset YAML parquet binding differs: {actual_paths} != {expected_parquet}"
+        )
+
