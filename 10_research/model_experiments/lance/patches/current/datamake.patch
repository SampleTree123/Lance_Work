@@ -0,0 +1,219 @@
+"""PEFT weights + standard named Adam state; complete, atomic DDP resume."""
+from copy import deepcopy
+import hashlib
+import json
+import os
+from pathlib import Path
+import random
+import shutil
+import tempfile
+
+import numpy as np
+from safetensors.torch import load_file, save_file
+import torch
+import torch.distributed as dist
+
+from train.datamake_peft import adapter_state, canonical_name, load_adapter, metadata
+
+FORMAT = 6
+
+
+def rank():
+    return dist.get_rank() if dist.is_initialized() else 0
+
+
+def world():
+    return dist.get_world_size() if dist.is_initialized() else 1
+
+
+def barrier():
+    if dist.is_initialized():
+        dist.barrier()
+
+
+def rank_zero_call(fn):
+    error = None
+    if rank() == 0:
+        try:
+            fn()
+        except Exception as exc:
+            error = f"{type(exc).__name__}: {exc}"
+    if dist.is_initialized():
+        value = [error]
+        dist.broadcast_object_list(value, src=0)
+        error = value[0]
+    if error:
+        raise RuntimeError(error)
+
+
+def sha256(path):
+    result = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            result.update(chunk)
+    return result.hexdigest()
+
+
+def write_json(path, value):
+    Path(path).write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+
+
+def rng_state():
+    state = {"python": random.getstate(), "numpy": np.random.get_state(), "torch_cpu": torch.get_rng_state()}
+    if torch.cuda.is_available():
+        state["torch_cuda"] = torch.cuda.get_rng_state()
+    return state
+
+
+def restore_rng(state):
+    random.setstate(state["python"])
+    np.random.set_state(state["numpy"])
+    torch.set_rng_state(state["torch_cpu"])
+    if torch.cuda.is_available() and "torch_cuda" in state:
+        torch.cuda.set_rng_state(state["torch_cuda"])
+
+
+def cpu_tree(value):
+    if torch.is_tensor(value):
+        return value.detach().cpu().clone()
+    if isinstance(value, dict):
+        return {k: cpu_tree(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [cpu_tree(v) for v in value]
+    if isinstance(value, tuple):
+        return tuple(cpu_tree(v) for v in value)
+    return deepcopy(value)
+
+
+def named_optimizer(model, optimizer):
+    names = {id(p): canonical_name(n) for n, p in model.named_parameters() if p.requires_grad}
+    state = optimizer.state_dict()
+    mapping = {}
+    for group, saved in zip(optimizer.param_groups, state["param_groups"]):
+        for p, index in zip(group["params"], saved["params"]):
+            if id(p) not in names:
+                raise ValueError("Optimizer contains a frozen/non-adapter parameter")
+            mapping[index] = names[id(p)]
+    return {"state_dict": cpu_tree(state), "parameter_names": mapping}
+
+
+def load_named_optimizer(model, optimizer, payload):
+    current = named_optimizer(model, optimizer)
+    old_names = {int(k): v for k, v in payload["parameter_names"].items()}
+    current_names = current["parameter_names"]
+    if set(old_names.values()) != set(current_names.values()) or len(old_names) != len(current_names):
+        raise ValueError("Optimizer target names differ")
+    by_name = {name: index for index, name in old_names.items()}
+    source = payload["state_dict"]
+    if len(source["param_groups"]) != len(current["state_dict"]["param_groups"]):
+        raise ValueError("Optimizer group count differs")
+    states, groups = {}, []
+    for current_group, old_group in zip(current["state_dict"]["param_groups"], source["param_groups"]):
+        expected = {current_names[i] for i in current_group["params"]}
+        if expected != {old_names[i] for i in old_group["params"]}:
+            raise ValueError("Optimizer group membership differs")
+        groups.append({**old_group, "params": current_group["params"]})
+        for index in current_group["params"]:
+            old_index = by_name[current_names[index]]
+            if old_index in source["state"]:
+                states[index] = source["state"][old_index]
+    optimizer.load_state_dict({"state": states, "param_groups": groups})
+    for group in optimizer.param_groups:
+        for p in group["params"]:
+            for key in ("exp_avg", "exp_avg_sq"):
+                value = optimizer.state[p].get(key)
+                if value is not None and (value.shape != p.shape or not torch.isfinite(value).all()):
+                    raise ValueError(f"Invalid Adam {key}")
+
+
+def finalize(staging, final, completed, world_size, contract, cursor, keep_last):
+    write_json(staging / "datamake_online_training_contract.json", contract)
+    write_json(staging / "trainer_state.json", {
+        "checkpoint_format_version": FORMAT, "completed_steps": completed,
+        "next_step": completed, "next_microstep": cursor, "world_size": world_size,
+        "optimizer_boundary": True,
+    })
+    files = [p for p in staging.iterdir() if p.is_file()]
+    required = {"adapter.safetensors", "adapter_config.json", "datamake_lora_config.json",
+                "optimizer.pt", "scheduler.pt", "trainer_state.json", "datamake_online_training_contract.json",
+                *[f"rng.rank-{r:05d}-of-{world_size:05d}.pt" for r in range(world_size)]}
+    if not required.issubset({p.name for p in files}):
+        raise ValueError("Incomplete DDP checkpoint")
+    write_json(staging / "checkpoint_complete.json", {
+        "status": "complete", "checkpoint_format_version": FORMAT, "adapter_only": True,
+        "completed_steps": completed, "world_size": world_size,
+        "artifacts": {p.name: {"bytes": p.stat().st_size, "sha256": sha256(p)} for p in files},
+    })
+    os.rename(staging, final)
+    completed_dirs = sorted([p for p in final.parent.iterdir() if p.is_dir() and p.name.isdigit()
+                             and (p / "checkpoint_complete.json").is_file()], key=lambda p: int(p.name))
+    for old in completed_dirs[:-keep_last]:
+        shutil.rmtree(old)
+
+
+def validate(checkpoint, contract=None, expected_world=None):
+    checkpoint = Path(checkpoint)
+    marker = json.loads((checkpoint / "checkpoint_complete.json").read_text())
+    if marker.get("status") != "complete" or marker.get("checkpoint_format_version") != FORMAT:
+        raise ValueError("A converted/native complete DDP-v6 checkpoint is required")
+    if expected_world is not None and marker["world_size"] != expected_world:
+        raise ValueError("World size differs; rank RNG/data cursors must stay aligned")
+    required = {"adapter.safetensors", "adapter_config.json", "datamake_lora_config.json",
+                "optimizer.pt", "scheduler.pt", "trainer_state.json", "datamake_online_training_contract.json",
+                *[f"rng.rank-{r:05d}-of-{marker['world_size']:05d}.pt" for r in range(marker["world_size"])]}
+    if not required.issubset(marker["artifacts"]):
+        raise ValueError("Checkpoint manifest omits required artifacts")
+    for name, record in marker["artifacts"].items():
+        if Path(name).name != name:
+            raise ValueError("Checkpoint artifact escapes directory")
+        p = checkpoint / name
+        if p.stat().st_size != record["bytes"] or sha256(p) != record["sha256"]:
+            raise ValueError(f"Checkpoint artifact mismatch: {name}")
+    if contract is not None and json.loads((checkpoint / "datamake_online_training_contract.json").read_text()) != contract:
+        raise ValueError("DDP checkpoint contract differs")
+    state = json.loads((checkpoint / "trainer_state.json").read_text())
+    if (not state["optimizer_boundary"] or state["next_step"] != marker["completed_steps"]
+            or state["completed_steps"] != state["next_step"] or state["world_size"] != marker["world_size"]):
+        raise ValueError("Checkpoint is not at an optimizer boundary")
+    return state
+
+
+def save(root, completed, model, optimizer, scheduler, config, contract, cursor, keep_last=4):
+    if completed < 1 or keep_last < 1:
+        raise ValueError("Invalid checkpoint step/retention")
+    root = Path(root)
+    final = root / f"{completed:07d}"
+    staging = None
+
+    def prepare():
+        nonlocal staging
+        root.mkdir(parents=True, exist_ok=True)
+        if final.exists():
+            raise FileExistsError(f"Refusing to overwrite checkpoint: {final}")
+        # A failed attempt may leave files behind; a retry owns a new directory.
+        staging = Path(tempfile.mkdtemp(prefix=f".{completed:07d}.incomplete-", dir=root))
+        save_file(adapter_state(model), str(staging / "adapter.safetensors"))
+        model.peft_config["default"].save_pretrained(staging)
+        write_json(staging / "datamake_lora_config.json", metadata(config))
+        torch.save(named_optimizer(model, optimizer), staging / "optimizer.pt")
+        torch.save(scheduler.state_dict(), staging / "scheduler.pt")
+
+    rank_zero_call(prepare)
+    if dist.is_initialized():
+        paths = [str(staging) if rank() == 0 else None]
+        dist.broadcast_object_list(paths, src=0)
+        staging = Path(paths[0])
+    torch.save(rng_state(), staging / f"rng.rank-{rank():05d}-of-{world():05d}.pt")
+    barrier()
+    rank_zero_call(lambda: finalize(staging, final, completed, world(), contract, cursor, keep_last))
+    return final
+
+
+def load(checkpoint, model, optimizer, scheduler, contract):
+    checkpoint = Path(checkpoint)
+    state = validate(checkpoint, contract, world())
+    load_adapter(model, load_file(str(checkpoint / "adapter.safetensors")))
+    load_named_optimizer(model, optimizer, torch.load(checkpoint / "optimizer.pt", weights_only=False, map_location="cpu"))
+    scheduler.load_state_dict(torch.load(checkpoint / "scheduler.pt", weights_only=True, map_location="cpu"))
+    restore_rng(torch.load(checkpoint / f"rng.rank-{rank():05d}-of-{world():05d}.pt", weights_only=False, map_location="cpu"))
+    return state
