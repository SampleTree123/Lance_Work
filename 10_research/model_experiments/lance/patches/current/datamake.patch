+# Copyright (c) 2025 ByteDance Ltd. and/or its affiliates.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# coding: utf-8
+
+"""Build packed model inputs for a multi-turn multimodal conversation.
+
+:class:`MultiTurnSequenceBuilder` subclasses :class:`ValidationDataset` so it can
+reuse the exact single-turn assembly helpers (``process_vit_video``,
+``process_vae_video``, ``process_text_template``, ``get_video_tensor_online``,
+``get_thw``, ``gen_timesteps``, ``_finalize_sample``). The only genuinely new
+logic is:
+
+1. rendering the *full* conversation (multiple user/assistant turns) instead of a
+   single user+assistant pair, and
+2. indexing the *final* assistant turn as the generation target (the stock
+   helper targets the first ``assistant`` marker, which is wrong once there are
+   multiple assistant turns).
+
+The produced dict matches what ``inference_lance.validate_on_fixed_batch``
+consumes, so the existing ``Lance.validation_gen`` / ``Lance.validation_video_to_text``
+methods can be called unchanged.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional, Tuple
+
+import torch
+
+from data.common import generate_system_prompt
+from data.datamake_reference_image import REFERENCE_IMAGE_PROMPT, read_reference_tensor
+from data.data_utils import get_flattened_position_ids_extrapolate_video
+from data.datasets_custom.validation_dataset import (
+    ValidationDataset,
+    modality_map,
+    sample_task_map,
+)
+from data.system_prompt_render import VS, VE, render_qwenvl_prompt
+
+from .conversation import (
+    Conversation,
+    ContentItem,
+    MODALITY_IMAGE,
+    MODALITY_TEXT,
+    MODALITY_VIDEO,
+    ROLE_ASSISTANT,
+    TurnAction,
+    Turn,
+)
+
+# Placeholder answer used for text-generation turns. It is sliced away before the
+# model generates (generation truncates at the first CE-loss index, i.e. right
+# after "assistant\n"), so its exact value does not matter; it only needs to be a
+# non-empty span so target indexing succeeds.
+_DUMMY_ANSWER = "."
+
+# System-prompt type per action, fed to ``generate_system_prompt``.
+_ACTION_SYSTEM_PROMPT_TYPE = {
+    TurnAction.GENERATE_IMAGE: "t2i",
+    TurnAction.GENERATE_VIDEO: "t2v",
+    TurnAction.EDIT_IMAGE: "edit",
+    TurnAction.EDIT_VIDEO: "edit",
+    TurnAction.IMAGE_TO_VIDEO: "i2v",
+    TurnAction.CHAT: "caption",
+    TurnAction.UNDERSTAND: "caption",
+}
+
+
+def _find_last_anchored(all_ids: List[int], needle: List[int]) -> int:
+    """Return the start index of the LAST occurrence of ``needle`` in ``all_ids``.
+
+    Uses the same first-token-anchored / last-token-verified matching as the stock
+    ``expand_and_index_by_token_ids_new`` so behavior is identical for a
+    single-turn conversation, but scans to the final match for multi-turn.
+    Returns -1 if not found.
+    """
+    if not needle:
+        return -1
+    last = -1
+    i = 0
+    n, m = len(all_ids), len(needle)
+    while i < n:
+        try:
+            pos = all_ids[i:].index(needle[0]) + i
+        except ValueError:
+            break
+        if pos + m - 1 < n and all_ids[pos + m - 1] == needle[-1]:
+            last = pos
+        i = pos + 1
+    return last
+
+
+def _find_last_exact(all_ids: List[int], needle: List[int]) -> int:
+    """Return the start index of the LAST exact subsequence match, or -1."""
+    if not needle:
+        return -1
+    last = -1
+    n, m = len(all_ids), len(needle)
+    for i in range(n - m + 1):
+        if all_ids[i : i + m] == needle:
+            last = i
+    return last
+
+
+def expand_and_index_multiturn(
+    rendered_text: str,
+    tokens: List[int],
+    tokenizer,
+    target_text: str = "assistant\n",
+    search_text: str = "",
+) -> Tuple[List[int], List[List[int]], List[int], List[int]]:
+    """Tokenize a multi-turn rendered prompt and expand vision placeholders.
+
+    Mirrors ``data.system_prompt_render.expand_and_index_by_token_ids_new`` for the
+    vision-span expansion, but resolves ``target_text`` and ``search_text`` to
+    their LAST occurrence so the final assistant turn (the generation target) and
+    the current-turn instruction are indexed correctly.
+
+    Returns:
+        all_token_id : expanded token ids
+        spans_index  : per-visual pad-token index blocks, in occurrence order
+        tgt_index    : token indexes of the final assistant target span (to end)
+        search_index : token indexes of the current-turn instruction (or [])
+    """
+    vs_ids = tokenizer(VS, add_special_tokens=False)["input_ids"]
+    ve_ids = tokenizer(VE, add_special_tokens=False)["input_ids"]
+
+    base_ids = tokenizer(rendered_text, add_special_tokens=False)["input_ids"]
+
+    all_ids: List[int] = []
+    spans_index: List[List[int]] = []
+
+    i = 0
+    tk_ptr = 0
+    while True:
+        try:
+            vs_pos = base_ids[i:].index(vs_ids[0]) + i
+        except ValueError:
+            all_ids.extend(base_ids[i:])
+            break
+        all_ids.extend(base_ids[i:vs_pos])
+        i = vs_pos + 3  # skip the original VS + single pad + VE triple
+
+        pad_ids = base_ids[vs_pos + 1 : vs_pos + 2]
+        if tk_ptr >= len(tokens):
+            raise ValueError(
+                f"found more vision placeholders than provided token counts: "
+                f"tokens has {len(tokens)} entries but encountered placeholder #{tk_ptr + 1}"
+            )
+        K = int(tokens[tk_ptr])
+        start, end = len(all_ids) + 1, len(all_ids) + 1 + K
+        all_ids.extend(vs_ids + pad_ids * K + ve_ids)
+        tk_ptr += 1
+        spans_index.append(list(range(start, end)))
+
+    if tk_ptr != len(tokens):
+        raise ValueError(
+            f"vision placeholder count ({tk_ptr}) does not match provided token "
+            f"counts ({len(tokens)}); messages and video_types are misaligned"
+        )
+
+    tgt_ids = tokenizer(target_text, add_special_tokens=False)["input_ids"]
+    tgt_pos = _find_last_anchored(all_ids, tgt_ids)
+    tgt_index: List[int] = []
+    if tgt_pos >= 0:
+        tgt_index = list(range(tgt_pos + len(tgt_ids), len(all_ids)))
+
+    search_index: List[int] = []
+    if search_text:
+        s_ids = tokenizer(search_text, add_special_tokens=False)["input_ids"]
+        s_pos = _find_last_exact(all_ids, s_ids)
+        if s_pos >= 0:
+            search_index = list(range(s_pos, s_pos + len(s_ids)))
+
+    return all_ids, spans_index, tgt_index, search_index
+
+
+class MultiTurnSequenceBuilder(ValidationDataset):
+    """Assemble packed model inputs for one assistant response in a conversation."""
+
+    def __init__(
+        self,
+        tokenizer,
+        data_args,
+        model_args,
+        training_args,
+        new_token_ids: Dict[str, int],
+        dataset_config,
+    ):
+        super().__init__(
+            jsonl_path=None,
+            tokenizer=tokenizer,
+            data_args=data_args,
+            model_args=model_args,
+            training_args=training_args,
+            new_token_ids=new_token_ids,
+            dataset_config=dataset_config,
+            local_rank=0,
+            world_size=1,
+        )
+
+    # ------------------------------------------------------------------
+    # Public API
+    # ------------------------------------------------------------------
+    def build(self, conversation: Conversation, target_user_idx: int) -> Dict[str, Any]:
+        """Build the packed sample for responding to ``turns[target_user_idx]``.
+
+        ``target_user_idx`` must point at a ``user`` turn that carries an action.
+        Returns a dict shaped like the single-turn ``ValidationDataset`` outputs.
+        """
+        if target_user_idx < 0 or target_user_idx >= len(conversation.turns):
+            raise IndexError(
+                f"target_user_idx {target_user_idx} out of range for conversation "
+                f"with {len(conversation.turns)} turns"
+            )
+        turn = conversation.turns[target_user_idx]
+        if turn.action is None:
+            raise ValueError(
+                f"turn {target_user_idx} has no action; cannot build a generation request"
+            )
+        action = turn.action
+        history = conversation.turns[: target_user_idx + 1]
+        if any(t.reference_image is not None for t in history) and action != TurnAction.EDIT_VIDEO:
+            raise ValueError("conversations with reference images currently support edit_video only")
+
+        if action.is_text_output:
+            return self._build_text(conversation, history, turn, action)
+        if action.is_image_to_video:
+            return self._build_image_to_video(conversation, history, turn, action)
+        return self._build_visual(conversation, history, turn, action)
+
+    # ------------------------------------------------------------------
+    # Context assembly shared by the visual/text builders
+    # ------------------------------------------------------------------
+    def _ordered_content(self, turn: Turn) -> List[ContentItem]:
+        """Visuals first then text, matching the trained edit/understanding layout."""
+        return turn.visual_items + turn.text_items
+
+    def _add_visual_condition(
+        self,
+        item: ContentItem,
+        message_content: List[Dict[str, Any]],
+        video_types: List[str],
+        vit_num_tokens: List[int],
+        curr_video_grid_thw: List[Any],
+        video_sizes: List[Any],
+        include_vae: bool,
+    ) -> Optional[torch.Tensor]:
+        """Process one context visual as a condition (VIT, plus VAE when ``include_vae``).
+
+        Returns the VAE condition tensor (or None) for downstream target sizing.
+        """
+        # VIT branch (understanding features) -- present for every condition.
+        vit_tensor = self.get_video_tensor_online(
+            item.value, vision_stream="vit_video", element_dtype=item.type
+        )
+        (
+            self.sample,
+            _,
+            _,
+            _,
+            curr_video_grid_thw,
+            vit_k,
+        ) = self.process_vit_video(
+            vit_tensor,
+            curr=0,
+            curr_rope_id=0,
+            curr_split_len=0,
+            curr_video_grid_thw=curr_video_grid_thw,
+            item_loss=0,
+        )
+        message_content.append({"type": item.type})
+        video_types.append("vit_video")
+        vit_num_tokens.append(vit_k)
+
+        vae_tensor = None
+        if include_vae:
+            vae_tensor = self.get_video_tensor_online(
+                item.value, vision_stream="vae_video", element_dtype=item.type
+            )
+            (
+                self.sample,
+                _,
+                _,
+                _,
+                curr_video_grid_thw,
+                video_sizes,
+                vae_k,
+            ) = self.process_vae_video(
+                vae_tensor,
+                curr=0,
+                curr_rope_id=0,
+                curr_split_len=0,
+                curr_video_grid_thw=curr_video_grid_thw,
+                video_sizes=video_sizes,
+                item_loss=0,
+            )
+            message_content.append({"type": item.type})
+            video_types.append("cond_vae_video")
+            vit_num_tokens.append(vae_k)
+
+        return vae_tensor
+
+    def _collect_context(
+        self,
+        history: List[Turn],
+        vae_condition_item: Optional[ContentItem],
+        curr_video_grid_thw: List[Any],
+        video_sizes: List[Any],
+    ) -> Tuple[List[Dict[str, Any]], List[str], List[int], Optional[torch.Tensor]]:
+        """Build messages + aligned span metadata for all history turns.
+
+        Returns (messages, video_types, vit_num_tokens, last_vae_cond_tensor).
+        """
+        messages: List[Dict[str, Any]] = []
+        video_types: List[str] = []
+        vit_num_tokens: List[int] = []
+        last_vae_cond: Optional[torch.Tensor] = None
+
+        for turn in history:
+            content: List[Dict[str, Any]] = []
+            for item in turn.visual_items:
+                if item.is_visual:
+                    vae_tensor = self._add_visual_condition(
+                        item,
+                        content,
+                        video_types,
+                        vit_num_tokens,
+                        curr_video_grid_thw,
+                        video_sizes,
+                        include_vae=item is vae_condition_item,
+                    )
+                    if vae_tensor is not None:
+                        last_vae_cond = vae_tensor
+            if turn.reference_image is not None:
+                # Use the shared static-image preprocessing, not the online
+                # video reader (which can be patched with CoinVE crop windows).
+                reference = read_reference_tensor(turn.reference_image, self.vit_transform)
+                self.sample, _, _, _, curr_video_grid_thw, reference_k = self.process_vit_video(
+                    reference, curr=0, curr_rope_id=0, curr_split_len=0,
+                    curr_video_grid_thw=curr_video_grid_thw, item_loss=0,
+                )
+                content.append({"type": MODALITY_TEXT, "text": REFERENCE_IMAGE_PROMPT})
+                # Static T=1 ViT grid shares the video positional-index stream.
+                # Mixing image/video placeholders would reset separate RoPE
+                # counters in the existing video-only packed path.
+                content.append({"type": MODALITY_VIDEO})
+                video_types.append("vit_video")
+                vit_num_tokens.append(reference_k)
+            for item in turn.text_items:
+                content.append({"type": MODALITY_TEXT, "text": item.value})
+            if content:
+                messages.append({"role": turn.role, "content": content})
+
+        return messages, video_types, vit_num_tokens, last_vae_cond
+
+    # ------------------------------------------------------------------
+    # Target sizing
+    # ------------------------------------------------------------------
+    def _prepare_target_size(
+        self, action: TurnAction, turn: Turn, condition_tensor: Optional[torch.Tensor]
+    ) -> None:
+        self.data_config.target_modality = action.target_modality
+
+        if action.is_edit:
+            if condition_tensor is None:
+                raise ValueError(
+                    f"action {action.value} requires an input image/video in the current turn, "
+                    f"but none was found"
+                )
+            self.data_config.num_frames = condition_tensor.shape[1]
+            self.data_config.H = condition_tensor.shape[2]
+            self.data_config.W = condition_tensor.shape[3]
+        else:  # plain generation
+            if turn.height:
+                self.data_config.H = turn.height
+            if turn.width:
+                self.data_config.W = turn.width
+            if action.target_modality == MODALITY_VIDEO and turn.num_frames:
+                self.data_config.num_frames = turn.num_frames
+
+    def _append_target_vae(
+        self,
+        curr_video_grid_thw: List[Any],
+        video_sizes: List[Any],
+        first_frame_source: Optional[torch.Tensor] = None,
+    ) -> Tuple[int, List[int]]:
+        """Append the target VAE slot (mirrors tiv2v_sample / ff2v_sample target build).
+
+        Returns (num_vid_tokens, mse_loss_indexes_from_gen_timesteps).
+        """
+        thw_video, thw_downsample = self.get_thw()
+        video_sizes.append(thw_video)
+        t, h, w = thw_downsample
+        num_vid_tokens = t * h * w
+        self.sample["vae_data_mode"].append("online")
+
+        spatial_merge_size = 2
+        vae_video_grid_thw = [t, h * spatial_merge_size, w * spatial_merge_size]
+        curr_video_grid_thw.append(vae_video_grid_thw)
+        self.sample["vae_video_grid_thw"].append(vae_video_grid_thw)
+        self.sample["vae_latent_shapes"].append((t, h, w))
+        self.sample["packed_latent_position_ids"].append(
+            get_flattened_position_ids_extrapolate_video(t, h, w, max_latent_size=self.data_config.max_latent_size)
+        )
+
+        packed_timesteps, mse_loss_indexes = self.gen_timesteps(t, h, w, 0, num_vid_tokens)
+        self.sample["packed_timesteps"].extend(packed_timesteps)
+
+        vae_tensor = torch.randn([3, thw_video[0], thw_video[1], thw_video[2]], dtype=torch.float32)
+        if first_frame_source is not None:
+            # i2v: inject the conditioning first frame (mirrors ff2v_sample).
+            vae_tensor[:, :4, :, :] = first_frame_source[:, 0:1, :, :].repeat(1, 4, 1, 1)
+        self.sample["vae_video_tensors"].append(vae_tensor)
+
+        return num_vid_tokens, mse_loss_indexes
+
+    # ------------------------------------------------------------------
+    # Builders
+    # ------------------------------------------------------------------
+    def _resolve_instruction(
+        self, conversation: Conversation, action: TurnAction, vision_type: str
+    ) -> str:
+        if conversation.system_prompt:
+            return conversation.system_prompt
+        sp_type = _ACTION_SYSTEM_PROMPT_TYPE.get(action, "caption")
+        return generate_system_prompt(system_prompt_type=sp_type, vision_type=vision_type)
+
+    def _build_visual(
+        self,
+        conversation: Conversation,
+        history: List[Turn],
+        turn: Turn,
+        action: TurnAction,
+    ) -> Dict[str, Any]:
+        self.sample = self.set_sequence_status()
+        self.frame_condition_idx = []
+        curr_video_grid_thw: List[Any] = []
+        video_sizes: List[Any] = []
+
+        vae_condition_item = self._latest_visual_item(history) if action.is_edit else None
+        messages, video_types, vit_num_tokens, last_vae_cond = self._collect_context(
+            history,
+            vae_condition_item=vae_condition_item,
+            curr_video_grid_thw=curr_video_grid_thw,
+            video_sizes=video_sizes,
+        )
+
+        if action.is_edit and last_vae_cond is None:
+            raise ValueError(f"action {action.value} requires a previous or current visual source")
+        self.sample_task = "edit" if action.is_edit else "t2v"
+
+        self._prepare_target_size(action, turn, last_vae_cond)
+        num_vid_tokens, _ = self._append_target_vae(curr_video_grid_thw, video_sizes)
+        vit_num_tokens.append(num_vid_tokens)
+        video_types.append("target_vae_video")
+        messages.append({"role": ROLE_ASSISTANT, "content": [{"type": action.target_modality}]})
+
+        instruction = self._resolve_instruction(conversation, action, action.target_modality)
+        search_text = turn.joined_text()
+        all_token_id, spans_index, tgt_index, search_index = expand_and_index_multiturn(
+            rendered_text=render_qwenvl_prompt(messages, default_system=instruction, include_assistant_content=True).strip(),
+            tokens=vit_num_tokens,
+            tokenizer=self.tokenizer,
+            target_text="assistant\n",
+            search_text=search_text,
+        )
+
+        self.sample, _, _, _ = self.process_text_template(
+            all_token_id,
+            spans_index,
+            tgt_index,
+            search_index,
+            video_types=video_types,
+            curr=0,
+            curr_rope_id=0,
+            curr_split_len=0,
+            item_loss=0,
+        )
+        sample_lens = len(all_token_id)
+        self.sample["sample_task"] = torch.ones(sample_lens) * sample_task_map[self.sample_task]
+
+        caption_all = turn.joined_text()
+        finalized = self._finalize_sample(
+            sample_lens,
+            curr_video_grid_thw,
+            sample_type="gen",
+            additional_fields={
+                "caption": caption_all,
+                "caption_cn": caption_all,
+                "index": str(turn.meta.get("index", "turn")),
+            },
+            video_sizes=video_sizes,
+        )
+        # No VIT conditions -> signal absence with None so validation_gen skips the
+        # VIT branch (mirrors ff2v_sample; avoids indexing empty grid tensors).
+        if "vit_video" not in video_types:
+            finalized["vit_video_grid_thw"] = None
+            finalized["packed_vit_token_indexes"] = None
+            finalized["packed_vit_tokens"] = None
+        return finalized
+
+    def _build_image_to_video(
+        self,
+        conversation: Conversation,
+        history: List[Turn],
+        turn: Turn,
+        action: TurnAction,
+    ) -> Dict[str, Any]:
+        # i2v bakes the conditioning frame into the target latent (ff2v style); the
+        # input image is NOT a separate VIT/VAE condition span. History visuals are
+        # therefore not used as context for i2v (text history still is).
+        self.sample = self.set_sequence_status()
+        self.frame_condition_idx = [0]
+        curr_video_grid_thw: List[Any] = []
+        video_sizes: List[Any] = []
+
+        first_frame_source = self._latest_visual_vae_tensor(history)
+        if first_frame_source is None:
+            raise ValueError("image_to_video requires an input image in the conversation")
+
+        # Text-only messages (visual placeholders are intentionally omitted for i2v).
+        messages: List[Dict[str, Any]] = []
+        for hist_turn in history:
+            text = hist_turn.joined_text()
+            if text:
+                messages.append({"role": hist_turn.role, "content": [{"type": MODALITY_TEXT, "text": text}]})
+
+        self.sample_task = "t2v"
+        self._prepare_target_size(action, turn, first_frame_source)
+        video_types: List[str] = ["target_vae_video"]
+        vit_num_tokens: List[int] = []
+        num_vid_tokens, mse_loss_indexes = self._append_target_vae(
+            curr_video_grid_thw, video_sizes, first_frame_source=first_frame_source
+        )
+        vit_num_tokens.append(num_vid_tokens)
+        messages.append({"role": ROLE_ASSISTANT, "content": [{"type": action.target_modality}]})
+
+        instruction = self._resolve_instruction(conversation, action, action.target_modality)
+        search_text = turn.joined_text()
+        all_token_id, spans_index, tgt_index, search_index = expand_and_index_multiturn(
+            rendered_text=render_qwenvl_prompt(messages, default_system=instruction, include_assistant_content=True).strip(),
+            tokens=vit_num_tokens,
+            tokenizer=self.tokenizer,
+            target_text="assistant\n",
+            search_text=search_text,
+        )
+
+        self.sample, _, _, _ = self.process_text_template(
+            all_token_id,
+            spans_index,
+            tgt_index,
+            search_index,
+            video_types=video_types,
+            curr=0,
+            curr_rope_id=0,
+            curr_split_len=0,
+            item_loss=0,
+        )
+        sample_lens = len(all_token_id)
+
+        # Re-anchor the frame-conditioned mse indexes to the target span (ff2v_sample).
+        if self.frame_condition_idx and len(self.sample["mse_loss_indexes"]) > 0:
+            mse_first = self.sample["mse_loss_indexes"][0]
+            self.sample["mse_loss_indexes"] = [idx + mse_first for idx in mse_loss_indexes]
+
+        self.sample["sample_task"] = torch.ones(sample_lens) * sample_task_map[self.sample_task]
+
+        caption_all = turn.joined_text()
+        finalized = self._finalize_sample(
+            sample_lens,
+            curr_video_grid_thw,
+            sample_type="gen",
+            additional_fields={
+                "caption": caption_all,
+                "caption_cn": caption_all,
+                "index": str(turn.meta.get("index", "turn")),
+            },
+            video_sizes=video_sizes,
+        )
+        # i2v has no VIT condition spans (the frame is baked into the target).
+        finalized["vit_video_grid_thw"] = None
+        finalized["packed_vit_token_indexes"] = None
+        finalized["packed_vit_tokens"] = None
+        return finalized
+
+    def _build_text(
+        self,
+        conversation: Conversation,
+        history: List[Turn],
+        turn: Turn,
+        action: TurnAction,
+    ) -> Dict[str, Any]:
+        self.sample = self.set_sequence_status()
+        self.sample_task = "t2v"  # unused for text output, set for safety
+        self.frame_condition_idx = []
+        curr_video_grid_thw: List[Any] = []
+        video_sizes: List[Any] = []
+
+        messages, video_types, vit_num_tokens, _ = self._collect_context(
+            history,
+            vae_condition_item=None,
+            curr_video_grid_thw=curr_video_grid_thw,
+            video_sizes=video_sizes,
+        )
+
+        # Append a placeholder assistant answer so the target span exists; it is
+        # discarded before generation (truncated at the first CE-loss index).
+        messages.append({"role": ROLE_ASSISTANT, "content": [{"type": MODALITY_TEXT, "text": _DUMMY_ANSWER}]})
+
+        vision_type = self._primary_vision_type(history)
+        instruction = self._resolve_instruction(conversation, action, vision_type)
+        search_text = turn.joined_text()
+        all_token_id, spans_index, tgt_index, search_index = expand_and_index_multiturn(
+            rendered_text=render_qwenvl_prompt(messages, default_system=instruction, include_assistant_content=True).strip(),
+            tokens=vit_num_tokens,
+            tokenizer=self.tokenizer,
+            target_text="assistant\n",
+            search_text=search_text,
+        )
+        if not tgt_index:
+            raise ValueError("failed to locate the assistant target span in the rendered prompt")
+
+        self.sample, _, _, _ = self.process_text_template(
+            all_token_id,
+            spans_index,
+            tgt_index,
+            search_index,
+            video_types=video_types,
+            curr=0,
+            curr_rope_id=0,
+            curr_split_len=0,
+            item_loss=1,
+        )
+        sample_lens = len(all_token_id)
+        self.sample["sample_task"] = torch.ones(sample_lens) * sample_task_map["t2v"]
+
+        caption_all = turn.joined_text()
+        return self._finalize_sample(
+            sample_lens,
+            curr_video_grid_thw,
+            sample_type="und",
+            additional_fields={
+                "caption": caption_all,
+                "caption_cn": caption_all,
+                "index": str(turn.meta.get("index", "turn")),
+            },
+        )
+
+    # ------------------------------------------------------------------
+    # Small helpers
+    # ------------------------------------------------------------------
+    def _latest_visual_item(self, history: List[Turn]) -> Optional[ContentItem]:
+        """Return the latest visual item to use as the direct VAE edit source.
+
+        Older visual turns remain in the rendered conversation and VIT context,
+        but only this latest item becomes the clean VAE source. This preserves the
+        full multi-turn chat history while keeping Lance video/image edit aligned
+        to one source-target VAE pair.
+        """
+        for turn in reversed(history):
+            visuals = turn.visual_items
+            if visuals:
+                return visuals[-1]
+        return None
+
+    def _latest_visual_vae_tensor(self, history: List[Turn]) -> Optional[torch.Tensor]:
+        for turn in reversed(history):
+            visuals = turn.visual_items
+            if visuals:
+                item = visuals[-1]
+                return self.get_video_tensor_online(
+                    item.value, vision_stream="vae_video", element_dtype=item.type
+                )
+        return None
+
+    def _primary_vision_type(self, history: List[Turn]) -> str:
+        for turn in history:
+            for item in turn.content:
+                if item.type == MODALITY_VIDEO:
+                    return MODALITY_VIDEO
+                if item.type == MODALITY_IMAGE:
+                    return MODALITY_IMAGE
+        return MODALITY_IMAGE
