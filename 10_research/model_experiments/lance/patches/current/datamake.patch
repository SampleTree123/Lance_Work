+"""Adapter metadata and target selection, independent of any LoRA implementation."""
+from dataclasses import dataclass, asdict
+from typing import Dict, Mapping, Tuple
+
+LORA_CONFIG_FILENAME = "datamake_lora_config.json"
+
+LORA_SCHEMA_VERSION = "datamake_lance_generation_lora_v1"
+
+LORA_ADAPTER_FILENAME = "adapter.safetensors"
+
+OFFICIAL_VIDEO_GENERATION_TARGET_SIGNATURE = (
+    "317edc33a16fabc9f3988aac84dcd48487af732ba977b660ae44b4ca09f65cac"
+)
+
+GENERATION_EXPERT_SUFFIXES: Tuple[str, ...] = (
+    "self_attn.q_proj_moe_gen",
+    "self_attn.k_proj_moe_gen",
+    "self_attn.v_proj_moe_gen",
+    "self_attn.o_proj_moe_gen",
+    "mlp_moe_gen.gate_proj",
+    "mlp_moe_gen.up_proj",
+    "mlp_moe_gen.down_proj",
+)
+
+GENERATION_IO_NAMES: Tuple[str, ...] = (
+    "time_embedder.mlp.0",
+    "time_embedder.mlp.2",
+    "vae2llm",
+    "llm2vae",
+)
+
+@dataclass(frozen=True)
+class GenerationLoRAConfig:
+    rank: int = 64
+    alpha: float = 64.0
+    dropout: float = 0.0
+    target_scope: str = "generation_experts_and_io"
+    expected_target_modules: int = 256
+    expected_target_signature_sha256: str = ""
+    schema_version: str = LORA_SCHEMA_VERSION
+
+    def validate(self) -> None:
+        if self.schema_version != LORA_SCHEMA_VERSION:
+            raise ValueError(f"unsupported LoRA schema: {self.schema_version!r}")
+        if self.rank <= 0:
+            raise ValueError(f"LoRA rank must be positive, got {self.rank}")
+        if self.alpha <= 0:
+            raise ValueError(f"LoRA alpha must be positive, got {self.alpha}")
+        if not 0.0 <= self.dropout < 1.0:
+            raise ValueError(f"LoRA dropout must be in [0, 1), got {self.dropout}")
+        if self.target_scope not in {
+            "generation_experts",
+            "generation_experts_and_io",
+        }:
+            raise ValueError(f"unsupported LoRA target scope: {self.target_scope!r}")
+        if self.expected_target_modules < 1:
+            raise ValueError("expected_target_modules must be positive")
+        if self.expected_target_signature_sha256 and (
+            len(self.expected_target_signature_sha256) != 64
+            or any(
+                char not in "0123456789abcdef"
+                for char in self.expected_target_signature_sha256
+            )
+        ):
+            raise ValueError("expected target signature must be lowercase SHA-256")
+
+    def to_dict(self) -> Dict[str, object]:
+        return asdict(self)
+
+    @classmethod
+    def from_dict(cls, payload: Mapping[str, object]) -> "GenerationLoRAConfig":
+        config = cls(
+            rank=int(payload["rank"]),
+            alpha=float(payload["alpha"]),
+            dropout=float(payload["dropout"]),
+            target_scope=str(payload["target_scope"]),
+            expected_target_modules=int(payload["expected_target_modules"]),
+            expected_target_signature_sha256=str(
+                payload.get("expected_target_signature_sha256", "")
+            ),
+            schema_version=str(payload["schema_version"]),
+        )
+        config.validate()
+        return config
+
+SCHEMA = "datamake_lance_branch_lora_v1"
+
+UND_SUFFIXES = (
+    "self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj",
+    "self_attn.o_proj", "mlp.gate_proj", "mlp.up_proj", "mlp.down_proj",
+)
+
+@dataclass(frozen=True)
+class BranchLoRAConfig(GenerationLoRAConfig):
+    schema_version: str = SCHEMA
+
+    def validate(self):
+        if self.schema_version != SCHEMA:
+            raise ValueError("Not a Stage6 branch adapter")
+        if self.target_scope not in {"generation_experts_and_io", "both_branches"}:
+            raise ValueError(f"Unknown branch scope: {self.target_scope}")
+        if self.rank <= 0 or self.alpha <= 0 or not 0 <= self.dropout < 1:
+            raise ValueError("Invalid LoRA rank/alpha/dropout")
+        if self.expected_target_modules <= 0:
+            raise ValueError("LoRA target count must be positive")
+
+def config_from_profile(profile):
+    frozen = profile["freeze"]["understanding_adapters"]
+    lora = profile["lora"]
+    return BranchLoRAConfig(
+        rank=lora["rank"], alpha=lora["alpha"], dropout=lora["dropout"],
+        target_scope="generation_experts_and_io" if frozen else "both_branches",
+        expected_target_modules=256 if frozen else 508,
+    )
+
+def is_generation_target(name):
+    return name in GENERATION_IO_NAMES or (
+        name.startswith("language_model.model.layers.")
+        and name.endswith(GENERATION_EXPERT_SUFFIXES)
+    )
+
+def is_understanding_target(name):
+    return (name.startswith("language_model.model.layers.")
+            and name.endswith(UND_SUFFIXES))
