+"""Prefix-preserving online histories. Workers only read media; GPU work is local."""
+from contextlib import contextmanager
+import hashlib
+
+import torch
+
+from data.dataset_base_train import simple_custom_collate
+from data.datasets_factory.datamake_online_rollout_turn import process_online_rollout_row
+from train.datamake_stage2_lora_data import IndexedPrefixDataset, locate_prefix, preprocessing_rng
+
+REQUEST_KEY = "pred_x0_prefix_request"
+
+
+def history_seed(seed, round_number):
+    return int.from_bytes(hashlib.sha256(
+        f"pred_x0_v1:{seed}:{round_number}".encode()).digest()[:8], "little")
+
+
+def make_history_row(row, round_number, histories):
+    if not 1 <= round_number <= int(row["target_round"]) or len(histories) != round_number - 1:
+        raise ValueError("History count must match the selected turn")
+    if any(video.requires_grad or video.grad_fn is not None for video in histories):
+        raise ValueError("Generated history must be detached")
+    result = dict(row)
+    result.update(target_round=round_number, context_length=round_number,
+                  prompts=list(row["prompts"][:round_number]),
+                  video_paths=list(row["video_paths"][:round_number + 1]))
+    result["video_inputs"] = [row["video_paths"][0], *histories, row["video_paths"][round_number]]
+    return result
+
+
+@contextmanager
+def generation_rng(seed, device):
+    # Restore CPU, Python, NumPy AND this rank's CUDA RNG before the target forward.
+    with preprocessing_rng(seed), torch.random.fork_rng(devices=[device]):
+        torch.cuda.default_generators[device].manual_seed(seed)
+        yield
+
+
+class PredX0PrefixDataset(IndexedPrefixDataset):
+    active = None
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        PredX0PrefixDataset.active = self
+
+    def __getitem__(self, index):
+        worker, row_index, cycle = locate_prefix(index, [len(rows) for rows in self.rows])
+        row = self.rows[worker][row_index]
+        if int(row["target_round"]) == 1:
+            # Includes all CoinVE records: preserve the exact original implementation.
+            return super().__getitem__(index)
+        seed = int.from_bytes(hashlib.sha256(
+            f"{self.seed}:{self.source.local_rank}:{index}".encode()).digest()[:8], "little")
+        cache = {}
+        media = {path: self.source._read_media_bytes(path, cache) for path in row["video_paths"]}
+        return {REQUEST_KEY: dict(row=row, seed=seed, worker=worker, row_index=row_index,
+                                 cycle=cycle, microstep=index, media=media)}
+
+    def pack_turn(self, request, round_number, histories, seed):
+        row = make_history_row(request["row"], round_number, histories)
+        worker, row_index = request["worker"], request["row_index"]
+        original_reader = self.source._read_media_bytes
+        try:
+            # Reuse bytes prefetched by the worker for all turns of this prefix.
+            self.source._read_media_bytes = lambda path, cache: request["media"][path]
+            with preprocessing_rng(seed):
+                sample = process_online_rollout_row(
+                    self.source, row, 0, 0, row_index, worker, self.paths[worker])
+                if sample is None:
+                    raise RuntimeError(f"Failed to pack {row['sample_id']} turn {round_number}")
+                if sample["num_tokens"] + 2 * len(sample["sequence_plan"]) > self.packer.max_num_tokens_per_sample:
+                    raise ValueError("History prefix exceeds sample token budget")
+                status = self.packer.pack_sequence(sample, self.packer.set_sequence_status())
+                if status["curr"] > self.packer.max_num_tokens:
+                    raise ValueError("History prefix exceeds packed token budget")
+                packed = self.packer.to_tensor(status)
+        finally:
+            self.source._read_media_bytes = original_reader
+        packed["batch_data_indexes"] = [{**sample["data_indexes"],
+            "microstep": request["microstep"], "cycle": request["cycle"]}]
+        return simple_custom_collate([packed])
