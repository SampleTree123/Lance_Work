+#!/bin/bash
+
+# Unified multi-turn multimodal chat (inference-only PoC).
+# Mirrors the model recipe flags used by inference_lance.sh.
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+cd "$SCRIPT_DIR"
+source "$SCRIPT_DIR/benchmarks/sample_env.sh"
+
+# ========================= Parameters =========================
+NUM_GPUS=${NUM_GPUS:-1}
+
+MODEL_PATH=${MODEL_PATH:-"downloads/Lance_3B"}
+CONVERSATION_PATH=${CONVERSATION_PATH:-"config/examples/multiturn_example.json"}
+SAVE_PATH=${SAVE_PATH:-"results/multiturn"}
+
+RESOLUTION=${RESOLUTION:-"image_768res"}   # image_768res | video_480p
+NUM_FRAMES=${NUM_FRAMES:-50}               # default frames for video outputs
+VIDEO_HEIGHT=${VIDEO_HEIGHT:-768}
+VIDEO_WIDTH=${VIDEO_WIDTH:-768}
+
+VALIDATION_NUM_TIMESTEPS=${VALIDATION_NUM_TIMESTEPS:-30}
+VALIDATION_TIMESTEP_SHIFT=${VALIDATION_TIMESTEP_SHIFT:-3.5}
+VALIDATION_DATA_SEED=${VALIDATION_DATA_SEED:-42}
+CFG_TEXT_SCALE=${CFG_TEXT_SCALE:-4.0}
+USE_KVCACHE=${USE_KVCACHE:-true}
+
+# ========================= Command-line Arguments =========================
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --NUM_GPUS) NUM_GPUS="$2"; shift 2 ;;
+        --MODEL_PATH) MODEL_PATH="$2"; shift 2 ;;
+        --CONVERSATION_PATH) CONVERSATION_PATH="$2"; shift 2 ;;
+        --SAVE_PATH) SAVE_PATH="$2"; shift 2 ;;
+        --RESOLUTION) RESOLUTION="$2"; shift 2 ;;
+        --NUM_FRAMES) NUM_FRAMES="$2"; shift 2 ;;
+        --VIDEO_HEIGHT) VIDEO_HEIGHT="$2"; shift 2 ;;
+        --VIDEO_WIDTH) VIDEO_WIDTH="$2"; shift 2 ;;
+        --VALIDATION_NUM_TIMESTEPS) VALIDATION_NUM_TIMESTEPS="$2"; shift 2 ;;
+        --VALIDATION_TIMESTEP_SHIFT) VALIDATION_TIMESTEP_SHIFT="$2"; shift 2 ;;
+        --VALIDATION_DATA_SEED) VALIDATION_DATA_SEED="$2"; shift 2 ;;
+        --CFG_TEXT_SCALE) CFG_TEXT_SCALE="$2"; shift 2 ;;
+        --USE_KVCACHE) USE_KVCACHE="$2"; shift 2 ;;
+        -h|--help)
+            echo "Usage: bash multiturn_chat.sh [OPTIONS]"
+            echo "  --MODEL_PATH downloads/Lance_3B"
+            echo "  --CONVERSATION_PATH config/examples/multiturn_example.json"
+            echo "  --SAVE_PATH results/multiturn"
+            exit 0
+            ;;
+        *)
+            echo "Unknown option: $1"; echo "Use -h or --help for usage."; exit 1 ;;
+    esac
+done
+
+# ============================== Environment and Distributed Setup ==============================
+lance_setup_common_env
+lance_setup_distributed_env "$NUM_GPUS"
+lance_setup_shard_env 1
+
+echo "================================================"
+echo "Lance Multi-turn Multimodal Chat"
+echo "================================================"
+echo "Model path:        ${MODEL_PATH}"
+echo "Conversation:      ${CONVERSATION_PATH}"
+echo "Save path:         ${SAVE_PATH}"
+echo "Resolution:        ${RESOLUTION}"
+echo "================================================"
+
+accelerate launch \
+    --num_machines          $NUM_MACHINES \
+    --num_processes         $TOTAL_RANK \
+    --machine_rank          $MACHINE_RANK \
+    --main_process_ip       $MAIN_PROCESS_IP \
+    --main_process_port     $MAIN_PROCESS_PORT \
+    --mixed_precision       bf16 \
+    multiturn_chat.py \
+    --model_path            "$MODEL_PATH" \
+    --vit_type              qwen_2_5_vl_original \
+    --llm_qk_norm           true \
+    --llm_qk_norm_und       true \
+    --llm_qk_norm_gen       true \
+    --tie_word_embeddings   false \
+    --validation_num_timesteps $VALIDATION_NUM_TIMESTEPS \
+    --validation_timestep_shift $VALIDATION_TIMESTEP_SHIFT \
+    --copy_init_moe         true \
+    --max_num_frames        121 \
+    --max_latent_size       64 \
+    --latent_patch_size     1 1 1 \
+    --visual_und            true \
+    --visual_gen            true \
+    --vae_model_type        wan \
+    --apply_qwen_2_5_vl_pos_emb true \
+    --apply_chat_template   false \
+    --cfg_type              0 \
+    --validation_data_seed  $VALIDATION_DATA_SEED \
+    --video_height          $VIDEO_HEIGHT \
+    --video_width           $VIDEO_WIDTH \
+    --num_frames            $NUM_FRAMES \
+    --resolution            "$RESOLUTION" \
+    --text_template         true \
+    --cfg_text_scale        $CFG_TEXT_SCALE \
+    --use_KVcache           "$USE_KVCACHE" \
+    --conversation_path     "$CONVERSATION_PATH" \
+    --save_path             "$SAVE_PATH"
+
+echo ""
+echo "================================================"
+echo "Done! Results: ${SAVE_PATH}"
+echo "================================================"
