+    _require(training_args.wandb_runid, expected_run_id, "profile W&B run id")
+    _require(
+        training_args.wandb_offline,
+        online_args.datamake_smoke_mode or wandb_profile["mode"] != "online",
+        "profile W&B mode",
+    )
