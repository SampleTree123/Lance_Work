+def main() -> None:
+    reject_duplicate_cli_options(sys.argv[1:])
+    if not torch.cuda.is_available():
+        raise RuntimeError("CUDA is required for online rollout training")
+    torch.set_num_threads(1)
+    torch.set_num_interop_threads(1)
+    dist.init_process_group("nccl")
+    global_rank = dist.get_rank()
+    world_size = get_world_size()
+    local_rank = global_rank % torch.cuda.device_count()
+    device = local_rank
+    torch.cuda.set_device(device)
+
+    parser = HfArgumentParser(
+        (ModelArguments, DataArguments, TrainingArguments, OnlineRolloutArguments)
+    )
+    model_args, data_args, training_args, online_args = cast(
+        Tuple[
+            ModelArguments,
+            DataArguments,
+            TrainingArguments,
+            OnlineRolloutArguments,
+        ],
+        parser.parse_args_into_dataclasses(),
+    )
+    validate_frozen_training_arguments(
+        model_args, data_args, training_args, online_args, world_size
+    )
+    profile_path = Path(online_args.datamake_profile_path).resolve()
+    _run_profile_contract_check(
+        profile_path, model_args, data_args, online_args, training_args
+    )
+
+    logger = get_logger()
+    log_rank0 = (
+        (lambda message: logger.info(message))
+        if global_rank == 0
+        else (lambda *_: None)
+    )
+    setup_output_paths(training_args, logger, global_rank)
+    setup_rank0_logging_and_wandb(
+        model_args, data_args, training_args, logger, global_rank
+    )
+    save_training_config(model_args, data_args, training_args, logger)
+
+    seed = training_args.global_seed * world_size + global_rank
+    set_seed(seed)
+    prepare_model_paths(model_args, training_args)
+    (
+        llm_config,
+        language_model,
+        vit_config,
+        vit_model,
+        vae_model,
+        vae_config,
+    ) = setup_model_components(model_args, training_args, log_rank0)
+    config = LanceConfig(
+        visual_gen=training_args.visual_gen,
+        visual_und=training_args.visual_und,
+        llm_config=llm_config,
+        vit_config=vit_config if training_args.visual_und else None,
+        vae_config=vae_config if training_args.visual_gen else None,
+        latent_patch_size=model_args.latent_patch_size,
+        max_num_frames=model_args.max_num_frames,
+        max_latent_size=model_args.max_latent_size,
+        vit_max_num_patch_per_side=model_args.vit_max_num_patch_per_side,
+        connector_act=model_args.connector_act,
+        interpolate_pos=model_args.interpolate_pos,
+        timestep_shift=training_args.timestep_shift,
+    )
+    model = Lance(
+        language_model=language_model,
+        vit_model=vit_model if training_args.visual_und else None,
+        vit_type=model_args.vit_type,
+        config=config,
+        training_args=training_args,
+    )
+    tokenizer = Qwen2Tokenizer.from_pretrained(model_args.model_path)
+    tokenizer, new_token_ids, num_new_tokens = add_special_tokens(tokenizer)
+    load_ckpt = prepare_checkpoint_loader(
+        model_args,
+        training_args,
+        llm_config,
+        language_model,
+        tokenizer,
+        num_new_tokens,
+        log_rank0,
+        report_dir=training_args.config_dir,
+    )
+    load_ckpt(model, ema=False)
+
+    lora_config = GenerationLoRAConfig(
+        rank=online_args.datamake_lora_rank,
+        alpha=online_args.datamake_lora_alpha,
+        dropout=online_args.datamake_lora_dropout,
+        target_scope=online_args.datamake_lora_target_scope,
+        expected_target_modules=online_args.datamake_lora_expected_target_modules,
+        expected_target_signature_sha256=(
+            online_args.datamake_lora_expected_target_signature_sha256
+        ),
+    )
+    lora_report = apply_generation_lora(model, lora_config)
+    image_token_id = get_image_token_id(language_model)
+    fsdp_config = build_fsdp_config(training_args)
+    fsdp_model = fsdp_wrapper(model, fsdp_config)
+    apply_activation_checkpointing(
+        fsdp_model,
+        checkpoint_wrapper_fn=functools.partial(
+            checkpoint_wrapper, checkpoint_impl=CheckpointImpl.NO_REENTRANT
+        ),
+        check_fn=grad_checkpoint_check_fn,
+    )
+    save_trainable_parameters(
+        model, fsdp_model, training_args, logger, global_rank
+    )
+    params_to_train = [parameter for parameter in fsdp_model.parameters() if parameter.requires_grad]
+    optimizer = torch.optim.AdamW(
+        params_to_train,
+        lr=training_args.lr,
+        betas=(training_args.beta1, training_args.beta2),
+        eps=training_args.eps,
+        weight_decay=0,
+    )
+    scheduler = build_lr_scheduler(optimizer, training_args)
+
+    records, chain_manifest = load_chain_records(
+        Path(online_args.datamake_chain_manifest)
+    )
+    dataset_config = build_train_dataset_config(
+        data_args, model_args, training_args, vae_config
+    )
+    turn_packer = OnlineTurnPacker(
+        dataset_config,
+        tokenizer,
+        new_token_ids,
+        model_args,
+        data_args,
+        training_args,
+        image_token_id,
+        global_rank,
+        world_size,
+    )
+    training_contract = None
+    if global_rank == 0:
+        training_contract = build_online_contract(
+            online_args,
+            profile_path,
+            Path(online_args.datamake_chain_manifest),
+            Path(data_args.dataset_config_file),
+            Path(model_args.model_path),
+            lora_config.to_dict(),
+        )
+    contract_holder = [training_contract]
+    dist.broadcast_object_list(contract_holder, src=0)
+    training_contract = contract_holder[0]
+    if not isinstance(training_contract, dict):
+        raise RuntimeError("rank 0 did not broadcast the online training contract")
+    if global_rank == 0:
+        Path(training_args.config_dir, "datamake_online_training_contract.json").write_text(
+            json.dumps(training_contract, indent=2, sort_keys=True) + "\n",
+            encoding="utf-8",
+        )
+        wandb.config.update(
+            {
+                "datamake_online_rollout": training_contract["rollout"],
+                "datamake_loss_contract": training_contract["loss"],
+                "datamake_lora": lora_config.to_dict(),
+                "datamake_lora_trainable_parameters": lora_report[
+                    "trainable_parameter_count"
+                ],
+                "datamake_chain_count": len(records),
+                "datamake_target_video_count": chain_manifest[
+                    "target_video_count"
+                ],
+            },
+            allow_val_change=True,
+        )
+    dist.barrier()
+
+    train_step = 0
+    if training_args.resume_from:
+        restored = load_lora_checkpoint(
+            Path(training_args.resume_from),
+            fsdp_model,
+            optimizer,
+            scheduler,
+            lora_config,
+            training_contract,
+        )
+        train_step = int(restored["next_step"])
+    elif training_args.auto_resume:
+        raise ValueError("auto_resume is disabled; resolve an explicit complete checkpoint")
+
+    all_windows: List[
+        Tuple[int, int, List[List[ScheduledChain]]]
+    ] = []
+    per_epoch_windows = None
+    for epoch in range(online_args.datamake_num_epochs):
+        groups = build_epoch_groups(
+            records, world_size, data_args.data_seed, epoch
+        )
+        windows = optimizer_windows(
+            groups, online_args.datamake_gradient_accumulation_steps
+        )
+        if per_epoch_windows is None:
+            per_epoch_windows = len(windows)
+        elif per_epoch_windows != len(windows):
+            raise RuntimeError("optimizer steps per epoch changed")
+        all_windows.extend((epoch, index, window) for index, window in enumerate(windows))
+    if online_args.datamake_smoke_mode:
+        all_windows = all_windows[: training_args.total_steps]
+    _require(len(all_windows), training_args.total_steps, "scheduled optimizer steps")
+    if train_step > len(all_windows):
+        raise ValueError("resume step is beyond the training schedule")
+
+    fsdp_model.train()
+    log_rank0(
+        f"Online rollout schedule: chains={len(records)}, epochs={online_args.datamake_num_epochs}, "
+        f"steps/epoch={per_epoch_windows}, total_steps={len(all_windows)}, "
+        f"starting_step={train_step}"
+    )
+    try:
+        for step_index in range(train_step, len(all_windows)):
+            epoch, epoch_step, window = all_windows[step_index]
+            optimizer.zero_grad(set_to_none=True)
+            global_targets = window_target_count(window)
+            if global_targets <= 0:
+                raise RuntimeError("optimizer window contains no real targets")
+            backward_scale = float(world_size) / float(global_targets)
+            local_loss_sum = 0.0
+            local_targets = 0
+            local_rollouts = 0
+            local_round_loss_sum = [0.0] * 5
+            local_round_count = [0.0] * 5
+            memory_keys = (
+                "allocated_before_mb",
+                "reserved_before_mb",
+                "allocated_summoned_mb",
+                "reserved_summoned_mb",
+                "peak_allocated_mb",
+                "peak_reserved_mb",
+                "allocated_after_mb",
+                "reserved_after_mb",
+            )
+            local_rollout_memory_max = {key: 0.0 for key in memory_keys}
+            rollout_seconds = 0.0
+            train_seconds = 0.0
+            torch.cuda.synchronize(device)
+            window_started = time()
+
+            for group in window:
+                scheduled = group[global_rank]
+                record = scheduled.record
+                max_rounds = max(item.record.round_count for item in group)
+                generated_history: List[torch.Tensor] = []
+
+                for round_number in range(1, max_rounds + 1):
+                    active = (
+                        scheduled.contributes_loss
+                        and round_number <= record.round_count
+                    )
+                    effective_round = min(round_number, record.round_count)
+                    effective_history = generated_history[: effective_round - 1]
+                    batch = turn_packer.pack(
+                        record, effective_round, effective_history
+                    )
+                    turn_data, video_sizes = prepare_turn_data(
+                        batch, device, vae_model
+                    )
+
+                    torch.cuda.synchronize(device)
+                    train_started = time()
+                    with torch.amp.autocast(
+                        "cuda", enabled=True, dtype=torch.bfloat16
+                    ):
+                        loss_dict = fsdp_model(**turn_data)
+                        target_loss = per_target_flow_loss(loss_dict)
+                        backward_loss = target_loss * backward_scale
+                        if not active:
+                            backward_loss = backward_loss * 0.0
+                    bad = torch.tensor(
+                        0 if torch.isfinite(backward_loss) else 1,
+                        device=device,
+                        dtype=torch.int32,
+                    )
+                    dist.all_reduce(bad, op=dist.ReduceOp.SUM)
+                    if bad.item():
+                        raise FloatingPointError(
+                            f"non-finite loss at step={step_index}, "
+                            f"chain={record.chain_id}, round={round_number}"
+                        )
+                    backward_loss.backward()
+                    torch.cuda.synchronize(device)
+                    train_seconds += time() - train_started
+                    if active:
+                        value = float(target_loss.detach().item())
+                        local_loss_sum += value
+                        local_targets += 1
+                        local_round_loss_sum[round_number - 1] += value
+                        local_round_count[round_number - 1] += 1
+
+                    if round_number < max_rounds:
+                        needs_history = round_number < record.round_count
+                        torch.cuda.synchronize(device)
+                        rollout_started = time()
+                        rollout_telemetry: Dict[str, float] = {}
+                        seed_value = stable_turn_seed(
+                            training_args.global_seed,
+                            epoch,
+                            record.chain_id,
+                            effective_round,
+                        )
+                        history_video = generate_with_retry(
+                            fsdp_model=fsdp_model,
+                            vae_model=vae_model,
+                            data=turn_data,
+                            video_sizes=video_sizes,
+                            online_args=online_args,
+                            model_args=model_args,
+                            training_args=training_args,
+                            new_token_ids=new_token_ids,
+                            image_token_id=image_token_id,
+                            device=device,
+                            seed=seed_value,
+                            save_output=needs_history,
+                            telemetry=rollout_telemetry,
+                        )
+                        torch.cuda.synchronize(device)
+                        rollout_seconds += time() - rollout_started
+                        for key in memory_keys:
+                            local_rollout_memory_max[key] = max(
+                                local_rollout_memory_max[key],
+                                float(rollout_telemetry[key]),
+                            )
+                        if needs_history:
+                            if history_video is None:
+                                raise RuntimeError("real rollout did not return a tensor")
+                            generated_history.append(history_video)
+                            local_rollouts += 1
+                        dist.barrier()
+                    del turn_data, batch, loss_dict, target_loss, backward_loss
+
+                generated_history.clear()
+
+            total_norm = fsdp_model.clip_grad_norm_(training_args.max_grad_norm)
+            optimizer.step()
+            scheduler.step()
+            torch.cuda.synchronize(device)
+            completed_steps = step_index + 1
+
+            reduced = _all_reduce_metrics(
+                [
+                    local_loss_sum,
+                    float(local_targets),
+                    float(local_rollouts),
+                    rollout_seconds,
+                    train_seconds,
+                    *local_round_loss_sum,
+                    *local_round_count,
+                ],
+                device,
+            )
+            memory_max = _all_reduce_max_metrics(
+                [local_rollout_memory_max[key] for key in memory_keys], device
+            )
+            global_loss_sum, global_target_count, global_rollouts = reduced[:3]
+            if int(global_target_count) != global_targets:
+                raise RuntimeError(
+                    f"target weighting mismatch: {global_target_count} != {global_targets}"
+                )
+            loss_mean = global_loss_sum / global_target_count
+            step_seconds = time() - window_started
+            if global_rank == 0 and completed_steps % training_args.log_every == 0:
+                round_loss_sum = reduced[5:10]
+                round_count = reduced[10:15]
+                metrics = {
+                    "mse": loss_mean,
+                    "lr": optimizer.param_groups[0]["lr"],
+                    "total_norm": float(total_norm.item()),
+                    "target_videos": global_target_count,
+                    "rollout_videos": global_rollouts,
+                    "chains": world_size
+                    * online_args.datamake_gradient_accumulation_steps,
+                    "step_time_sec": step_seconds,
+                    "rollout_time_sec_rank_sum": reduced[3],
+                    "train_time_sec_rank_sum": reduced[4],
+                    "mem_allocated_mb": memory_max[4],
+                    "mem_reserved_mb": memory_max[5],
+                    "epoch": epoch,
+                    "epoch_step": epoch_step,
+                }
+                metrics.update(
+                    {
+                        f"rollout_{key}_rank_max": value
+                        for key, value in zip(memory_keys, memory_max)
+                    }
+                )
+                for index, (loss_sum, count) in enumerate(
+                    zip(round_loss_sum, round_count), start=1
+                ):
+                    if count:
+                        metrics[f"mse_round_{index}"] = loss_sum / count
+                        metrics[f"targets_round_{index}"] = count
+                wandb.log(metrics, step=completed_steps)
+                logger.info(
+                    f"(step={completed_steps:07d}) mse={loss_mean:.6f}, "
+                    f"targets={int(global_target_count)}, rollouts={int(global_rollouts)}, "
+                    f"grad_norm={float(total_norm.item()):.6f}, "
+                    f"lr={optimizer.param_groups[0]['lr']:.8g}, "
+                    f"step_time={step_seconds:.2f}s"
+                )
+            periodic = training_args.save_every > 0 and (
+                completed_steps % training_args.save_every == 0
+            )
+            final = training_args.save_final_checkpoint and (
+                completed_steps == training_args.total_steps
+            )
+            if periodic or final:
+                save_lora_checkpoint(
+                    Path(training_args.ckpt_dir),
+                    completed_steps,
+                    fsdp_model,
+                    optimizer,
+                    scheduler,
+                    lora_config,
+                    training_contract,
+                    {
+                        "epoch": epoch,
+                        "epoch_step": epoch_step + 1,
+                        "schedule_seed": data_args.data_seed,
+                        "gradient_accumulation_steps": (
+                            online_args.datamake_gradient_accumulation_steps
+                        ),
+                    },
+                    training_args.keep_last_checkpoints,
+                    logger,
+                )
+                gc.collect()
+                torch.cuda.empty_cache()
+    except Exception:
+        logger.error(
+            f"[ONLINE ROLLOUT TRAINING EXCEPTION] step={locals().get('step_index')}, "
+            f"rank={global_rank}"
+        )
+        traceback.print_exc()
+        optimizer.zero_grad(set_to_none=True)
+        raise
+    if global_rank == 0:
+        logger.info("Online rollout LoRA training complete")
+        wandb.finish()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
