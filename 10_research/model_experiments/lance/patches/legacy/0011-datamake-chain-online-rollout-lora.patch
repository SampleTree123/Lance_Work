+class OnlineTurnPacker:
+    """Reuse the validated role-aware DataMake encoder for dynamic prefixes."""
+
+    def __init__(
+        self,
+        dataset_config,
+        tokenizer,
+        new_token_ids,
+        model_args: ModelArguments,
+        data_args: DataArguments,
+        training_args: TrainingArguments,
+        image_token_id: int,
+        global_rank: int,
+        world_size: int,
+    ) -> None:
+        self.packer = PackedDataset(
+            dataset_config,
+            tokenizer=tokenizer,
+            special_tokens=new_token_ids,
+            local_rank=global_rank,
+            world_size=world_size,
+            interpolate_pos=model_args.interpolate_pos,
+            use_flex=training_args.use_flex,
+            data_status=None,
+            apply_chat_template=training_args.apply_chat_template,
+            image_token_id=image_token_id,
+            cfg_type=training_args.cfg_type,
+            cfg_uncond_token_id=training_args.cfg_uncond_token_id,
+            **vars(data_args),
+        )
+        if len(self.packer.grouped_datasets) != 1:
+            raise ValueError("online trainer requires exactly one DataMake dataset")
+        self.row_encoder = self.packer.grouped_datasets[0]
+
+    def pack(
+        self,
+        record: ChainRecord,
+        round_number: int,
+        generated_history: Sequence[torch.Tensor],
+    ):
+        row = make_turn_row(record, round_number, generated_history)
+        sample = process_online_rollout_row(
+            self.row_encoder,
+            row,
+            parquet_idx=-1,
+            row_group_id=-1,
+            row_idx=round_number - 1,
+            worker_id=0,
+            parquet_file_path="<online-rollout-memory-row>",
+        )
+        if sample is None:
+            raise RuntimeError(
+                f"role-aware encoding failed for {record.chain_id} round {round_number}"
+            )
+        estimated = int(sample["num_tokens"]) + 2 * len(sample["sequence_plan"])
+        if estimated > self.packer.max_num_tokens_per_sample:
+            raise ValueError(
+                f"{record.chain_id} round {round_number} exceeds max tokens: "
+                f"{estimated} > {self.packer.max_num_tokens_per_sample}"
+            )
+        sequence = self.packer.set_sequence_status()
+        sequence = self.packer.pack_sequence(sample, sequence)
+        if sequence["curr"] > self.packer.max_num_tokens:
+            raise ValueError(
+                f"packed sequence exceeds max tokens: {sequence['curr']} > "
+                f"{self.packer.max_num_tokens}"
+            )
+        packed = self.packer.to_tensor(sequence)
+        packed["batch_data_indexes"] = [
+            {
+                "dataset_name": "datamake_online_rollout",
+                "chain_id": record.chain_id,
+                "target_round": round_number,
+            }
+        ]
+        return simple_custom_collate([packed])
+
