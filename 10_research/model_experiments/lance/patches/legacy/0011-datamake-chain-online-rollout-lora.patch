+    if online_args.datamake_smoke_mode:
+        if training_args.total_steps > profile["run"]["total_steps"]:
+            raise ValueError("smoke steps exceed the frozen full schedule")
+    else:
+        _require(profile["run"]["total_steps"], training_args.total_steps, "profile total steps")
