+@torch.no_grad()
+def generate_detached_history(
+    fsdp_model: Lance,
+    vae_model,
+    data: Mapping[str, Any],
+    video_sizes: List[Tuple[int, int, int]],
+    online_args: OnlineRolloutArguments,
+    model_args: ModelArguments,
+    training_args: TrainingArguments,
+    new_token_ids: Mapping[str, int],
+    image_token_id: int,
+    device: int,
+    seed: int,
+    save_output: bool,
+    telemetry: Dict[str, float],
+) -> torch.Tensor | None:
+    telemetry.clear()
+    torch.cuda.reset_peak_memory_stats(device)
+    telemetry["allocated_before_mb"] = torch.cuda.memory_allocated(device) / 1024**2
+    telemetry["reserved_before_mb"] = torch.cuda.memory_reserved(device) / 1024**2
+    params = rollout_generation_parameters(
+        data,
+        video_sizes,
+        online_args,
+        model_args,
+        training_args,
+        new_token_ids,
+        image_token_id,
+        device,
+        seed,
+    )
+    fsdp_model.eval()
+    try:
+        with torch.amp.autocast("cuda", enabled=True, dtype=torch.bfloat16):
+            with FSDP.summon_full_params(
+                fsdp_model, writeback=False, rank0_only=False, recurse=True
+            ):
+                telemetry["allocated_summoned_mb"] = (
+                    torch.cuda.memory_allocated(device) / 1024**2
+                )
+                telemetry["reserved_summoned_mb"] = (
+                    torch.cuda.memory_reserved(device) / 1024**2
+                )
+                if online_args.datamake_rollout_use_kv_cache:
+                    generated = fsdp_model.validation_gen_KVcache(**params)
+                else:
+                    generated = fsdp_model.validation_gen(**params)
+    finally:
+        fsdp_model.train()
+        telemetry["peak_allocated_mb"] = (
+            torch.cuda.max_memory_allocated(device) / 1024**2
+        )
+        telemetry["peak_reserved_mb"] = (
+            torch.cuda.max_memory_reserved(device) / 1024**2
+        )
+        telemetry["allocated_after_mb"] = (
+            torch.cuda.memory_allocated(device) / 1024**2
+        )
+        telemetry["reserved_after_mb"] = (
+            torch.cuda.memory_reserved(device) / 1024**2
+        )
+    if isinstance(generated, tuple):
+        generated = generated[0]
+    if not generated or not generated[0]:
+        raise RuntimeError("online rollout returned no target latent")
+    target_latent = generated[0][-1].detach()
+    if not save_output:
+        del target_latent, generated
+        return None
+    decoded = vae_model.vae_decode([target_latent])[0]
+    if decoded.ndim != 4 or decoded.shape[0] != 3:
+        raise RuntimeError(
+            f"decoded rollout must be CTHW, got {tuple(decoded.shape)}"
+        )
+    # Keep the exact VAE-decoded pixels.  CPU fp16 bounds history memory while
+    # avoiding an MP4 encode/decode cycle before the next ViT/VAE encoding.
+    history = decoded.detach().clamp(-1.0, 1.0).to(
+        device="cpu", dtype=torch.float16
+    ).contiguous()
+    del decoded, target_latent, generated
+    return history
+
+
+def generate_with_retry(**kwargs) -> torch.Tensor | None:
+    retries = int(kwargs["online_args"].datamake_rollout_retry_count)
+    last_error: Exception | None = None
+    for attempt in range(retries + 1):
+        result = None
+        try:
+            result = generate_detached_history(**kwargs)
+            failed = 0
+        except Exception as error:
+            last_error = error
+            failed = 1
+        failure = torch.tensor(failed, dtype=torch.int32, device=kwargs["device"])
+        dist.all_reduce(failure, op=dist.ReduceOp.SUM)
+        if failure.item() == 0:
+            return result
+        dist.barrier()
+        if attempt >= retries:
+            break
+        if failed == 0:
+            last_error = RuntimeError("another rank failed the synchronized rollout")
+        gc.collect()
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+    raise RuntimeError(
+        f"online rollout failed after {retries + 1} deterministic attempts"
+    ) from last_error
+
+
+def _all_reduce_metrics(values: Sequence[float], device: int) -> List[float]:
+    tensor = torch.tensor(list(values), dtype=torch.float64, device=device)
+    dist.all_reduce(tensor, op=dist.ReduceOp.SUM)
+    return tensor.cpu().tolist()
+
+
+def _all_reduce_max_metrics(values: Sequence[float], device: int) -> List[float]:
+    tensor = torch.tensor(list(values), dtype=torch.float64, device=device)
+    dist.all_reduce(tensor, op=dist.ReduceOp.MAX)
+    return tensor.cpu().tolist()
+
+
+def _run_profile_contract_check(
+    profile_path: Path,
+    model_args: ModelArguments,
+    data_args: DataArguments,
+    online_args: OnlineRolloutArguments,
