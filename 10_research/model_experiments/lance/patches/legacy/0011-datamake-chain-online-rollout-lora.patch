+def per_target_flow_loss(loss_dict: Mapping[str, Any]) -> torch.Tensor:
+    """Reduce one target's latent-token MSE without token-weighting other targets."""
+
+    mse = loss_dict.get("mse")
+    if mse is None or mse.numel() == 0:
+        raise RuntimeError("turn forward produced no MSE target")
+    if loss_dict.get("ce") is not None:
+        raise RuntimeError("video-only online rollout unexpectedly produced CE tokens")
+    return mse.float().mean(dim=-1).mean()
+
