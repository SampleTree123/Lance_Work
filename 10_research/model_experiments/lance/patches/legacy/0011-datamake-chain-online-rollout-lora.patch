+# coding: utf-8
+
+"""Contracts and deterministic scheduling for chain-level online rollout SFT."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import hashlib
+import json
+from pathlib import Path
+import random
+from typing import Any, Dict, Iterable, List, Mapping, Sequence
+
+import pyarrow.parquet as pq
+import yaml
+
+
+CHAIN_MANIFEST_SCHEMA = "datamake_lance_chain_dataset_manifest_v1"
+ONLINE_CONTRACT_SCHEMA = "datamake_lance_online_rollout_contract_v1"
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def reject_duplicate_cli_options(arguments: Sequence[str]) -> None:
+    """Reject duplicate long options instead of inheriting first/last ambiguity."""
+
+    seen: Dict[str, int] = {}
+    for raw in arguments:
+        if not raw.startswith("--"):
+            continue
+        name = raw.split("=", 1)[0]
+        seen[name] = seen.get(name, 0) + 1
+    duplicates = sorted(name for name, count in seen.items() if count > 1)
+    if duplicates:
+        raise ValueError(f"duplicate CLI options are forbidden: {duplicates}")
+
+
+def stable_turn_seed(
+    global_seed: int, epoch: int, chain_id: str, round_number: int
+) -> int:
+    payload = (
+        f"{int(global_seed)}\0{int(epoch)}\0{chain_id}\0{int(round_number)}"
+    ).encode("utf-8")
+    value = int.from_bytes(hashlib.sha256(payload).digest()[:8], "big")
+    # Keep enough positive headroom for Lance's internal rank offset to be
+    # subtracted before validation_gen_KVcache() adds it back.
+    minimum = 1024
+    return value % (2**31 - 1 - minimum) + minimum
+
+
+def rank_compensated_lance_seed(
+    stable_seed: int, global_rank: int, max_samples: int = 1
+) -> int:
+    """Cancel Lance validation's internal ``rank * max_samples`` seed offset.
+
+    Online training always generates exactly one sample (``i_sample == 0``),
+    so the effective generator seed inside Lance becomes ``stable_seed`` on
+    every rank.  Fail closed if future settings invalidate that contract.
+    """
+
+    if max_samples != 1:
+        raise ValueError("online rollout seed compensation requires max_samples=1")
+    adjusted = int(stable_seed) - int(global_rank) * int(max_samples)
+    if adjusted <= 0:
+        raise ValueError("rank-compensated Lance seed must remain positive")
+    return adjusted
+
+
+@dataclass(frozen=True)
+class OnlineRolloutArguments:
+    datamake_chain_manifest: str = field(
+        metadata={"help": "Manifest for one-row-per-chain training data."}
+    )
+    datamake_profile_path: str = field(
+        metadata={"help": "Frozen executable profile used to launch the run."}
+    )
+    datamake_profile_sha256: str = ""
+    datamake_history_mode: str = "online_rollout_full"
+    datamake_gradient_accumulation_steps: int = 2
+    datamake_num_epochs: int = 4
+    datamake_rollout_diffusion_steps: int = 30
+    datamake_rollout_cfg_text_scale: float = 1.0
+    datamake_rollout_timestep_shift: float = 3.0
+    datamake_rollout_cfg_interval: List[float] = field(
+        default_factory=lambda: [0.4, 1.0]
+    )
+    datamake_rollout_cfg_renorm_min: float = 0.0
+    datamake_rollout_cfg_renorm_type: str = "global"
+    datamake_rollout_use_kv_cache: bool = True
+    datamake_rollout_retry_count: int = 1
+    datamake_lora_rank: int = 64
+    datamake_lora_alpha: float = 64.0
+    datamake_lora_dropout: float = 0.0
+    datamake_lora_target_scope: str = "generation_experts_and_io"
+    datamake_lora_expected_target_modules: int = 256
+    datamake_lora_expected_target_signature_sha256: str = ""
+    datamake_base_model_sha256: str = ""
+    datamake_smoke_mode: bool = False
+
+    def validate(self) -> None:
+        if self.datamake_history_mode != "online_rollout_full":
+            raise ValueError("this entry implements only online_rollout_full")
+        if self.datamake_gradient_accumulation_steps != 2:
+            raise ValueError("the frozen first profile requires accumulation=2")
+        if self.datamake_num_epochs != 4:
+            raise ValueError("the frozen first profile requires four epochs")
+        if self.datamake_rollout_diffusion_steps != 30:
+            raise ValueError("the frozen first profile requires 30 rollout steps")
+        if self.datamake_rollout_cfg_text_scale != 1.0:
+            raise ValueError("the frozen first profile requires rollout text CFG=1")
+        if self.datamake_rollout_retry_count != 1:
+            raise ValueError("rollout failure policy is exactly one deterministic retry")
+        if self.datamake_lora_rank != 64 or self.datamake_lora_alpha != 64.0:
+            raise ValueError("the frozen first profile requires LoRA r64/alpha64")
+        if self.datamake_lora_dropout != 0.0:
+            raise ValueError("the frozen first profile requires LoRA dropout=0")
+        if len(self.datamake_rollout_cfg_interval) != 2:
+            raise ValueError("rollout CFG interval must have two values")
+        if not (
+            0 <= self.datamake_rollout_cfg_interval[0]
+            <= self.datamake_rollout_cfg_interval[1]
+            <= 1
+        ):
+            raise ValueError("invalid rollout CFG interval")
+        for label, value in (
+            ("profile", self.datamake_profile_sha256),
+            ("base model", self.datamake_base_model_sha256),
+            ("LoRA target", self.datamake_lora_expected_target_signature_sha256),
+        ):
+            if len(value) != 64:
+                raise ValueError(f"{label} SHA-256 is required")
+
+
+@dataclass(frozen=True)
+class ChainRecord:
+    chain_id: str
+    prompts: tuple[str, ...]
+    video_paths: tuple[str, ...]
+    turn_ids: tuple[str, ...]
+    edit_axes: tuple[str, ...]
+    source_sample_id: str
+
+    @property
+    def round_count(self) -> int:
+        return len(self.prompts)
+
+
+@dataclass(frozen=True)
+class ScheduledChain:
+    record: ChainRecord
+    contributes_loss: bool = True
+
+
+def _chain_from_row(row: Mapping[str, Any]) -> ChainRecord:
+    if row.get("schema_version") != "datamake_lance_chain_dataset_v1":
+        raise ValueError(f"unsupported chain row schema: {row.get('schema_version')}")
+    prompts = tuple(str(value) for value in row["prompts"])
+    video_paths = tuple(str(value) for value in row["video_paths"])
+    turn_ids = tuple(str(value) for value in row["turn_ids"])
+    edit_axes = tuple(str(value) for value in row["edit_axes"])
+    rounds = int(row["round_count"])
+    if not 1 <= rounds <= 5:
+        raise ValueError(f"chain length must be 1..5, got {rounds}")
+    if not all(value.strip() for value in prompts):
+        raise ValueError("chain prompts must be non-empty")
+    if len(prompts) != rounds or len(video_paths) != rounds + 1:
+        raise ValueError("chain prompt/video counts differ from round_count")
+    if len(turn_ids) != rounds or len(edit_axes) != rounds:
+        raise ValueError("chain turn/edit-axis counts differ from round_count")
+    return ChainRecord(
+        chain_id=str(row["chain_id"]),
+        prompts=prompts,
+        video_paths=video_paths,
+        turn_ids=turn_ids,
+        edit_axes=edit_axes,
+        source_sample_id=str(row["source_longest_prefix_sample_id"]),
+    )
+
+
+def load_chain_records(manifest_path: Path) -> tuple[List[ChainRecord], Dict[str, Any]]:
+    manifest_path = manifest_path.resolve()
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if manifest.get("schema_version") != CHAIN_MANIFEST_SCHEMA:
+        raise ValueError("unsupported chain manifest schema")
+    if manifest.get("split") != "train":
+        raise ValueError("online training requires a train chain manifest")
+    if manifest.get("history_mode") != "online_rollout_full":
+        raise ValueError("chain manifest history mode does not match online trainer")
+    if manifest.get("record_level") != "chain":
+        raise ValueError("online training requires one record per chain")
+    parquet_path = Path(manifest["parquet_file"]).resolve()
+    if not parquet_path.is_file():
+        raise FileNotFoundError(parquet_path)
+    if sha256_file(parquet_path) != manifest["parquet_sha256"]:
+        raise ValueError("chain parquet hash differs from its manifest")
+    rows = pq.read_table(parquet_path).to_pylist()
+    records = [_chain_from_row(row) for row in rows]
+    if len(records) != int(manifest["chain_count"]):
+        raise ValueError("chain row count differs from manifest")
+    if len({record.chain_id for record in records}) != len(records):
+        raise ValueError("chain parquet contains duplicate chain_id values")
+    if sum(record.round_count for record in records) != int(
+        manifest["target_video_count"]
+    ):
+        raise ValueError("target video count differs from manifest")
+    return records, manifest
+
+
+def validate_dataset_binding(
+    dataset_config_path: Path, chain_manifest_path: Path
+) -> None:
+    """Bind CLI history semantics to the actual YAML and parquet artifact."""
+
+    dataset_config_path = dataset_config_path.resolve()
+    chain_manifest_path = chain_manifest_path.resolve()
+    payload = yaml.safe_load(dataset_config_path.read_text(encoding="utf-8"))
+    if not isinstance(payload, dict) or len(payload) != 1:
+        raise ValueError("dataset YAML must have exactly one outer group")
+    group = next(iter(payload.values()))
+    if not isinstance(group, dict) or len(group) != 1:
+        raise ValueError("dataset YAML must have exactly one dataset implementation")
+    dataset = next(iter(group.values()))
+    if dataset.get("datamake_record_level") != "chain":
+        raise ValueError("dataset YAML is not chain-level")
+    if dataset.get("datamake_history_mode") != "online_rollout_full":
+        raise ValueError("dataset YAML history mode differs from trainer")
+    if Path(dataset.get("datamake_chain_manifest", "")).resolve() != chain_manifest_path:
+        raise ValueError("dataset YAML chain manifest differs from CLI")
+    manifest = json.loads(chain_manifest_path.read_text(encoding="utf-8"))
+    expected_parquet = Path(manifest["parquet_file"]).resolve()
+    names = dataset.get("dataset_names", {})
+    data_paths: List[str] = []
+    for record in names.values():
+        value = record.get("data_dir", [])
+        data_paths.extend([value] if isinstance(value, str) else list(value))
+    actual_paths = {Path(value).resolve() for value in data_paths}
+    if actual_paths != {expected_parquet}:
+        raise ValueError(
+            f"dataset YAML parquet binding differs: {actual_paths} != {expected_parquet}"
+        )
+
+
+def build_epoch_groups(
+    records: Sequence[ChainRecord], world_size: int, seed: int, epoch: int
+) -> List[List[ScheduledChain]]:
+    """Make collective-safe groups while using every real chain exactly once."""
+
+    if world_size < 1:
+        raise ValueError("world_size must be positive")
+    rng = random.Random(int(seed) + 1_000_003 * int(epoch))
+    buckets: Dict[int, List[ChainRecord]] = {}
+    for record in records:
+        buckets.setdefault(record.round_count, []).append(record)
+
+    groups: List[List[ScheduledChain]] = []
+    leftovers: List[ChainRecord] = []
+    for length in sorted(buckets):
+        bucket = list(buckets[length])
+        rng.shuffle(bucket)
+        full_count = len(bucket) // world_size * world_size
+        for start in range(0, full_count, world_size):
+            groups.append(
+                [ScheduledChain(record) for record in bucket[start : start + world_size]]
+            )
+        leftovers.extend(bucket[full_count:])
+
+    rng.shuffle(leftovers)
+    for start in range(0, len(leftovers), world_size):
+        group = [ScheduledChain(record) for record in leftovers[start : start + world_size]]
+        if len(group) < world_size:
+            if not records:
+                raise ValueError("cannot pad an empty chain dataset")
+            padding_source = group[-1].record if group else records[0]
+            group.extend(
+                ScheduledChain(padding_source, contributes_loss=False)
+                for _ in range(world_size - len(group))
+            )
+        groups.append(group)
+
+    rng.shuffle(groups)
+    real_ids = [
+        item.record.chain_id
+        for group in groups
+        for item in group
+        if item.contributes_loss
+    ]
+    if len(real_ids) != len(records) or set(real_ids) != {
+        record.chain_id for record in records
+    }:
+        raise RuntimeError("epoch scheduler did not cover every chain exactly once")
+    return groups
+
+
+def optimizer_windows(
+    groups: Sequence[List[ScheduledChain]], accumulation_steps: int
+) -> List[List[List[ScheduledChain]]]:
+    if accumulation_steps < 1:
+        raise ValueError("accumulation_steps must be positive")
+    if len(groups) % accumulation_steps:
+        raise ValueError(
+            f"{len(groups)} collective groups cannot divide accumulation={accumulation_steps}"
+        )
+    return [
+        list(groups[start : start + accumulation_steps])
+        for start in range(0, len(groups), accumulation_steps)
+    ]
+
+
+def window_target_count(window: Sequence[Sequence[ScheduledChain]]) -> int:
+    return sum(
+        item.record.round_count
+        for group in window
+        for item in group
+        if item.contributes_loss
+    )
+
+
+def make_turn_row(
+    record: ChainRecord,
+    round_number: int,
+    generated_history: Sequence[Any],
+) -> Dict[str, Any]:
+    """Create one Lance prefix with audited GT paths and generated inputs.
+
+    ``video_paths`` remains a strings-only provenance view.  The row encoder
+    consumes ``video_inputs`` when present, so detached decoded tensors replace
+    every previous edited video without being serialized through a lossy codec.
+    """
+
+    if not 1 <= round_number <= record.round_count:
+        raise ValueError("round_number is outside the chain")
+    if len(generated_history) != round_number - 1:
+        raise ValueError(
+            f"round {round_number} requires {round_number - 1} generated videos, "
+            f"got {len(generated_history)}"
+        )
+    paths = list(record.video_paths[: round_number + 1])
+    inputs = [
+        record.video_paths[0],
+        *generated_history,
+        record.video_paths[round_number],
+    ]
+    return {
+        "sample_id": f"{record.chain_id}_online_r{round_number:02d}",
+        "chain_id": record.chain_id,
+        "target_round": round_number,
+        "context_length": round_number,
+        "prompts": list(record.prompts[:round_number]),
+        "video_paths": paths,
+        "video_inputs": inputs,
+    }
+
+
+def build_online_contract(
+    arguments: OnlineRolloutArguments,
+    profile_path: Path,
+    chain_manifest_path: Path,
+    dataset_config_path: Path,
+    base_model_path: Path,
+    lora_config: Mapping[str, Any],
+) -> Dict[str, Any]:
+    arguments.validate()
+    paths = {
+        "profile": profile_path.resolve(),
+        "chain_manifest": chain_manifest_path.resolve(),
+        "dataset_config": dataset_config_path.resolve(),
+        "base_model": (base_model_path / "model.safetensors").resolve(),
+    }
+    for path in paths.values():
+        if not path.is_file():
+            raise FileNotFoundError(path)
+    if sha256_file(paths["profile"]) != arguments.datamake_profile_sha256:
+        raise ValueError("executable profile hash differs from CLI lock")
+    if sha256_file(paths["base_model"]) != arguments.datamake_base_model_sha256:
+        raise ValueError("immutable base model hash differs from CLI lock")
+    return {
+        "schema_version": ONLINE_CONTRACT_SCHEMA,
+        "profile": str(paths["profile"]),
+        "profile_sha256": arguments.datamake_profile_sha256,
+        "chain_manifest": str(paths["chain_manifest"]),
+        "chain_manifest_sha256": sha256_file(paths["chain_manifest"]),
+        "dataset_config": str(paths["dataset_config"]),
+        "dataset_config_sha256": sha256_file(paths["dataset_config"]),
+        "base_model": str(base_model_path.resolve()),
+        "base_model_sha256": arguments.datamake_base_model_sha256,
+        "history_mode": arguments.datamake_history_mode,
+        "gradient_accumulation_steps": arguments.datamake_gradient_accumulation_steps,
