+    profile = json.loads(profile_path.read_text(encoding="utf-8"))
+    if profile.get("schema_version") != "datamake_lance_online_rollout_lora_profile_v1":
+        raise ValueError("unsupported executable profile schema")
+    if profile.get("status") not in {
+        "implementation_ready_gpu_smoke_pending",
+        "gpu_smoke_passed",
+        "training_authorized",
