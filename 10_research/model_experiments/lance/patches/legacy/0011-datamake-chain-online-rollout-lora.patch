+        raise ValueError("profile file differs from --datamake_profile_sha256")
+    if not online_args.datamake_smoke_mode:
+        _require(profile.get("status"), "training_authorized", "formal profile status")
+        _require(
+            profile.get("training_authorized"), True, "formal training authorization"
+        )
+
+    workspace_root = profile_path.parents[4]
+
+    def resolve(value: str) -> Path:
+        path = Path(value)
+        return path.resolve() if path.is_absolute() else (workspace_root / path).resolve()
+
+    data_profile = profile["data"]
+    model_profile = profile["model"]
+    run_profile = profile["run"]
+    rollout_profile = profile["rollout"]
+    lora_profile = profile["lora"]
