+def predict_clean_latent_patches(loss_dict: Mapping[str, Any]) -> torch.Tensor:
+    """Recover detached clean-latent patches from Lance flow intermediates."""
+
+    noisy = loss_dict.get("flow_noisy_target")
+    velocity = loss_dict.get("flow_pred_velocity")
+    timesteps = loss_dict.get("flow_timesteps")
+    if not all(isinstance(value, torch.Tensor) for value in (noisy, velocity, timesteps)):
+        raise RuntimeError("one-step history requires flow intermediates")
+    if noisy.shape != velocity.shape or timesteps.shape != noisy.shape[:1]:
+        raise RuntimeError("flow intermediate shapes do not align")
+    return (noisy - timesteps[:, None] * velocity).detach()
+
+
+@torch.no_grad()
+def decode_one_step_x0_history(
+    loss_dict: Mapping[str, Any],
+    target_shape: Sequence[int],
+    vae_model,
+    device: int,
+    telemetry: Dict[str, float],
+) -> torch.Tensor:
+    """Decode one target's predicted x0 for the next turn's ViT/VAE inputs."""
+
+    telemetry.clear()
+    torch.cuda.reset_peak_memory_stats(device)
+    telemetry["allocated_before_mb"] = torch.cuda.memory_allocated(device) / 1024**2
+    telemetry["reserved_before_mb"] = torch.cuda.memory_reserved(device) / 1024**2
+    patches = predict_clean_latent_patches(loss_dict)
+    if len(target_shape) != 3:
+        raise RuntimeError(f"target latent shape must be THW, got {target_shape}")
+    latent_t, latent_h, latent_w = (int(value) for value in target_shape)
+    expected_patches = latent_t * latent_h * latent_w
+    if patches.shape[0] != expected_patches:
+        raise RuntimeError(
+            f"predicted x0 has {patches.shape[0]} patches, expected {expected_patches}"
+        )
+    predicted_x0 = patches.reshape(latent_t, latent_h, latent_w, -1)
+    latent_float = predicted_x0.float()
+    telemetry["latent_sum"] = float(latent_float.sum().item())
+    telemetry["latent_square_sum"] = float(latent_float.square().sum().item())
+    telemetry["latent_numel"] = float(predicted_x0.numel())
+    timesteps = loss_dict["flow_timesteps"]
+    telemetry["timestep_mean"] = float(timesteps.float().mean().item())
+    del latent_float
+    with torch.amp.autocast("cuda", enabled=True, dtype=torch.bfloat16):
+        decoded = vae_model.vae_decode([predicted_x0])[0]
+    if decoded.ndim != 4 or decoded.shape[0] != 3:
+        raise RuntimeError(f"decoded predicted x0 must be CTHW, got {tuple(decoded.shape)}")
+    history = decoded.detach().clamp(-1.0, 1.0).to(
+        device="cpu", dtype=torch.float16
+    ).contiguous()
+    telemetry["peak_allocated_mb"] = torch.cuda.max_memory_allocated(device) / 1024**2
+    telemetry["peak_reserved_mb"] = torch.cuda.max_memory_reserved(device) / 1024**2
+    telemetry["allocated_after_mb"] = torch.cuda.memory_allocated(device) / 1024**2
+    telemetry["reserved_after_mb"] = torch.cuda.memory_reserved(device) / 1024**2
+    del decoded, predicted_x0, patches
+    return history
+
