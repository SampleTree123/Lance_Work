+def trim_attention_padding(data):
+    """Keep only 128-token alignment padding for Lance's native FlexAttention.
+
+    The zero-length trailing pad document must remain: Lance uses it as a
+    sentinel when iterating real samples for multimodal position IDs. Real
+    tensors, sample boundaries, loss indexes and RNG are untouched.
+    """
+    lengths, splits = data['sample_lens'], data['split_lens']
+    real_length = data['sequence_length']
+    if (not lengths or not splits or data['sample_type'][-1] != 'pad'
+            or data['sample_N_target'][-1] != 0 or data['attn_modes'][-1] != 'causal'
+            or lengths[-1] != splits[-1]
+            or sum(lengths[:-1]) != real_length or sum(splits[:-1]) != real_length):
+        raise ValueError("Expected Lance's isolated trailing attention padding document")
+    padding = (-real_length) % 128
+    result = dict(data)
+    result['sample_lens'] = [*lengths[:-1], padding]
+    result['split_lens'] = [*splits[:-1], padding]
+    return result
 
 
