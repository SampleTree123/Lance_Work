+"""Mixed UE prefixes / CoinVE pairs with an explicit shared temporal crop.
+
+Reuses the existing role-aware row processor, Lance frame sampler and spatial
+transforms. Only the CoinVE media loading is different; no video is rewritten.
+"""
+from copy import copy
+from dataclasses import dataclass
+import math
+
+import decord
+import torch
+
+from data.datasets_factory.dataset_datamake_multiturn_v2v_local import (
+    DataMakeMultiTurnV2VLocalIterableDataset,
+)
+from data.video.sampler.frames import MultiClipsFrameSampler
+
+
+DATASET_KEY = "datamake_mixed_v2v_local"
+CROP_POLICY = "paired_absolute_5s_12fps_kn1_fixed_v1"
+
+
+def crop_frame_indices(total_frames, fps, start_seconds, duration_seconds=5.0):
+    """Use native FPS, never stretch the full clip to the requested window."""
+    if not math.isfinite(fps) or fps <= 0:
+        raise ValueError("invalid native FPS")
+    if not math.isfinite(start_seconds) or start_seconds < 0 or duration_seconds != 5.0:
+        raise ValueError("expected a nonnegative start and a five-second window")
+    if start_seconds + duration_seconds > total_frames / fps + 1e-6:
+        raise ValueError("paired crop exceeds available video duration")
+    start = math.floor(start_seconds * fps + 1e-9)
+    end = min(total_frames, start + round(duration_seconds * fps))
+    if end <= start or (end - start) / fps + 0.5 / fps + 1e-6 < duration_seconds:
+        raise ValueError("insufficient frames in paired crop")
+    sampler = MultiClipsFrameSampler(
+        temporal=4, sample_fps=12, max_duration=5,
+        length_type="kn+1", assert_seconds=True, truncate=False,
+    )
+    indices = sampler({"clip_indices": [(start, end)], "fps": fps}).indices
+    if len(indices) != 61:
+        raise ValueError("paired crop must yield 61 VAE frames")
+    return indices
+
+
+@dataclass(frozen=True)
+class CroppedMedia:
+    path: str
+    start_seconds: float
+    duration_seconds: float
+
+
+class DataMakeMixedV2VLocalIterableDataset(DataMakeMultiTurnV2VLocalIterableDataset):
+    def _process_row(self, row, *args, **kwargs):
+        origin = row.get("dataset_origin")
+        if origin == "ue_synthetic":
+            if row.get("crop_policy") is not None:
+                raise ValueError("synthetic prefixes must retain their original sampling")
+            return super()._process_row(row, *args, **kwargs)
+        if origin != "coinve" or row.get("crop_policy") != CROP_POLICY:
+            raise ValueError("unknown mixed-data origin/crop policy")
+        if len(row["prompts"]) != 1 or len(row["video_paths"]) != 2:
+            raise ValueError("CoinVE compound instruction is one supervised turn")
+        # Row-local shallow copy: shared crop state cannot leak into the next
+        # synthetic row, even if decoding raises or workers prefetch ahead.
+        scoped = copy(self)
+        scoped._paired_window = (float(row["crop_start_seconds"]), float(row["crop_duration_seconds"]))
+        scoped._paired_frames = {}
+        result = super(DataMakeMixedV2VLocalIterableDataset, scoped)._process_row(row, *args, **kwargs)
+        if result is None:
+            raise RuntimeError(f"failed paired crop: {row['sample_id']}")
+        result["data_indexes"].update({
+            "dataset_origin": origin, "crop_start_seconds": scoped._paired_window[0],
+            "crop_duration_seconds": scoped._paired_window[1], "crop_policy": CROP_POLICY,
+        })
+        return result
+
+    def _read_media_bytes(self, value, cache):
+        if not hasattr(self, "_paired_window"):
+            return super()._read_media_bytes(value, cache)
+        # The inherited processor treats media as opaque. This handle allows
+        # Decord to seek the original file directly instead of reading all bytes.
+        return CroppedMedia(self._resolve_media_path(value), *self._paired_window)
+
+    def get_video_tensor(self, media_url, vision_stream, worker_id=0, **kwargs):
+        if not isinstance(media_url, CroppedMedia):
+            return super().get_video_tensor(media_url, vision_stream, worker_id, **kwargs)
+        if media_url not in self._paired_frames:
+            reader = decord.VideoReader(media_url.path, ctx=decord.cpu(0), num_threads=1)
+            indices = crop_frame_indices(len(reader), float(reader.get_avg_fps()),
+                                         media_url.start_seconds, media_url.duration_seconds)
+            self._paired_frames[media_url] = self._read_decord(reader, indices)
+        frames = self._paired_frames[media_url]
+        if vision_stream == "vae_video":
+            tensor = self.transform(frames)
+        elif vision_stream == "vit_video":
+            tensor = self.vit_transform(frames)
+            if tensor.shape[1] % 2:
+                tensor = torch.cat([tensor, tensor[:, -1:]], dim=1)
+        else:
+            raise ValueError(f"unsupported vision stream: {vision_stream}")
+        self.vision_stream, self.data_mode = vision_stream, "online"
+        return tensor, self.vision_token_count(tensor), None
+
+
+def register_mixed_dataset():
+    # Opt in from the indexed-prefix entry. Keep the frozen Stage5 registry and
+    # dataset implementation unchanged; legacy entries reject this YAML key.
+    from data.dataset_info import DATASET_REGISTRY
+    DATASET_REGISTRY[DATASET_KEY] = DataMakeMixedV2VLocalIterableDataset
