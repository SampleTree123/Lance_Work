@@ -0,0 +1,39 @@
+"""Reuse checkpoint-v5 unchanged, with a private Stage6 config reader.
+
+The private module instance avoids changing Stage5's global loader. V5 moves
+live nested-FSDP parameter shards through optimizer DCP, not stale model views.
+"""
+import importlib.util
+from pathlib import Path
+
+import torch
+
+from train.datamake_branch_lora import read_branch_config
+
+_spec = importlib.util.spec_from_file_location(
+    "train._stage6_checkpoint_v5", Path(__file__).with_name("datamake_lora_checkpoint.py")
+)
+_core = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_core)
+_core.read_lora_config = read_branch_config
+
+save_lora_checkpoint = _core.save_lora_checkpoint
+load_lora_checkpoint = _core.load_lora_checkpoint
+validate_lora_checkpoint = _core.validate_lora_checkpoint
+
+
+def initialize_adam_state(optimizer):
+    """Allocate Adam's exact step-0 state, including currently unused adapters.
+
+    Final-layer UND outputs may have no loss path with CE disabled. Explicit
+    zero state makes their DCP schema stable; no fictitious optimizer update or
+    gradient is introduced. Empty local FSDP parameter shards need no state.
+    """
+    for group in optimizer.param_groups:
+        for parameter in group["params"]:
+            if parameter.numel() and not optimizer.state[parameter]:
+                optimizer.state[parameter] = {
+                    "step": torch.tensor(0., dtype=torch.float32),
+                    "exp_avg": torch.zeros_like(parameter),
+                    "exp_avg_sq": torch.zeros_like(parameter),
+                }
