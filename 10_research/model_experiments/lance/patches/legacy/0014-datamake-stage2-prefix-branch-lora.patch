+++ b/train/datamake_branch_lora.py
@@ -0,0 +1,106 @@
+"""Stage6 parameter-only branch ablation; Stage5's adapter code stays frozen."""
+from dataclasses import dataclass
+import hashlib
+import json
+from pathlib import Path
+
+import torch
+from torch import nn
+
+from train.datamake_generation_lora import (
+    GenerationLoRAConfig, LoRALinear, GENERATION_EXPERT_SUFFIXES,
+    GENERATION_IO_NAMES, LORA_CONFIG_FILENAME, LORA_ADAPTER_FILENAME,
+    _resolve_parent, load_adapter_state_dict,
+)
+
+SCHEMA = "datamake_lance_branch_lora_v1"
+UND_SUFFIXES = (
+    "self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj",
+    "self_attn.o_proj", "mlp.gate_proj", "mlp.up_proj", "mlp.down_proj",
+)
+
+
+@dataclass(frozen=True)
+class BranchLoRAConfig(GenerationLoRAConfig):
+    schema_version: str = SCHEMA
+
+    def validate(self):
+        if self.schema_version != SCHEMA:
+            raise ValueError("Not a Stage6 branch adapter")
+        if self.target_scope not in {"generation_experts_and_io", "both_branches"}:
+            raise ValueError(f"Unknown branch scope: {self.target_scope}")
+        if self.rank <= 0 or self.alpha <= 0 or not 0 <= self.dropout < 1:
+            raise ValueError("Invalid LoRA rank/alpha/dropout")
+        if self.expected_target_modules <= 0:
+            raise ValueError("LoRA target count must be positive")
+
+
+def config_from_profile(profile):
+    frozen = profile["freeze"]["understanding_adapters"]
+    lora = profile["lora"]
+    return BranchLoRAConfig(
+        rank=lora["rank"], alpha=lora["alpha"], dropout=lora["dropout"],
+        target_scope="generation_experts_and_io" if frozen else "both_branches",
+        expected_target_modules=256 if frozen else 508,
+    )
+
+
+def is_generation_target(name):
+    return name in GENERATION_IO_NAMES or (
+        name.startswith("language_model.model.layers.")
+        and name.endswith(GENERATION_EXPERT_SUFFIXES)
+    )
+
+
+def is_understanding_target(name):
+    return (name.startswith("language_model.model.layers.")
+            and name.endswith(UND_SUFFIXES))
+
+
+def apply_branch_lora(model, config, seed=2026):
+    config.validate()
+    targets = [
+        (name, module) for name, module in model.named_modules()
+        if isinstance(module, nn.Linear) and (
+            is_generation_target(name) or
+            (config.target_scope == "both_branches" and is_understanding_target(name)))
+    ]
+    if len(targets) != config.expected_target_modules:
+        raise ValueError(f"Expected {config.expected_target_modules} LoRA modules, got {len(targets)}")
+    model.requires_grad_(False)
+    for name, module in targets:
+        # Per-name initialization keeps common GEN adapters identical in both
+        # arms without consuming the noise/data RNG differently.
+        devices = [module.weight.device.index] if module.weight.is_cuda else []
+        with torch.random.fork_rng(devices=devices):
+            module_seed = int.from_bytes(hashlib.sha256(f"{seed}:{name}".encode()).digest()[:8], "little")
+            torch.random.default_generator.manual_seed(module_seed)
+            if devices:
+                torch.cuda.manual_seed(module_seed)
+            adapter = LoRALinear(module, config.rank, config.alpha, config.dropout)
+        adapter.lora_A.data = adapter.lora_A.data.float()
+        adapter.lora_B.data = adapter.lora_B.data.float()
+        parent, child = _resolve_parent(model, name)
+        setattr(parent, child, adapter)
+    return [name for name, _ in targets]
+
+
+def read_branch_config(path):
+    return BranchLoRAConfig.from_dict(json.loads(Path(path).read_text()))
+
+
+def install_branch_adapter_inference_loader(checkpoint):
+    """Load explicit base first, then the same wrappers and saved adapters."""
+    import inference_lance
+    from safetensors.torch import load_file
+    checkpoint = Path(checkpoint)
+    config = read_branch_config(checkpoint / LORA_CONFIG_FILENAME)
+    original_loader = inference_lance.init_from_model_path_if_needed
+
+    def load(model, model_args):
+        original_loader(model, model_args)
+        apply_branch_lora(model, config)
+        return load_adapter_state_dict(model, load_file(str(checkpoint / LORA_ADAPTER_FILENAME)))
+
+    inference_lance.init_from_model_path_if_needed = load
+    return original_loader
