+++ b/train/datamake_stage2_lora_train.py
@@ -0,0 +1,261 @@
+"""Stage2 GT-prefix recipe + branch-selective LoRA + optimizer-step accumulation.
+
+Usage is intentionally short: --profile FILE [--resume-from CHECKPOINT].
+The parent launcher supplies a run directory and runs the startup resume gate.
+"""
+import argparse
+from dataclasses import asdict
+import functools
+import json
+from pathlib import Path
+import sys
+from time import perf_counter
+
+import torch
+import torch.distributed as dist
+from torch.utils.data import DataLoader
+from torch.distributed.algorithms._checkpoint.checkpoint_wrapper import (
+    CheckpointImpl, apply_activation_checkpointing, checkpoint_wrapper,
+)
+from transformers import HfArgumentParser, set_seed
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts"))
+from run_datamake_stage2_lora_training import load_profile, make_contract
+from run_datamake_formal_training import build_torchrun_command
+from config.config_factory import ModelArguments, DataArguments, TrainingArguments
+from common.utils.logging import get_logger
+from common.val.utils import make_padded_latent
+from data.dataset_base_train import PackedDataset, simple_custom_collate
+from data.data_utils import add_special_tokens
+from modeling.lance import Lance, LanceConfig
+from modeling.qwen2 import Qwen2Tokenizer
+from train.fsdp_utils import fsdp_wrapper, grad_checkpoint_check_fn
+from train.train_utils import (
+    prepare_model_paths, setup_model_components, prepare_checkpoint_loader,
+    build_fsdp_config, build_lr_scheduler, build_train_dataset_config,
+    get_image_token_id, build_edit_region_mse_weights, compute_training_loss,
+)
+from train.datamake_branch_lora import config_from_profile, apply_branch_lora
+from train.datamake_stage2_lora_checkpoint import (
+    initialize_adam_state, save_lora_checkpoint, load_lora_checkpoint,
+)
+from train.datamake_stage2_lora_data import IndexedPrefixDataset
+
+
+def recipe_arguments(profile):
+    # Reuse Stage2's exact mapping of model/data/optimizer settings, without
+    # running its full-parameter-only launcher or modifying its frozen files.
+    command = build_torchrun_command(profile, None, 29500)
+    argv = command[command.index("train/unified_train.py") + 1:]
+    return HfArgumentParser((ModelArguments, DataArguments, TrainingArguments)).parse_args_into_dataclasses(argv)
+
+
+def microbatch_loss(batch, model, vae, model_args, training_args, device, world):
+    data = batch.cuda(device).to_dict()
+    indexes = data.pop("batch_data_indexes")
+    ce_weights = data.pop("ce_loss_weights", None)
+    roles = data.pop("vae_edit_roles")
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        mode, videos = data.pop("vae_data_mode"), data.pop("padded_videos")
+        with torch.no_grad():
+            data["padded_latent"] = make_padded_latent(videos, mode, vae)
+            weights = build_edit_region_mse_weights(
+                data["padded_latent"], data["patchified_vae_latent_shapes"], roles,
+                model_args.latent_patch_size, training_args.edit_region_weight_boost,
+                training_args.edit_region_low_quantile, training_args.edit_region_high_quantile,
+            ) if training_args.edit_region_weighting else None
+        data.pop("padded_videos_vit", None)
+        losses = model(**data)
+    loss, metrics, _, total_tokens = compute_training_loss(
+        losses, data, ce_weights, training_args, device, world, weights,
+    )
+    return loss, metrics, total_tokens, indexes
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--profile", type=Path, required=True)
+    parser.add_argument("--run-dir", type=Path, required=True)
+    parser.add_argument("--resume-from", type=Path)
+    parser.add_argument("--stop-after", type=int)
+    parser.add_argument("--smoke", action="store_true")
+    args = parser.parse_args()
+    profile = load_profile(args.profile)
+    model_args, data_args, training_args = recipe_arguments(profile)
+    torch.set_num_threads(1)
+    torch.set_num_interop_threads(1)
+    dist.init_process_group("nccl")
+    rank, world = dist.get_rank(), dist.get_world_size()
+    device = int(__import__("os").environ["LOCAL_RANK"])
+    torch.cuda.set_device(device)
+    if world != profile["distributed"]["gpus_per_node"]:
+        raise ValueError("This profile uses four GPUs")
+    logger = get_logger()
+    log = logger.info if rank == 0 else lambda *_: None
+    run_dir = args.run_dir.resolve()
+    if rank == 0:
+        (run_dir / "configs").mkdir(parents=True, exist_ok=True)
+        (run_dir / "configs" / "profile.json").write_text(json.dumps(profile, indent=2) + "\n")
+    dist.barrier()
+    training_args.config_dir = str(run_dir / "configs")
+    training_args.N_key_frame = data_args.N_key_frame
+    training_args.incre_time_pro = data_args.incre_time_pro
+    set_seed(training_args.global_seed * world + rank)
+    prepare_model_paths(model_args, training_args)
+    llm_config, language, vit_config, vit, vae, vae_config = setup_model_components(model_args, training_args, log)
+    config = LanceConfig(
+        visual_gen=True, visual_und=True, llm_config=llm_config,
+        vit_config=vit_config, vae_config=vae_config,
+        latent_patch_size=model_args.latent_patch_size,
+        max_num_frames=model_args.max_num_frames, max_latent_size=model_args.max_latent_size,
+        vit_max_num_patch_per_side=model_args.vit_max_num_patch_per_side,
+        connector_act=model_args.connector_act, interpolate_pos=model_args.interpolate_pos,
+        timestep_shift=training_args.timestep_shift,
+    )
+    model = Lance(language_model=language, vit_model=vit, vit_type=model_args.vit_type,
+                  config=config, training_args=training_args)
+    tokenizer, token_ids, num_new_tokens = add_special_tokens(Qwen2Tokenizer.from_pretrained(model_args.model_path))
+    load_base = prepare_checkpoint_loader(
+        model_args, training_args, llm_config, language, tokenizer,
+        num_new_tokens, log, report_dir=training_args.config_dir,
+    )
+    load_base(model)  # Mandatory ordering: base -> LoRA -> FSDP -> optimizer.
+    lora_config = config_from_profile(profile)
+    targets = apply_branch_lora(model, lora_config, training_args.global_seed)
+    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
+    log(f"Stage6 targets={len(targets)} trainable_parameters={trainable} FP32 master; freeze_und=False")
+    if rank == 0:
+        (run_dir / "configs" / "lora_targets.json").write_text(json.dumps(targets, indent=2) + "\n")
+    image_token_id = get_image_token_id(language)
+    model = fsdp_wrapper(model, build_fsdp_config(training_args))
+    apply_activation_checkpointing(
+        model, checkpoint_wrapper_fn=functools.partial(checkpoint_wrapper, checkpoint_impl=CheckpointImpl.NO_REENTRANT),
+        check_fn=grad_checkpoint_check_fn,
+    )
+    optimizer = torch.optim.AdamW(
+        [p for p in model.parameters() if p.requires_grad], lr=training_args.lr,
+        betas=(training_args.beta1, training_args.beta2), eps=training_args.eps,
+        weight_decay=profile["optimization"]["weight_decay"],
+    )
+    initialize_adam_state(optimizer)
+    scheduler = build_lr_scheduler(optimizer, training_args)
+    accumulation = profile["run"]["gradient_accumulation_steps"]
+    total_steps = profile["run"]["total_steps"]
+    stop = args.stop_after or total_steps
+    if not 0 < stop <= total_steps:
+        raise ValueError("stop-after must not change the profile's scheduler horizon")
+    contract = make_contract(profile, args.profile)
+    # Dataset construction is before RNG restoration. The loader gets its own
+    # generator; prefetch never advances the saved consumed-sample cursor.
+    dataset_config = build_train_dataset_config(data_args, model_args, training_args, vae_config)
+    packer = PackedDataset(
+        dataset_config, tokenizer=tokenizer, special_tokens=token_ids,
+        local_rank=rank, world_size=world, interpolate_pos=model_args.interpolate_pos,
+        use_flex=True, data_status=None, apply_chat_template=False,
+        image_token_id=image_token_id, cfg_type=training_args.cfg_type,
+        cfg_uncond_token_id=training_args.cfg_uncond_token_id, **asdict(data_args),
+    )
+    packer.set_epoch(data_args.data_seed)
+    dataset = IndexedPrefixDataset(packer, total_steps * accumulation, data_args.data_seed)
+    next_step = 0
+    if args.resume_from:
+        state = json.loads((args.resume_from / "trainer_state.json").read_text())
+        next_step = state["next_step"]
+        if state["next_microstep"] != next_step * accumulation:
+            raise ValueError("Checkpoint is not at the expected accumulation boundary")
+    loader = DataLoader(
+        dataset, batch_size=1, sampler=range(next_step * accumulation, stop * accumulation),
+        num_workers=data_args.num_workers, pin_memory=True, collate_fn=simple_custom_collate,
+        prefetch_factor=data_args.prefetch_factor if data_args.num_workers else None,
+        multiprocessing_context="spawn" if data_args.num_workers else None,
+        generator=torch.Generator().manual_seed(data_args.data_seed),
+    )
+    wb = None
+    if rank == 0 and not args.smoke:
+        import wandb
+        cfg = profile["wandb"]
+        wb = wandb.init(project=cfg["project"], entity=cfg["entity"], id=cfg["run_id"],
+                        name=profile["run"]["run_name"], group=cfg["group"], tags=cfg["tags"],
+                        job_type=cfg["job_type"], mode=cfg["mode"], resume="allow",
+                        config=profile, dir=str(run_dir), save_code=False)
+        wb.define_metric("optimizer_step")
+        wb.define_metric("train/*", step_metric="optimizer_step")
+        wb.define_metric("perf/*", step_metric="optimizer_step")
+    model.train()
+    optimizer.zero_grad(set_to_none=True)
+    iterator = iter(loader)
+    # W&B and worker startup must not perturb restored model/noise RNG.
+    set_seed(training_args.global_seed * world + rank)
+    if args.resume_from:
+        load_lora_checkpoint(args.resume_from, model, optimizer, scheduler, lora_config, contract)
+    for step in range(next_step, stop):
+        torch.cuda.synchronize(device)
+        start = perf_counter()
+        torch.cuda.reset_peak_memory_stats(device)
+        totals, sample_ids, tokens = {}, [], 0
+        lr_used = optimizer.param_groups[0]["lr"]
+        for micro in range(accumulation):
+            loss, metrics, count, indexes = microbatch_loss(
+                next(iterator), model, vae, model_args, training_args, device, world)
+            bad = (~torch.isfinite(loss.detach())).int()
+            dist.all_reduce(bad, op=dist.ReduceOp.MAX)
+            if bad.item():
+                raise FloatingPointError(f"Nonfinite loss at optimizer step {step + 1}")
+            # FSDP synchronizes every backward so accumulated grads stay sharded.
+            (loss / accumulation).backward()
+            for key, value in {**metrics, "loss": loss.detach()}.items():
+                totals[key] = totals.get(key, 0) + value.detach().float() / accumulation
+            tokens += int(count)
+            sample_ids.extend(item["sample_id"] for item in indexes)
+            del loss, metrics
+        grad_norm = model.clip_grad_norm_(training_args.max_grad_norm)
+        if not torch.isfinite(grad_norm):
+            raise FloatingPointError("Nonfinite gradient norm")
+        optimizer.step()
+        scheduler.step()
+        optimizer.zero_grad(set_to_none=True)
+        completed = step + 1
+        torch.cuda.synchronize(device)
+        step_time = torch.tensor(perf_counter() - start, device=device)
+        dist.all_reduce(step_time, op=dist.ReduceOp.MAX)
+        for value in totals.values():
+            dist.all_reduce(value)
+            value.div_(world)
+        memory = torch.tensor([torch.cuda.max_memory_allocated(device), torch.cuda.max_memory_reserved(device)], device=device)
+        dist.all_reduce(memory, op=dist.ReduceOp.MAX)
+        report = {
+            "optimizer_step": completed, **{f"train/{k}": v.item() for k, v in totals.items()},
+            "train/grad_norm": float(grad_norm), "train/lr": lr_used,
+            "train/next_lr": optimizer.param_groups[0]["lr"],
+            "train/target_exposures": completed * profile["run"]["global_batch_size"],
+            "perf/step_time": step_time.item(), "perf/target_videos_per_second": 32 / step_time.item(),
+            "perf/mse_tokens": tokens, "perf/peak_allocated_gib": memory[0].item() / 2**30,
+            "perf/peak_reserved_gib": memory[1].item() / 2**30,
+        }
+        if rank == 0:
+            log(json.dumps(report, sort_keys=True))
+            with (run_dir / "metrics.jsonl").open("a") as stream:
+                stream.write(json.dumps(report) + "\n")
+            if wb:
+                wb.log(report)
+        # Only the short smoke writes per-rank sample IDs/loss for comparison.
+        if args.smoke:
+            with (run_dir / f"trace.rank-{rank}.jsonl").open("a") as stream:
+                stream.write(json.dumps({"step": completed, "sample_ids": sample_ids,
+                                         "loss": totals["loss"].item()}) + "\n")
+        save = completed % profile["checkpoint"]["completed_step_interval"] == 0
+        save |= completed == stop and (args.smoke or profile["checkpoint"]["save_final_checkpoint"])
+        if save:
+            saved = save_lora_checkpoint(
+                run_dir / "checkpoints", completed, model, optimizer, scheduler,
+                lora_config, contract, {"next_microstep": completed * accumulation},
+                keep_last=profile["checkpoint"]["keep_last_complete"], logger=logger,
+            )
+            log(f"Complete adapter/Adam/scheduler/RNG/cursor checkpoint: {saved}")
+    if wb:
+        wb.finish()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
