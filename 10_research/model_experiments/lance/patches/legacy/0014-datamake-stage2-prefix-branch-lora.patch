+++ b/train/datamake_stage2_lora_data.py
@@ -0,0 +1,68 @@
+"""One GT dialogue prefix per microbatch with a consumed, resumable cursor."""
+from contextlib import contextmanager
+import hashlib
+import random
+
+import numpy as np
+import pyarrow.parquet as pq
+import torch
+from torch.utils.data import Dataset
+
+SCHEDULE_VERSION = "rank_shards_alternating_workers_indexed_prefix_v1"
+
+
+def locate_prefix(index, shard_lengths):
+    worker = index % len(shard_lengths)
+    ordinal = index // len(shard_lengths)
+    return worker, ordinal % shard_lengths[worker], ordinal // shard_lengths[worker]
+
+
+@contextmanager
+def preprocessing_rng(seed):
+    python_state, numpy_state = random.getstate(), np.random.get_state()
+    try:
+        with torch.random.fork_rng(devices=[]):
+            random.seed(seed)
+            np.random.seed(seed % 2**32)
+            torch.random.default_generator.manual_seed(seed)
+            yield
+    finally:
+        random.setstate(python_state)
+        np.random.set_state(numpy_state)
+
+
+class IndexedPrefixDataset(Dataset):
+    def __init__(self, packer, total_microsteps, seed):
+        self.packer = packer
+        self.source = packer.grouped_datasets[0]
+        if len(packer.grouped_datasets) != 1:
+            raise ValueError("Stage6 expects exactly the DataMake prefix dataset")
+        self.paths = self.source.data_paths_per_rank
+        self.rows = [pq.read_table(path).to_pylist() for path in self.paths]
+        if len(self.rows) != 2 or not all(self.rows):
+            raise ValueError("Stage6 schedule expects two nonempty shards per rank")
+        self.total_microsteps, self.seed = total_microsteps, seed
+
+    def __len__(self):
+        return self.total_microsteps
+
+    def __getitem__(self, index):
+        worker, row_index, cycle = locate_prefix(index, [len(rows) for rows in self.rows])
+        row = self.rows[worker][row_index]
+        seed = int.from_bytes(hashlib.sha256(
+            f"{self.seed}:{self.source.local_rank}:{index}".encode()).digest()[:8], "little")
+        with preprocessing_rng(seed):
+            sample = self.source._process_row(row, 0, 0, row_index, worker, self.paths[worker])
+            if sample is None:
+                raise RuntimeError(f"Failed to decode prefix {row.get('sample_id')} at microstep {index}")
+            estimate = sample["num_tokens"] + 2 * len(sample["sequence_plan"])
+            if estimate > self.packer.max_num_tokens_per_sample:
+                raise ValueError(f"Prefix exceeds token budget: {estimate}")
+            status = self.packer.pack_sequence(sample, self.packer.set_sequence_status())
+            if status["curr"] > self.packer.max_num_tokens:
+                raise ValueError(f"Packed prefix exceeds token budget: {status['curr']}")
+            packed = self.packer.to_tensor(status)
+        packed["batch_data_indexes"] = [{
+            **sample["data_indexes"], "microstep": index, "cycle": cycle,
+        }]
+        return packed
diff --git a/train/datamake_stage2_lora_train.py b/train/datamake_stage2_lora_train.py
