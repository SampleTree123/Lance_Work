+        start.record()
+        vit_events.append([start, None])
+    def vit_post(*_):
+        end = torch.cuda.Event(enable_timing=True)
+        end.record()
+        vit_events[-1][1] = end
+    bare_model.vit_model.register_forward_pre_hook(vit_pre)
+    bare_model.vit_model.register_forward_hook(vit_post)
+    optimizer = torch.optim.AdamW(
+        [p for p in model.parameters() if p.requires_grad], lr=training_args.lr,
+        betas=(training_args.beta1, training_args.beta2), eps=training_args.eps,
+        weight_decay=profile["optimization"]["weight_decay"],
+    )
+    initialize_adam_state(optimizer)
+    scheduler = build_lr_scheduler(optimizer, training_args)
+    accumulation = profile["run"]["gradient_accumulation_steps"]
+    total_steps = profile["run"]["total_steps"]
+    stop = args.stop_after or total_steps
+    if not 0 < stop <= total_steps:
+        raise ValueError("stop-after must not change the profile's scheduler horizon")
+    contract = make_contract(profile)
+    if args.single_gpu_probe:
+        contract = {**contract, "diagnostic_only": True, "actual_world_size": 1}
+    # Dataset construction is before RNG restoration. The loader gets its own
+    # generator; prefetch never advances the saved consumed-sample cursor.
+    dataset_config = build_train_dataset_config(data_args, model_args, training_args, vae_config)
+    packer = PackedDataset(
+        dataset_config, tokenizer=tokenizer, special_tokens=token_ids,
+        local_rank=rank, world_size=profile["distributed"]["gpus_per_node"], interpolate_pos=model_args.interpolate_pos,
+        use_flex=True, data_status=None, apply_chat_template=False,
+        image_token_id=image_token_id, cfg_type=training_args.cfg_type,
+        cfg_uncond_token_id=training_args.cfg_uncond_token_id, **asdict(data_args),
+    )
+    packer.set_epoch(data_args.data_seed)
+    dataset = IndexedPrefixDataset(packer, total_steps * accumulation, data_args.data_seed)
+    next_step = 0
+    if args.resume_from:
+        state = json.loads((args.resume_from / "trainer_state.json").read_text())
+        next_step = state["next_step"]
+        if state["next_microstep"] != next_step * accumulation:
+            raise ValueError("Checkpoint is not at the expected accumulation boundary")
+    loader = DataLoader(
+        dataset, batch_size=1, sampler=range(next_step * accumulation, stop * accumulation),
+        num_workers=data_args.num_workers, pin_memory=True, collate_fn=simple_custom_collate,
+        prefetch_factor=data_args.prefetch_factor if data_args.num_workers else None,
+        multiprocessing_context="spawn" if data_args.num_workers else None,
+        generator=torch.Generator().manual_seed(data_args.data_seed),
+    )
+    wb = None
+    if rank == 0 and not args.smoke:
+        import wandb
+        cfg = profile["wandb"]
+        wb = wandb.init(project=cfg["project"], entity=cfg["entity"], id=cfg["run_id"],
+                        name=profile["run"]["run_name"], group=cfg["group"], tags=cfg["tags"],
+                        job_type=cfg["job_type"], mode=cfg["mode"], resume="allow",
+                        config=profile, dir=str(run_dir), save_code=False)
+        wb.define_metric("optimizer_step")
+        wb.define_metric("train/*", step_metric="optimizer_step")
+        wb.define_metric("perf/*", step_metric="optimizer_step")
+    model.train()
+    optimizer.zero_grad(set_to_none=True)
+    iterator = iter(loader)
+    # W&B and worker startup must not perturb restored model/noise RNG.
+    set_seed(training_args.global_seed * world + rank)
+    if args.resume_from:
+        load_ddp_checkpoint(args.resume_from, bare_model, optimizer, scheduler, contract)
+    if args.trace and not args.smoke:
+        raise ValueError("Profiler capture is restricted to smoke/benchmark runs")
+    profiler = None
+    if args.trace:
+        profiler = torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CPU, torch.profiler.ProfilerActivity.CUDA],
+                                          record_shapes=True)
+        profiler.start()
+    for step in range(next_step, stop):
+        torch.cuda.synchronize(device)
+        start = perf_counter()
+        torch.cuda.reset_peak_memory_stats(device)
+        totals, sample_ids, tokens = {}, [], 0
+        phase_events, backward_events, data_wait = [], [], 0.0
+        vit_events.clear()
+        lr_used = optimizer.param_groups[0]["lr"]
+        for micro in range(accumulation):
