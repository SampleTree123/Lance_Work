+"""Official PEFT adapter injection with DataMake's exact branch contract."""
+from dataclasses import asdict
+import hashlib
+import json
+from pathlib import Path
+
+import torch
+from torch import nn
+
+from train.datamake_branch_lora import (
+    BranchLoRAConfig, is_generation_target, is_understanding_target,
+)
+
+SCHEMA = "datamake_lance_peft_branch_v1"
+PEFT_VERSION = "0.15.2"
+
+
+def require_peft():
+    import peft
+    if peft.__version__ != PEFT_VERSION:
+        raise RuntimeError(f"Expected PEFT {PEFT_VERSION}, found {peft.__version__}")
+    return peft
+
+
+def canonical_name(name):
+    name = name.replace("_checkpoint_wrapped_module.", "")
+    for side in ("A", "B"):
+        name = name.replace(f".lora_{side}.default.weight", f".lora_{side}.weight")
+    return name
+
+
+def legacy_name(name):
+    name = canonical_name(name)
+    for side in ("A", "B"):
+        if name.endswith(f".lora_{side}.weight"):
+            return name[:-7]
+    raise ValueError(f"Not a LoRA parameter: {name}")
+
+
+def inject(model, config: BranchLoRAConfig, seed=2026):
+    """Use PEFT's Linear implementation; only scope and RNG policy are local."""
+    peft = require_peft()
+    config.validate()
+    targets = [name for name, module in model.named_modules()
+               if isinstance(module, nn.Linear) and (is_generation_target(name) or
+                  (config.target_scope == "both_branches" and is_understanding_target(name)))]
+    if len(targets) != config.expected_target_modules:
+        raise ValueError(f"Expected {config.expected_target_modules} targets, found {len(targets)}")
+    model.requires_grad_(False)
+    devices = sorted({p.device.index for p in model.parameters() if p.is_cuda})
+    with torch.random.fork_rng(devices=devices):
+        model = peft.inject_adapter_in_model(peft.LoraConfig(
+            r=config.rank, lora_alpha=config.alpha, lora_dropout=config.dropout,
+            bias="none", target_modules=targets, init_lora_weights=True,
+            use_rslora=False, use_dora=False,
+        ), model)
+        # Explicit per-module initialization aligns both branches with Stage6.
+        for name in targets:
+            module = model.get_submodule(name)
+            module_seed = int.from_bytes(hashlib.sha256(f"{seed}:{name}".encode()).digest()[:8], "little")
+            torch.random.default_generator.manual_seed(module_seed)
+            if devices:
+                torch.cuda.manual_seed_all(module_seed)
+            # Stage6 initialized in the base dtype, then promoted to FP32.
+            base = module.get_base_layer().weight
+            initial = torch.empty(module.lora_A["default"].weight.shape,
+                                  dtype=base.dtype, device=base.device)
+            nn.init.kaiming_uniform_(initial, a=5 ** 0.5)
+            module.lora_A["default"].weight.data = initial.float()
+            module.lora_B["default"].weight.data = torch.zeros_like(module.lora_B["default"].weight, dtype=torch.float32)
+    actual = [name for name, p in model.named_parameters() if p.requires_grad]
+    if len(actual) != 2 * len(targets) or any(".lora_" not in name for name in actual):
+        raise RuntimeError("PEFT trainable scope differs from the branch contract")
+    return targets
+
+
+def adapter_state(model):
+    return {k: v.detach().cpu().contiguous().clone()
+            for k, v in require_peft().get_peft_model_state_dict(model).items()}
+
+
+def load_adapter(model, state):
+    expected = require_peft().get_peft_model_state_dict(model)
+    if set(state) != set(expected):
+        raise ValueError("Adapter keys differ from exact PEFT target topology")
+    for name, value in state.items():
+        if value.shape != expected[name].shape or not torch.isfinite(value).all():
+            raise ValueError(f"Invalid adapter tensor: {name}")
+    result = require_peft().set_peft_model_state_dict(model, state)
+    if result.unexpected_keys or any("lora_" in key for key in result.missing_keys):
+        raise RuntimeError(f"PEFT adapter load failed: {result}")
+
+
+def metadata(config):
+    return {"schema_version": SCHEMA, "peft_version": PEFT_VERSION,
+            "branch_config": asdict(config)}
+
+
+def install_inference_loader(checkpoint):
+    import inference_lance
+    from safetensors.torch import load_file
+    checkpoint = Path(checkpoint)
+    config = BranchLoRAConfig.from_dict(json.loads((checkpoint / "datamake_lora_config.json").read_text())["branch_config"])
+    original = inference_lance.init_from_model_path_if_needed
+
+    def loader(model, model_args):
+        original(model, model_args)
+        inject(model, config)
+        load_adapter(model, load_file(str(checkpoint / "adapter.safetensors")))
+        # Same audit shape as the legacy inference loader.
+        values = adapter_state(model)
+        return {"loaded_adapter_tensors": len(values), "checkpoint": str(checkpoint)}
+
+    inference_lance.init_from_model_path_if_needed = loader
+    return original
