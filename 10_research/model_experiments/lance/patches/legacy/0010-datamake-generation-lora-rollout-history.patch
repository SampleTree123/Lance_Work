@@ -0,0 +1,324 @@
+# coding: utf-8
+
+"""Isolated DataMake entry point for generation-only LoRA training.
+
+The historical ``train/unified_train.py`` remains unchanged. This entry removes
+its own LoRA-only CLI arguments, patches three extension points in memory, and
+then calls the existing optimization loop:
+
+1. load the immutable Lance base checkpoint;
+2. freeze every base parameter and attach generation-only LoRA modules;
+3. preserve adapter topology/config in full-state checkpoints for exact resume.
+
+The history arm is selected by the ordinary ``--dataset_config_file``. Thus the
+teacher-forced and rollout experiments share the identical optimizer/model code.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import shutil
+import sys
+from typing import Dict, List, Tuple
+
+import torch.distributed as dist
+import wandb
+
+from common.utils.basic import get_global_rank
+from train.datamake_generation_lora import (
+    GenerationLoRAConfig,
+    LORA_CONFIG_FILENAME,
+    apply_generation_lora,
+    read_lora_config,
+    write_lora_config,
+)
+from train.fsdp_utils import FSDPCheckpoint
+
+
+REQUIRED_UPSTREAM_ARGUMENTS: Dict[str, str] = {
+    "--freeze_und_params": "True",
+    "--freeze_und": "True",
+    "--freeze_vit": "True",
+    "--freeze_vae": "True",
+    "--freeze_llm": "False",
+    "--use_ema": "False",
+}
+TRAINING_CONTRACT_FILENAME = "datamake_lora_training_contract.json"
+TRAINING_CONTRACT_SCHEMA = "datamake_lance_lora_training_contract_v1"
+
+
+def argument_value(arguments: List[str], name: str) -> str | None:
+    try:
+        index = arguments.index(name)
+    except ValueError:
+        return None
+    if index + 1 >= len(arguments):
+        raise ValueError(f"{name} requires a value")
+    return arguments[index + 1]
+
+
+def validate_upstream_contract(arguments: List[str], history_mode: str) -> None:
+    for name, expected in REQUIRED_UPSTREAM_ARGUMENTS.items():
+        actual = argument_value(arguments, name)
+        if actual is None:
+            raise ValueError(f"DataMake LoRA entry requires {name} {expected}")
+        if actual.lower() != expected.lower():
+            raise ValueError(f"{name} must be {expected}, got {actual}")
+
+    learning_rate = argument_value(arguments, "--lr")
+    if learning_rate is None or not math.isclose(
+        float(learning_rate), 1e-4, rel_tol=0.0, abs_tol=1e-12
+    ):
+        raise ValueError(f"DataMake LoRA entry requires --lr 1e-4, got {learning_rate}")
+
+    region_weighting = argument_value(arguments, "--edit_region_weighting")
+    if region_weighting is None:
+        raise ValueError("--edit_region_weighting must be explicit for every history arm")
+    if history_mode == "rollout_full" and region_weighting.lower() != "false":
+        raise ValueError(
+            "rollout_full requires --edit_region_weighting False because its "
+            "generated direct source is not the rendered target's exact parent"
+        )
+
+
+def parse_lora_arguments(
+    arguments: List[str],
+) -> Tuple[GenerationLoRAConfig, str, List[str]]:
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--datamake_lora_rank", type=int, default=64)
+    parser.add_argument("--datamake_lora_alpha", type=float, default=64.0)
+    parser.add_argument("--datamake_lora_dropout", type=float, default=0.0)
+    parser.add_argument(
+        "--datamake_lora_target_scope",
+        default="generation_experts_and_io",
+        choices=("generation_experts", "generation_experts_and_io"),
+    )
+    parser.add_argument("--datamake_lora_expected_target_modules", type=int, default=256)
+    parser.add_argument(
+        "--datamake_history_mode",
+        required=True,
+        choices=("teacher_forced", "rollout_vit_only", "rollout_full"),
+    )
+    parsed, remaining = parser.parse_known_args(arguments)
+    config = GenerationLoRAConfig(
+        rank=parsed.datamake_lora_rank,
+        alpha=parsed.datamake_lora_alpha,
+        dropout=parsed.datamake_lora_dropout,
+        target_scope=parsed.datamake_lora_target_scope,
+        expected_target_modules=parsed.datamake_lora_expected_target_modules,
+    )
+    config.validate()
+    if config.rank != 64:
+        raise ValueError(f"this review profile fixes LoRA rank to 64, got {config.rank}")
+    return config, parsed.datamake_history_mode, remaining
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def build_training_contract(
+    config: GenerationLoRAConfig,
+    history_mode: str,
+    upstream_arguments: List[str],
+) -> Dict[str, object]:
+    dataset_config = Path(
+        argument_value(upstream_arguments, "--dataset_config_file") or ""
+    ).resolve()
+    if not dataset_config.is_file():
+        raise FileNotFoundError(dataset_config)
+    return {
+        "schema_version": TRAINING_CONTRACT_SCHEMA,
+        "lora": config.to_dict(),
+        "history_mode": history_mode,
+        "dataset_config_file": str(dataset_config),
+        "dataset_config_sha256": sha256_file(dataset_config),
+        "base_model_path": argument_value(upstream_arguments, "--model_path"),
+        "learning_rate": float(argument_value(upstream_arguments, "--lr") or "nan"),
+        "edit_region_weighting": (
+            argument_value(upstream_arguments, "--edit_region_weighting").lower()
+            == "true"
+        ),
+    }
+
+
+def install_training_hooks(
+    config: GenerationLoRAConfig,
+    training_contract: Dict[str, object],
+) -> None:
+    import train.unified_train as unified_train
+
+    original_setup = unified_train.setup_ema_and_load_checkpoint
+    original_save = FSDPCheckpoint.fsdp_save_fsdp_ckpt
+    metadata_path: Path | None = None
+    contract_path: Path | None = None
+
+    def setup_with_generation_lora(
+        model,
+        training_args,
+        fsdp_config,
+        load_ckpt,
+        resume_from=None,
+        resume_model_only=True,
+        logger=None,
+    ):
+        nonlocal metadata_path, contract_path
+        if training_args.use_ema:
+            raise ValueError("DataMake generation LoRA does not support EMA")
+        if resume_from is not None and resume_model_only:
+            raise ValueError("LoRA continuation requires full-state resume")
+
+        # Match upstream setup, but attach adapters after base loading and before
+        # full-state resume loading.
+        load_ckpt(model, ema=False)
+        report = apply_generation_lora(model, config)
+        metadata_path = Path(training_args.config_dir) / LORA_CONFIG_FILENAME
+        contract_path = Path(training_args.config_dir) / TRAINING_CONTRACT_FILENAME
+        if get_global_rank() == 0:
+            write_lora_config(str(metadata_path), config)
+            contract_path.write_text(
+                json.dumps(training_contract, indent=2, sort_keys=True) + "\n",
+                encoding="utf-8",
+            )
+            wandb.config.update(
+                {
+                    "datamake_lora": config.to_dict(),
+                    "datamake_history_mode": training_contract["history_mode"],
+                    "datamake_lora_trainable_parameters": report[
+                        "trainable_parameter_count"
+                    ],
+                    "datamake_lora_target_modules": report["target_module_count"],
+                },
+                allow_val_change=True,
+            )
+        if dist.is_available() and dist.is_initialized():
+            dist.barrier()
+        if logger is not None:
+            logger.info(
+                "DataMake generation-only LoRA enabled: "
+                f"r={config.rank}, alpha={config.alpha}, "
+                f"modules={report['target_module_count']}, "
+                f"trainable={report['trainable_parameter_count']}"
+            )
+
+        if resume_from is not None:
+            checkpoint_config_path = Path(resume_from) / LORA_CONFIG_FILENAME
+            if not checkpoint_config_path.is_file():
+                raise ValueError(
+                    f"LoRA resume checkpoint lacks {LORA_CONFIG_FILENAME}: {resume_from}"
+                )
+            if read_lora_config(str(checkpoint_config_path)) != config:
+                raise ValueError("LoRA resume config differs from the current contract")
+            checkpoint_contract_path = Path(resume_from) / TRAINING_CONTRACT_FILENAME
+            if not checkpoint_contract_path.is_file():
+                raise ValueError(
+                    f"LoRA resume checkpoint lacks {TRAINING_CONTRACT_FILENAME}"
+                )
+            checkpoint_contract = json.loads(
+                checkpoint_contract_path.read_text(encoding="utf-8")
+            )
+            if checkpoint_contract != training_contract:
+                raise ValueError(
+                    "LoRA resume history/data contract differs from the current run"
+                )
+            model, _ = FSDPCheckpoint.try_load_ckpt(
+                resume_from=resume_from,
+                logger=logger,
+                model=model,
+                ema_model=None,
+                resume_from_ema=False,
+                report_dir=training_args.config_dir,
+            )
+        return None
+
+    def save_with_lora_metadata(*args, **kwargs):
+        keep_last_checkpoints = int(kwargs.get("keep_last_checkpoints", 0))
+        upstream_kwargs = dict(kwargs)
+        # Do not let the upstream saver prune the previous recoverable point
+        # before the new checkpoint has its LoRA metadata and final marker.
+        upstream_kwargs["keep_last_checkpoints"] = 0
+        result = original_save(*args, **upstream_kwargs)
+        if metadata_path is None or contract_path is None:
+            raise RuntimeError("LoRA metadata was not initialized before checkpoint save")
+        if dist.is_available() and dist.is_initialized():
+            dist.barrier()
+        if get_global_rank() == 0:
+            checkpoint = Path(kwargs["ckpt_dir"]) / f"{int(kwargs['train_steps']):07d}"
+            incomplete = checkpoint.parent / f".{checkpoint.name}.lora-metadata"
+            if incomplete.exists():
+                raise FileExistsError(incomplete)
+            os.replace(checkpoint, incomplete)
+            destination = incomplete / LORA_CONFIG_FILENAME
+            shutil.copy2(metadata_path, destination)
+            contract_destination = incomplete / TRAINING_CONTRACT_FILENAME
+            shutil.copy2(contract_path, contract_destination)
+            marker_path = incomplete / "checkpoint_complete.json"
+            marker = json.loads(marker_path.read_text(encoding="utf-8"))
+            marker["lora_config"] = LORA_CONFIG_FILENAME
+            marker.setdefault("required_artifact_sizes", {})[
+                LORA_CONFIG_FILENAME
+            ] = destination.stat().st_size
+            marker["datamake_training_contract"] = TRAINING_CONTRACT_FILENAME
+            marker["required_artifact_sizes"][
+                TRAINING_CONTRACT_FILENAME
+            ] = contract_destination.stat().st_size
+            temporary = marker_path.with_suffix(".json.tmp")
+            temporary.write_text(
+                json.dumps(marker, indent=2, sort_keys=True) + "\n",
+                encoding="utf-8",
+            )
+            os.replace(temporary, marker_path)
+            os.replace(incomplete, checkpoint)
+            if keep_last_checkpoints > 0:
+                complete_checkpoints = sorted(
+                    (
+                        item
+                        for item in checkpoint.parent.iterdir()
+                        if item.is_dir()
+                        and item.name.isdigit()
+                        and (item / "checkpoint_complete.json").is_file()
+                    ),
+                    key=lambda item: int(item.name),
+                )
+                for stale in complete_checkpoints[:-keep_last_checkpoints]:
+                    kwargs["logger"].info(
+                        f"Removing LoRA checkpoint outside rolling retention: {stale}"
+                    )
+                    shutil.rmtree(stale)
+        if dist.is_available() and dist.is_initialized():
+            dist.barrier()
+        return result
+
+    # The imported optimization loop resolves these globals at call time.
+    unified_train.setup_ema_and_load_checkpoint = setup_with_generation_lora
+    FSDPCheckpoint.fsdp_save_fsdp_ckpt = staticmethod(save_with_lora_metadata)
+    unified_train._datamake_original_setup = original_setup
+    unified_train._datamake_original_save = original_save
+
+
+def main() -> None:
+    original_arguments = sys.argv[1:]
+    config, history_mode, upstream_arguments = parse_lora_arguments(original_arguments)
+    validate_upstream_contract(upstream_arguments, history_mode)
+    training_contract = build_training_contract(
+        config, history_mode, upstream_arguments
+    )
+    sys.argv = [sys.argv[0], *upstream_arguments]
+    install_training_hooks(config, training_contract)
+
+    from train.unified_train import main as unified_main
+
+    unified_main()
+
+
+if __name__ == "__main__":
+    main()
