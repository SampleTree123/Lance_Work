diff --git a/train/datamake_packed_batch.py b/train/datamake_packed_batch.py
new file mode 100644
--- /dev/null
+++ b/train/datamake_packed_batch.py
@@ -0,0 +1,82 @@
+"""Multiple indexed GT prefixes through Lance's native sequence packer.
+
+Loss slots preserve the batch1/accumulation recipe: slot j is normalized over
+ranks separately, then slots are averaged before gradient accumulation.
+"""
+import hashlib
+
+import torch
+import torch.distributed as dist
+
+from train.datamake_stage2_lora_data import IndexedPrefixDataset, locate_prefix, preprocessing_rng
+
+
+class IndexedPackedPrefixDataset(IndexedPrefixDataset):
+    def __init__(self, packer, total_prefixes, seed, batch_size=2):
+        if batch_size not in (1, 2) or total_prefixes % batch_size:
+            raise ValueError("Packing requires complete batches of one or two prefixes")
+        super().__init__(packer, total_prefixes // batch_size, seed)
+        self.batch_size = batch_size
+        self.single_token_budget = packer.max_num_tokens
+        packer.max_num_tokens = self.single_token_budget * batch_size
+
+    def __getitem__(self, group_index):
+        status = self.packer.set_sequence_status()
+        indexes, counts = [], []
+        for slot in range(self.batch_size):
+            index = group_index * self.batch_size + slot
+            worker, row_index, cycle = locate_prefix(index, [len(rows) for rows in self.rows])
+            row = self.rows[worker][row_index]
+            seed = int.from_bytes(hashlib.sha256(
+                f"{self.seed}:{self.source.local_rank}:{index}".encode()).digest()[:8], "little")
+            with preprocessing_rng(seed):
+                sample = self.source._process_row(row, 0, 0, row_index, worker, self.paths[worker])
+                if sample is None:
+                    raise RuntimeError(f"Failed to decode prefix {row.get('sample_id')} at {index}")
+                estimate = sample['num_tokens'] + 2 * len(sample['sequence_plan'])
+                if estimate > self.packer.max_num_tokens_per_sample:
+                    raise ValueError(f"Prefix exceeds token budget: {estimate}")
+                before, mse_before = status['curr'], len(status['mse_loss_indexes'])
+                status = self.packer.pack_sequence(sample, status)
+                if status['curr'] - before > self.single_token_budget:
+                    raise ValueError("Individual prefix exceeds original token budget")
+                counts.append(len(status['mse_loss_indexes']) - mse_before)
+                indexes.append({**sample['data_indexes'], 'microstep': index, 'cycle': cycle})
+        if any(count <= 0 for count in counts):
+            raise ValueError("Each packed prefix needs its own supervised target")
+        if status['ce_loss_indexes']:
+            raise ValueError("Packed Stage6 recipe supports target MSE supervision only")
+        packed = self.packer.to_tensor(status)
+        packed['batch_data_indexes'] = indexes
+        packed['mse_slot_counts'] = counts
+        return packed
+
+
+def compute_packed_training_loss(loss_dict, counts, training_args, weights=None):
+    if loss_dict['ce'] is not None or loss_dict['frame_mse'] is not None:
+        raise ValueError("Packed Stage6 loss requires MSE-only supervision")
+    mse = loss_dict['mse']
+    if mse is None or any(n <= 0 for n in counts) or sum(counts) != len(mse):
+        raise ValueError("Packed MSE counts do not cover every target token")
+    per_token = mse.mean(dim=-1)
+    if weights is not None and (weights.ndim != 1 or len(weights) != len(mse)):
+        raise ValueError("Packed region weights do not match MSE tokens")
+    weights = torch.ones_like(per_token) if weights is None else weights.to(per_token)
+    nums, denoms, raw_nums = [], [], []
+    for values, slot_weights in zip(per_token.split(counts), weights.split(counts)):
+        nums.append((values * slot_weights).sum())
+        denoms.append(slot_weights.sum())
+        raw_nums.append(values.sum())
+    global_denoms = torch.stack(denoms).detach()
+    token_counts = torch.tensor(counts, device=mse.device, dtype=torch.long)
+    world = dist.get_world_size() if dist.is_initialized() else 1
+    if dist.is_initialized():
+        dist.all_reduce(global_denoms)
+        dist.all_reduce(token_counts)
+    weighted = (torch.stack(nums) * world / global_denoms).mean()
+    raw = (torch.stack(raw_nums) * world / token_counts).mean()
+    zero = torch.zeros((), device=mse.device)
+    metrics = {'ce': zero, 'frame_mse': zero, 'mse': weighted.detach(),
+               'mse_unweighted': raw.detach(), 'edit_region_weight_mean': weights.mean().detach(),
+               'edit_region_weight_max': weights.max().detach()}
+    return weighted * training_args.mse_weight, metrics, zero.long(), token_counts.sum()
