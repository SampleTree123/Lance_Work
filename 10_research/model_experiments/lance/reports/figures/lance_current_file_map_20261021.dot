}
p [label="[MODIFIED] lance/data/\ndataset_base_train.py\nOfficial packer + role metadata",fillcolor="#fff2db",color="#d8aa55"];
m [label="[MODIFIED] lance/modeling/lance/\nlance.py\nShared training forward / generation",fillcolor="#fff2db",color="#d8aa55"];
