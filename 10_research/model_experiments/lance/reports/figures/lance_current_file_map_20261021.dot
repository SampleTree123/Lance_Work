}
subgraph cluster_chat {
label="MULTI-TURN INFERENCE"; color="#b7cde3"; style=rounded;
i0 [label="[NEW] scripts/run_multiturn_chat.sh\n-> lance/multiturn_chat.py",fillcolor="#eaf2ff"];
i1 [label="[NEW] lance/multiturn/\nengine.py",fillcolor="#eaf2ff"];
i2 [label="[NEW] lance/multiturn/\nsequence_builder.py",fillcolor="#eaf2ff"];
