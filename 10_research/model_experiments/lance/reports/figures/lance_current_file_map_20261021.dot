digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad="0.35", nodesep="0.35", ranksep="0.55", fontname="DejaVu Sans", fontsize=20];
node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#94a3b8", fontname="DejaVu Sans", fontsize=13, margin="0.18,0.12"];
edge [color="#52677e", arrowsize=0.75];

subgraph cluster_gt {
label="GT HISTORY TRAINING"; color="#b7cde3"; style=rounded;
g0 [label="[NEW] scripts/\nrun_datamake_ddp_training.py",fillcolor="#eaf2ff"];
g1 [label="[NEW] lance/train/\ndatamake_ddp_train.py",fillcolor="#eaf2ff"];
g2 [label="[NEW] lance/train/\ndatamake_stage2_lora_data.py",fillcolor="#eaf2ff"];
g3 [label="[NEW] lance/data/datasets_factory/\ndataset_datamake_mixed_v2v_local.py\n+ dataset_datamake_multiturn_v2v_local.py",fillcolor="#eaf2ff"];
g0 -> g1 -> g2 -> g3;
}
subgraph cluster_chain {
label="WHOLE-CHAIN PRED_X0 TRAINING"; color="#b7cde3"; style=rounded;
c0 [label="[NEW] scripts/\nrun_datamake_chain_pred_x0_ddp_training.py",fillcolor="#eaf2ff"];
