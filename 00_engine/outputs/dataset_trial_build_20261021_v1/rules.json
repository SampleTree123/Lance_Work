    "document": "CONFIRMED_RULES.md",
    "technical_owner": "technical/dataset/DATASET_DESIGN_EXPLORATION_20261021.md",
    "historical_snapshots_mutated": false
  },
  "budgets": {
    "train": {"main_canonical_nodes": 2500, "structural_sessions": 12000},
    "test": {"main_canonical_nodes": 500, "structural_sessions": 2400},
    "references_count_against_main_budget": false
  },
  "split": {
    "disjoint_key": "complete_canonical_main_video_state",
    "scene_holdout": false,
    "person_holdout": false,
    "other_attribute_holdouts": false,
    "same_split_node_and_edge_reuse": true,
    "same_split_attribute_reuse": true,
    "cross_split_equal_state_with_different_id_allowed": false,
    "claims_unseen_scene_or_person_generalization": false
  },
  "graph": {
    "construction_order": ["choose_legal_edit", "expand_target_from_selected_source", "deduplicate_complete_state"],
    "atomic_semantic_axis_count": 1,
    "inheritance": "full_selected_parent_state_then_apply_edit",
    "merge_abandoned_branch": false,
    "history_parent_is_occurrence_index": true,
    "same_axis_consecutive_edits_allowed": true,
    "return_to_prior_value_allowed": true,
    "revisit_prior_state_allowed": true,
    "minimum_distinct_edit_axes": 1,
    "enforce_acyclic_session": false,
    "text_variants_count_as_new_structure": false,
    "reference_carrier_variants_count_as_new_structure": false,
    "require_wrong_latest_source_observably_different": false,
    "require_all_historical_sources_result_distinct": false,
    "no_op_edits_allowed": false
  },
  "sessions": {
    "length_unit": "edit_count_excluding_initial_video",
    "lengths": [2, 3, 4, 5],
    "type_ratio": {"linear": 2, "fork": 1},
    "length_probabilities": {
      "linear": {"2": 0.25, "3": 0.25, "4": 0.25, "5": 0.25},
      "fork": {"2": 0.10, "3": 0.20, "4": 0.35, "5": 0.35}
    },
    "exact_counts": {
      "train": {"linear": {"2": 2000, "3": 2000, "4": 2000, "5": 2000}, "fork": {"2": 400, "3": 800, "4": 1400, "5": 1400}},
      "test": {"linear": {"2": 400, "3": 400, "4": 400, "5": 400}, "fork": {"2": 80, "3": 160, "4": 280, "5": 280}}
    },
    "linear_parent": "latest_history_occurrence",
    "fork": {
      "exact_nonlatest_parent_rounds": 1,
      "round_t_index_base": 1,
      "history_parent_index_base": 0,
      "round_t_sampling": "uniform_inclusive_2_to_L",
      "parent_sampling_given_t": "uniform_inclusive_0_to_t_minus_2",
      "other_round_parent": "latest_history_occurrence",
      "terminal_fork_allowed": true,
      "require_post_fork_edit": false,
      "fixed_root_vs_intermediate_quota": null
    }
  },
  "initial_sampling": {
    "sex_probabilities": {"male": 0.5, "female": 0.5},
    "identity_given_sex": "uniform_legal",
    "scene": "uniform_legal_saved_point_candidates",
    "action": "uniform_legal",
    "hair": "uniform_legal",
    "color": "uniform_legal",
    "camera_weights": {"front_head": 1.5, "front_upper": 1.5, "dolly_in_front": 1.5, "dolly_out_front": 1.5, "other_legal_camera_each": 1},
    "wardrobe": "hierarchical_uniform_family_then_legal_group_then_core_piece_options_then_legal_shoe",
    "saved_combination_exclusions_preserved": true
  },
  "edit_sampling": {
    "axis_weights": {"identity": 2, "hair": 1, "color": 1, "wardrobe": 1, "action": 1, "camera": 1, "site": 1},
    "axis_eligibility": "has_legal_non_noop_target_for_selected_source",
    "weights_renormalized_over_eligible_axes": true,
    "target_sampling_default": "uniform_legal_alternatives",
    "identity": {"same_sex_only": true, "source_camera_allowlist": ["front_head", "front_upper", "dolly_in_front", "dolly_out_front"], "can_change_full_body_skin_and_shape": true},
    "action": {"forbidden_source_cameras": ["front_head"], "preserve_camera_rule": true, "derived_camera_trajectory_allowed": true},
    "hair": {"all_cameras_allowed": true, "exclude_no_hair_rugged_wardrobe": true},
    "color": {"values": ["original", "black", "gold", "silver_white", "red", "blue", "pink"], "all_distinct_value_transitions_allowed": true, "original_to_gold_allowed": true},
    "camera": {"preserve_other_semantic_axes": true, "legal_combination_required": true, "derived_trajectory_allowed": true},
    "site": {"preserve_other_semantic_axes": true, "saved_point_required": true, "valid_action_camera_required": true, "source_camera_rule_required": true}
  },
  "wardrobe": {
    "family_definition": "source_wardrobe_family",
    "group_definition": "legal_outfit_combination_group_within_family",
    "initial_hierarchy_each_level_uniform": ["family", "legal_group", "core_piece_options", "legal_shoe"],
    "mode_probabilities_when_single_available": {"single_piece": 0.5, "whole_outfit": 0.5},
    "mode_probabilities_when_single_unavailable": {"single_piece": 0, "whole_outfit": 1},
    "illegal_or_no_target_mode_selectable": false,
    "single_piece": {"same_group_only": true, "slot_sampling": "uniform_eligible_core_slot", "value_sampling": "uniform_legal_alternative_value", "preserve_shoe": true},
    "whole_outfit": {"other_family_only": true, "same_family_cross_group_allowed": false, "selection_order": ["other_eligible_family", "legal_group", "legal_core_options", "legal_shoe"], "legal_shoe_random_including_whitelisted_barefoot": true, "update_complete_outfit_state_even_for_upper_camera": true},
    "shoe_independent_edit_allowed": false,
    "shoe_only_change_counts_as_edit": false,
    "barefoot_requires_current_whitelist": true,
    "front_head": {"wardrobe_edit_allowed": false},
    "upper": {"views": ["front", "side", "back", "front_oblique", "back_oblique"], "single_visible_upper_core_only": true, "lower_single_allowed": false, "whole_allowed": true, "whole_requires_actual_upper_change": true},
    "full_dolly_orbit": {"core_single_allowed": true, "whole_allowed": true},
    "saved_scene_combination_exclusions_preserved": true,
    "no_legal_target_means_axis_unavailable": true,
    "exclude_family_ids": ["male.rugged_trendy"]
  },
  "scene_camera": {
    "scene_requires_saved_point": true,
    "valid_action_camera_and_source_camera_rule_required": true,
    "saved_combination_exclusions_preserved": true,
    "camera_contract": "preserve_rule_allow_derived_trajectory",
    "fixed_world_trajectory_required": false,
    "exposure_policy": "inherit_saved_map_exposure",
    "lighting_change_on_scene_edit_allowed": true
  },
  "references": {
    "demand_from_actual_used_graph": true,
    "deduplicate_by_reference_requirement": true,
    "count_against_main_budget": false,
    "media_generated_in_this_trial": false,
    "identity": {"images_per_identity": 1, "view": "front_face", "full_body_skin_and_shape_edit_allowed": true},
    "hair": {"carriers_per_hair": 2, "carrier_source": "random_library_identity", "views_per_carrier": ["front", "back"], "hair_color": "black", "photos_per_hair": 4, "input": "random_one_same_carrier_front_back_pair", "variant_counts_as_new_chain": false},
    "motion": {"key": ["actual_required_action", "camera"], "type": "clip", "match_target": ["camera_rule", "phase", "speed", "duration"], "carrier": null},
    "scene": {"type": "single_empty_background_image", "key": ["required_scene_saved_point", "camera_initial_frame"], "person_present": false, "clip_required": false},
    "wardrobe": {"type": "garments_only", "body_present": false, "preserve_3d_shape": true, "background": "neutral", "views_per_piece": ["front", "back"], "single_input": "target_piece_front_back_pair_only", "whole_input": "all_target_core_pieces_and_target_shoe_front_back_pairs", "barefoot_shoe_image": false, "barefoot_instruction_explicit": true, "upper_whole_input": "same_full_target_core_and_shoe_references", "upper_whole_state_update": "complete_target_outfit"}
  },
